# Dockerfile for pre-built Geode binary (avoids Zig compile in Docker)
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    iproute2 \
    && rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1000 geode && \
    mkdir -p /data /certs /var/log/geode && \
    chown -R geode:geode /data /certs /var/log/geode

COPY zig-out/bin/geode /usr/local/bin/geode

USER geode
WORKDIR /home/geode

ENV LOG_LEVEL=error

EXPOSE 3141/udp 50051/tcp 9091/tcp

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD /usr/local/bin/geode query "RETURN 1 AS health" --server 127.0.0.1:3141 --insecure \
        ${GEODE_USERNAME:+-U "$GEODE_USERNAME"} ${GEODE_PASSWORD:+-P "$GEODE_PASSWORD"}

ENTRYPOINT ["/usr/local/bin/geode", "serve"]
CMD ["--data-dir", "/data"]
