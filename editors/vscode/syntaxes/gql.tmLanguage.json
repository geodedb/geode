{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GQL",
  "scopeName": "source.gql",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#variables" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.gql",
          "match": "--.*$"
        },
        {
          "name": "comment.line.double-slash.gql",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gql",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.gql" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.gql" }
          },
          "patterns": []
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.gql",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.gql" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.gql" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.gql",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.gql",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.gql" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.gql" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.gql",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.gql",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.gql",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gql",
          "match": "\\b(?i:MATCH|CREATE|DELETE|DETACH|MERGE|SET|REMOVE|RETURN|WHERE|ORDER|BY|LIMIT|OFFSET|SKIP|WITH|UNWIND|CALL|YIELD|UNION|ALL|OPTIONAL|FOREACH)\\b"
        },
        {
          "name": "keyword.operator.logical.gql",
          "match": "\\b(?i:AND|OR|NOT|XOR|IN|IS|NULL|TRUE|FALSE)\\b"
        },
        {
          "name": "keyword.control.case.gql",
          "match": "\\b(?i:CASE|WHEN|THEN|ELSE|END)\\b"
        },
        {
          "name": "keyword.other.gql",
          "match": "\\b(?i:AS|DISTINCT|ASC|DESC|GROUP|HAVING|INTERSECT|EXCEPT|INSERT|UPDATE|DROP|USE|GRAPH|CATALOG|SCHEMA|TABLE|VIEW|INDEX|CONSTRAINT|ON|EXISTS|IF|SHOW|DESCRIBE|EXPLAIN)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.aggregate.gql",
          "match": "\\b(?i:count|sum|avg|min|max|collect|size)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.scalar.gql",
          "match": "\\b(?i:length|type|id|labels|properties|keys|nodes|relationships|head|last|tail|reverse|range)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.math.gql",
          "match": "\\b(?i:abs|ceil|floor|round|sqrt|rand|sign|exp|log|log10|sin|cos|tan|asin|acos|atan|atan2|pi|e|degrees|radians)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.string.gql",
          "match": "\\b(?i:toString|toInteger|toFloat|toBoolean|split|substring|replace|toLower|toUpper|trim|lTrim|rTrim|left|right|startsWith|endsWith|contains)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.temporal.gql",
          "match": "\\b(?i:timestamp|date|time|datetime|duration)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.vector.gql",
          "match": "\\b(?i:distance|similarity|cosine|euclidean|manhattan)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.other.gql",
          "match": "\\b(?i:coalesce|nullIf)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.gql",
          "match": "\\b(?i:INTEGER|FLOAT|STRING|BOOLEAN|DATE|TIME|DATETIME|DURATION|POINT|VECTOR|UUID|BYTES|JSON|LIST|MAP|NODE|RELATIONSHIP|PATH|GRAPH|ANY)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.gql",
          "match": "(=|<>|<|>|<=|>=|=~)"
        },
        {
          "name": "keyword.operator.arithmetic.gql",
          "match": "(\\+|-|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.concatenation.gql",
          "match": "\\|\\|"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.parameter.gql",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.tag.label.gql",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
