# Dockerfile.release.fips - FIPS-validated production release image (amd64 only)
# Multi-stage: copies the validated OpenSSL FIPS provider from the ci-catalog
# zig-fips image, which is the same image used to build + test the FIPS binary.
#
# MANUALLY MAINTAINED — this file is registered in release/dockerfile_manifest.json
# with "manual": true and is NOT regenerated by tools/release_dockerfile_manifest.py.
# Update this file directly; the governance check only verifies it exists on disk.
#
# Design constraint: the geode binary links OpenSSL dynamically and calls
# OSSL_PROVIDER_load("fips") at startup. The validated provider (fips.so) must
# live at /usr/local/ssl at runtime — Debian's libssl3 is NOT the validated
# provider. We stage-copy /usr/local/ssl from the zig-fips image, which has the
# FIPS-validated OpenSSL built and installed at that path.
#
# amd64-only: the validated FIPS provider is x86_64 Linux.
# GoReleaser build ID: geode-fips (separate build entry, -Dfips=true).

# Stage 1: source the validated OpenSSL FIPS provider.
# Pinned to the same version used by the zig-fips CI catalog component.
FROM registry.gitlab.com/devnw/ci-catalog/zig-fips:0.16.0 AS fipsprov

# Stage 2: runtime image
FROM debian:bookworm-slim
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install runtime dependencies (ca-certificates + base TLS libs for system calls;
# libssl3 satisfies any dynamic linker probes for the Debian-packaged libssl.
# The validated FIPS provider itself arrives via the COPY below.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10000 geode \
    && mkdir -p /data /certs /var/log/geode \
    && chown -R geode:geode /data /certs /var/log/geode

# Copy the validated OpenSSL FIPS provider tree from the zig-fips build image.
# This includes fips.so, fips.cnf, and the openssl.cnf that activates the
# FIPS provider.  The geode binary resolves OSSL_PROVIDER_load("fips") against
# this tree at startup.
COPY --from=fipsprov /usr/local/ssl /usr/local/ssl

# Point OpenSSL at the FIPS-enabled configuration so that the default provider
# context activates the validated provider on every OSSL_PROVIDER_load call.
ENV OPENSSL_CONF=/usr/local/ssl/ssl/openssl.cnf

# Copy the FIPS-linked geode binary from the GoReleaser build context.
# GoReleaser places the binary at the root of the context (build id: geode-fips).
COPY geode /usr/local/bin/geode

# Copy shared health check script (issue #549: single source of truth)
COPY docker/health-check.sh /usr/local/bin/health-check.sh

# Set execute permissions
RUN chmod +x /usr/local/bin/geode /usr/local/bin/health-check.sh

# Switch to non-root user
USER geode
WORKDIR /home/geode

# Enable the out-of-band liveness endpoint the HEALTHCHECK probes:
# GET http://127.0.0.1:$GEODE_METRICS_PORT/health (bound to loopback unless
# GEODE_METRICS_BIND says otherwise). The server only starts that listener when
# GEODE_METRICS_PORT is set, and docker/health-check.sh needs it so the probe
# stays off the authenticated QUIC query path.
ENV GEODE_METRICS_PORT=9090

# Expose runtime ports (same as Dockerfile.release)
EXPOSE 3141/udp 50051/tcp 9090/tcp

# Health check using shared script (see docker/health-check.sh)
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD /usr/local/bin/health-check.sh

# Default entrypoint
ENTRYPOINT ["/usr/local/bin/geode"]
CMD ["serve", "--data-dir", "/data", "--log-level", "error"]
