# Geode Docker Compose Environment Variables
# Copy this file to .env and update with your values

# Geode Configuration
GEODE_LOG_LEVEL=info
GEODE_DATA_DIR=/data
GEODE_LISTEN_ADDR=0.0.0.0:8443

# Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=geode-dev-token-CHANGE-ME
VAULT_DEV_ROOT_TOKEN_ID=geode-dev-token-CHANGE-ME

# MinIO/S3 Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=geode-minio-admin
S3_SECRET_KEY=CHANGE-ME-minio-secret-key-12345
S3_BUCKET=geode-backups

# Redis Configuration
REDIS_PASSWORD=CHANGE-ME-redis-password-12345

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE-ME-grafana-admin-12345

# TLS/SSL Certificates
CERT_PATH=./certs/server.crt
KEY_PATH=./certs/server.key

# GPU Configuration (for docker-compose.gpu.yml)
CUDA_VERSION=12.3.0
GPU_DEVICE_ID=0

# Network Configuration
GEODE_NETWORK_SUBNET=172.28.0.0/16

# Resource Limits
GEODE_MEMORY_LIMIT=8g
GEODE_CPU_LIMIT=4.0
