[Unit]
Description=Geode Graph Database Server (instance %i)
Documentation=https://github.com/spyderorg/geode
After=network.target

[Service]
Type=simple
User=geode
Group=geode
ExecStart=/usr/bin/geode serve --data-dir /var/lib/geode/%i --log-level info --listen 0.0.0.0:%i
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geode/%i /var/log/geode
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Environment
Environment="GEODE_DATA_DIR=/var/lib/geode/%i"
Environment="GEODE_LOG_DIR=/var/log/geode"
Environment="GEODE_CERT_DIR=/etc/geode/certs"
Environment="GEODE_INSTANCE=%i"

# Working directory
WorkingDirectory=/var/lib/geode/%i

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geode-%i

[Install]
WantedBy=multi-user.target
