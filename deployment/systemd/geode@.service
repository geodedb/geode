[Unit]
Description=Geode Graph Database Server (instance %i)
Documentation=https://gitlab.com/devnw/codepros/geode
After=network.target

[Service]
Type=simple
User=geode
Group=geode
# Production default: error-level logging only
# Override via /etc/geode/geode.conf or systemd override for debug/info
ExecStart=/usr/bin/geode serve --data-dir /var/lib/geode/%i --log-level error --listen 0.0.0.0:%i
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geode/%i /var/log/geode /etc/geode/certs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=65536
# Release builds spawn ~800 threads (cooperative first-stream scheduler default = 512).
# 512 caused EAGAIN → SystemResources; 4096 provides headroom for production.
LimitNPROC=4096
TasksMax=4096

# Environment
Environment="GEODE_DATA_DIR=/var/lib/geode/%i"
Environment="GEODE_LOG_DIR=/var/log/geode"
Environment="GEODE_CERT_DIR=/etc/geode/certs"
Environment="GEODE_INSTANCE=%i"

# Working directory
WorkingDirectory=/var/lib/geode/%i

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geode-%i

[Install]
WantedBy=multi-user.target
