[Unit]
Description=Geode Graph Database Server
Documentation=https://gitlab.com/devnw/codepros/geode
After=network.target

[Service]
Type=simple
User=geode
Group=geode
# Production default: warn-level logging (ensures initial admin password is visible)
# Override via /etc/geode/geode.conf or systemd override for debug/info
ExecStart=/usr/bin/geode serve --data-dir /var/lib/geode --log-level warn
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geode /var/log/geode /etc/geode/certs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource limits
LimitNOFILE=65536
# Release builds spawn ~800 threads (16 poll + 64 stream + 64 acceptor + 64 connection
# + 512 cooperative first-stream + 64 offload workers). 512 caused EAGAIN → SystemResources
# during cooperative first-stream scheduler init. Set to 4096 for production headroom.
LimitNPROC=4096
# cgroup task limit — matches LimitNPROC headroom for safety
TasksMax=4096

# Environment
Environment="GEODE_DATA_DIR=/var/lib/geode"
Environment="GEODE_LOG_DIR=/var/log/geode"
Environment="GEODE_CERT_DIR=/etc/geode/certs"

# Optional OpenTelemetry runtime configuration. The leading `-` makes
# the file optional, so installs without OTel push (the default) are
# unaffected. `make install-otel` populates this file from
# deployment/systemd/otel.env.example.
EnvironmentFile=-/etc/geode/otel.env

# QUIC / UDP tuning is applied at install time via deployment/scripts/tune-system.sh
# and persisted to /etc/sysctl.d/99-geode-quic.conf. See devnw/zig/quic
# docs/SYSTEM_TUNING.md for per-knob rationale and rollback.
#
# The service runs with ProtectKernelTunables=true, so runtime sysctl writes from
# this process are (intentionally) blocked — tuning must be installed out-of-band.

# Working directory
WorkingDirectory=/var/lib/geode

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geode

[Install]
WantedBy=multi-user.target
