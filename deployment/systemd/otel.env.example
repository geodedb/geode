# OpenTelemetry runtime configuration for geode.service
# ------------------------------------------------------
# Copied to /etc/geode/otel.env by `make install-otel`.
# Loaded by /lib/systemd/system/geode.service (EnvironmentFile=).
#
# This file holds OTel exporter wiring. The geode binary reads
# OTEL_* env vars at startup (see src/monitoring/otel_metrics.zig)
# and installs a PeriodicMetricReader + tracer pipeline against
# the configured endpoint when OTEL_TRACES_EXPORTER=otlp or
# OTEL_METRICS_EXPORTER=otlp.
#
# Permissions: 0640, root:geode (the bearer token is sensitive).

# ---- Endpoint ----
# Default: GitLab Observability collector for the geode project.
# Same endpoint used by the upstream otel package's
# `otlp-integration-live` CI job (otel/.gitlab-ci.yml:275).
# Override here for self-hosted collectors.
OTEL_EXPORTER_OTLP_ENDPOINT=https://5333796.otel.gitlab-o11y.com:14318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ---- Authentication ----
# Bearer token issued by GitLab Observability "Settings → Tokens".
# Scope: traces:write, metrics:write (logs:write optional).
# DO NOT commit a real token here — leave the placeholder and let
# `make install-otel` substitute from $GEODE_OTEL_BEARER_TOKEN at
# install time, or edit /etc/geode/otel.env after install.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer __REPLACE_WITH_TOKEN__

# ---- Signal selection ----
# Both traces and metrics push to the same endpoint by default.
# Set either to `none` to disable that signal.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# ---- Sampling ----
# Per the otel integration RECIPE.md, default is 5% parent-based.
# Bump to 1.0 for short-term performance tracing campaigns.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05

# ---- Resource attributes ----
# service.name, service.version, service.instance.id are populated
# by src/monitoring/otel_resource.zig at startup. Use this var for
# additional comma-separated key=value pairs (e.g. environment).
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# ---- Export cadence ----
# Periodic metric reader push interval (ms). 60 s default keeps
# bandwidth and ingest costs reasonable; lower for live debugging.
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=10000

# ---- Per-signal overrides (optional) ----
# Uncomment to send traces and metrics to different endpoints.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://5333796.otel.gitlab-o11y.com:14318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://5333796.otel.gitlab-o11y.com:14318/v1/metrics
