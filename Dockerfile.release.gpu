# Dockerfile.release.gpu - GPU-enabled production release image for GoReleaser
# This Dockerfile is used by GoReleaser to build GPU-enabled release Docker images.
# The binary is copied from the GoReleaser build context.
# Requires NVIDIA Container Toolkit on the host system.
# Generated by tools/release_dockerfile_manifest.py from release/dockerfile_manifest.json
# DO NOT EDIT MANUALLY. Update release/dockerfile_manifest.json and re-sync.

FROM nvidia/cuda:13.4.2-runtime-ubuntu22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libvulkan1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10000 geode \
    && mkdir -p /data /certs /var/log/geode \
    && chown -R geode:geode /data /certs /var/log/geode

# Copy the binary from the GoReleaser build context
# GoReleaser places the binary at the root of the context
COPY geode /usr/local/bin/geode

# Copy shared health check script (issue #549: single source of truth)
COPY docker/health-check.sh /usr/local/bin/health-check.sh

# Set execute permissions
RUN chmod +x /usr/local/bin/geode /usr/local/bin/health-check.sh

# Switch to non-root user (numeric UID so the runtime can resolve it
# without reading /etc/passwd; hadolint DL3066)
USER 10000
WORKDIR /home/geode

# Enable the out-of-band liveness endpoint the HEALTHCHECK probes:
# GET http://127.0.0.1:$GEODE_METRICS_PORT/health (bound to loopback unless
# GEODE_METRICS_BIND says otherwise). The server only starts that listener when
# GEODE_METRICS_PORT is set, and docker/health-check.sh needs it so the probe
# stays off the authenticated QUIC query path.
ENV GEODE_METRICS_PORT=9090

# Expose runtime ports
EXPOSE 3141/udp 9090/tcp

# Health check using shared script (see docker/health-check.sh)
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/health-check.sh"]

# Default entrypoint
ENTRYPOINT ["/usr/local/bin/geode"]
CMD ["serve", "--data-dir", "/data", "--log-level", "error", "--gpu-acceleration"]
