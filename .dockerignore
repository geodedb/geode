# Ignore build cache and artifacts by default.
zig-cache/
.zig-cache/
zig-out/
# Keep only the prebuilt runtime binary when explicitly present.
!zig-out/bin/
zig-out/bin/*
!zig-out/bin/geode

# Ignore local data
data/
*.log

# Ignore version control
.git/
.gitignore

# Ignore documentation
docs/*.pdf
docs/*.tar

# Ignore test artifacts
test_*
*_test

# Ignore secrets and sensitive files
.env
.env.*
*.key
*.pem
.secrets.baseline

# Ignore development files
.envrc
flake.lock
flake.nix

# Ignore Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore Go build cache
clients/go/gql/go.sum
clients/go/gql/vendor/

# Note: certs/ is NOT included by default to avoid leaking private keys.
# If you need to copy certs into a Docker build, use explicit COPY in Dockerfile
# with only the specific .crt files needed (not .key files).
