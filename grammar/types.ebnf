TypeSystem        ::= { TypeDeclaration } ;

TypeDeclaration   ::= 'type' Identifier '=' TypeSpec ';' ;

TypeSpec          ::= PrimitiveType
                    | CompoundType
                    | VariantType ;

PrimitiveType     ::= 'bool' | 'int8' | 'int16' | 'int32' | 'int64'
                    | 'int128' | 'int256' | 'int512'
                    | 'uint8' | 'uint16' | 'uint32' | 'uint64'
                    | 'uint128' | 'uint256' | 'uint512'
                    | 'float32' | 'float64' | 'float128' | 'float256' | 'float512'
                    | 'real' | 'fuzzy_float'
                    | 'timestamp' | 'duration' | 'timezone' | 'calendar'
                    | 'char' | 'str' | 'byte'
                    | 'json' | 'jsonb' | 'jsonl' | 'xml' | 'yaml' | 'delimited'
                    | 'uuid' | 'hash' | 'weight' | 'direction'
                    | 'lat' | 'lon' | 'altitude' | 'pressure'
                    | 'geojson' | 'geometry' | 'geohash' | 's2_cell_id'
                    | 'ip' | 'mac' | 'endian'
                    | 'locale' | 'currency' | 'country'
                    | 'pq_key' | 'pq_signature'
                    | 'encrypted_blob' | 'compressed_block'
                    | 'node_id' | 'edge_id' | 'graph_version' ;

CompoundType      ::= 'map'
                    | 'array'
                    | 'set' ;

VariantType       ::= 'variant' '{' 'type' ':' 'str' ',' 'value' ':' TypeSpec '}' ;

Identifier        ::= Letter { Letter | Digit | '_' } ;

Letter            ::= 'a'..'z' | 'A'..'Z' ;
Digit             ::= '0'..'9' ;
