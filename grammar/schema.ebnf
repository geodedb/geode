Schema            ::= { GraphDecl } ;

GraphDecl         ::= 'graph' Identifier '{'
                      { NodeTypeDecl | EdgeTypeDecl }
                    '}' ;

NodeTypeDecl      ::= 'node' Identifier '{'
                      [ LabelDecl ]
                      [ PropertyDecls ]
                      [ ConstraintDecls ]
                    '}' ;

EdgeTypeDecl      ::= 'edge' Identifier '{'
                      'from' Identifier
                      'to' Identifier
                      [ LabelDecl ]
                      [ PropertyDecls ]
                      [ ConstraintDecls ]
                    '}' ;

LabelDecl         ::= 'labels' ':' '[' LabelList ']' ;

LabelList         ::= Identifier { ',' Identifier } ;

PropertyDecls     ::= 'properties' ':' '{' PropertyList '}' ;

PropertyList      ::= PropertyDecl { ',' PropertyDecl } ;

PropertyDecl      ::= Identifier ':' TypeName [ DefaultClause ] [ NotNullClause ] ;

DefaultClause     ::= 'default' ':' Literal ;

NotNullClause     ::= 'notnull' ;

ConstraintDecls   ::= 'constraints' ':' '[' ConstraintList ']' ;

ConstraintList    ::= Constraint { ',' Constraint } ;

Constraint        ::= 'unique' '(' Identifier ')'
                    | 'exists' '(' Identifier ')' ;

TypeName          ::= PrimitiveType
                    | CompoundType ;

PrimitiveType     ::= 'bool' | 'int8' | 'int16' | 'int32' | 'int64'
                    | 'int128' | 'int256' | 'int512'
                    | 'uint8' | 'uint16' | 'uint32' | 'uint64'
                    | 'uint128' | 'uint256' | 'uint512'
                    | 'float32' | 'float64' | 'float128' | 'float256' | 'float512'
                    | 'real' | 'fuzzy_float'
                    | 'timestamp' | 'duration' | 'timezone' | 'calendar'
                    | 'char' | 'str' | 'byte'
                    | 'json' | 'jsonb' | 'jsonl' | 'xml' | 'yaml' | 'delimited'
                    | 'uuid' | 'hash' | 'weight' | 'direction'
                    | 'lat' | 'lon' | 'altitude' | 'pressure'
                    | 'geojson' | 'geometry' | 'geohash' | 's2_cell_id'
                    | 'ip' | 'mac' | 'endian'
                    | 'locale' | 'currency' | 'country'
                    | 'pq_key' | 'pq_signature'
                    | 'encrypted_blob' | 'compressed_block'
                    | 'node_id' | 'edge_id' | 'graph_version' ;

CompoundType      ::= 'map' | 'array' | 'set' | VariantType ;

VariantType       ::= 'variant' '{' 'type' ':' 'str' ',' 'value' ':' TypeName '}' ;

Literal           ::= Number | String | Boolean ;

Identifier        ::= Letter { Letter | Digit | '_' } ;
Letter            ::= 'a'..'z' | 'A'..'Z' ;
Digit             ::= '0'..'9' ;
Number            ::= Digit { Digit } ;
String            ::= '"' { Character } '"' ;
Boolean           ::= 'true' | 'false' ;
