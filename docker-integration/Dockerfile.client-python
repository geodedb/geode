# Python Client Container for Integration Testing
# Tests async QUIC connections via aioquic

FROM python:3.11-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for client
RUN pip install --no-cache-dir \
    aioquic \
    cryptography \
    pyopenssl \
    service-identity \
    pytest \
    pytest-asyncio \
    aiohttp \
    structlog \
    rich \
    typer \
    pydantic

# Create app directories
RUN mkdir -p /app/scripts /app/clients/python /logs/client-python /results/python && \
    useradd -m -u 1000 tester && \
    chown -R tester:tester /app /logs /results

# Copy Python client
COPY clients/python/ /app/clients/python/

# Copy orchestrator scripts and fix permissions
COPY docker-integration/scripts/ /app/scripts/
RUN chmod +x /app/scripts/*.py /app/scripts/*.sh 2>/dev/null || true && \
    chown -R tester:tester /app/scripts /app/clients

USER tester
WORKDIR /app

# Default environment
ENV GEODE_SERVER=geode-server:3141 \
    TEST_MODE=standard \
    PYTHONPATH=/app/clients/python

CMD ["python3", "/app/scripts/orchestrator.py", "--mode", "standard", "--client", "python"]
