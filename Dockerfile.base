# Dockerfile.base - Shared runtime base for Geode server containers
# Consolidates common runtime setup duplicated across 13+ Dockerfiles (issue #549).
#
# Build:
#   docker build -f Dockerfile.base -t geode-base:latest .
#
# Use in other Dockerfiles:
#   FROM geode-base:latest AS runtime
#
# Or build inline as a stage via docker compose build args.
#
# This image provides:
#   - debian:bookworm-slim runtime
#   - ca-certificates and libssl3 packages
#   - Non-root 'geode' user (UID 1000)
#   - Standard directories: /data, /certs, /var/log/geode
#   - Shared health-check script at /usr/local/bin/health-check.sh
#   - QUIC (3141/udp), gRPC (50051/tcp), metrics (9090/tcp) ports exposed
#   - HEALTHCHECK using the shared script

FROM debian:bookworm-slim
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install common runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 geode \
    && mkdir -p /data /certs /var/log/geode \
    && chown -R geode:geode /data /certs /var/log/geode

# Copy shared health check script
COPY docker/health-check.sh /usr/local/bin/health-check.sh
RUN chmod +x /usr/local/bin/health-check.sh

# Switch to non-root user
USER geode
WORKDIR /home/geode

# Enable the out-of-band liveness endpoint the HEALTHCHECK probes:
# GET http://127.0.0.1:$GEODE_METRICS_PORT/health (bound to loopback unless
# GEODE_METRICS_BIND says otherwise). The server only starts that listener when
# GEODE_METRICS_PORT is set, and docker/health-check.sh needs it so the probe
# stays off the authenticated QUIC query path.
ENV GEODE_METRICS_PORT=9090

# Expose standard Geode ports (QUIC + gRPC + metrics)
EXPOSE 3141/udp 50051/tcp 9090/tcp

# Health check using shared script
# SEC-22: --insecure is acceptable (localhost only, see docker/health-check.sh)
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD /usr/local/bin/health-check.sh
