# GPU-enabled multi-stage build for Geode with CUDA support
# Uses vendored ztls and zig-quic (no external OpenSSL/MsQUIC dependencies)
#
# Stage 1: Build Geode with GPU support
# Stage 2: Minimal runtime with GPU support

# ==============================================================================
# Stage 1: Geode Builder with GPU support
# ==============================================================================
FROM nvidia/cuda:13.3.0-devel-ubuntu22.04 AS builder

ARG TARGETARCH
ARG ZIG_VERSION=0.15.1

# Install build dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    xz-utils \
    ca-certificates \
    git \
    build-essential \
    file \
    libvulkan-dev \
    glslang-tools \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-downloaded Zig archive (avoids entropy issues in Docker build)
# Note: Zig 0.15.1+ uses pattern zig-ARCH-OS-VERSION (changed from zig-OS-ARCH-VERSION)
COPY docker/zig/zig-x86_64-linux-0.15.1.tar.xz /tmp/zig.tar.xz
RUN if [ "$(uname -m)" = "aarch64" ]; then \
        ZIG_ARCH="aarch64"; \
    else \
        ZIG_ARCH="x86_64"; \
    fi && \
    ZIG_VER="0.15.1" && \
    echo "Installing Zig ${ZIG_VER} for ${ZIG_ARCH}-linux..." && \
    tar -xf /tmp/zig.tar.xz -C /opt && \
    ln -s /opt/zig-${ZIG_ARCH}-linux-${ZIG_VER}/zig /usr/local/bin/zig && \
    rm /tmp/zig.tar.xz && \
    echo "Zig installed successfully: $(zig version)"

# Set working directory
WORKDIR /build

# Copy source code
COPY . .

# Build geode with GPU support
RUN echo "Building Geode with GPU support..." && \
    zig build -Doptimize=ReleaseFast && \
    zig build bench-gpu -Doptimize=ReleaseFast && \
    echo "Build complete!"

# ==============================================================================
# Stage 2: Minimal runtime with GPU support
# ==============================================================================
FROM nvidia/cuda:13.3.0-devel-ubuntu22.04 AS runtime

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1000 geode && \
    mkdir -p /data /certs /var/log/geode /benchmarks && \
    chown -R geode:geode /data /certs /var/log/geode /benchmarks

# Copy all built binaries from builder
COPY --from=builder /build/zig-out/bin/ /usr/local/bin/
COPY --from=builder /build/run_gpu_benchmarks.sh /benchmarks/

# Make benchmark script executable
RUN chmod +x /benchmarks/run_gpu_benchmarks.sh 2>/dev/null || true

# Switch to non-root user
USER geode
WORKDIR /benchmarks

# Expose ports (QUIC + metrics)
EXPOSE 3141/udp 9091/tcp

# Default command runs GPU benchmarks
CMD ["sh", "-c", "echo '=== GPU Acceleration Benchmarks ===' && \
     echo 'Date:' $(date) && \
     echo '' && \
     echo '--- Phase 1: BFS Traversal ---' && \
     /usr/local/bin/bench_gpu_bfs && \
     echo '' && \
     echo '--- Phase 2: PageRank ---' && \
     /usr/local/bin/bench_gpu_pagerank && \
     echo '' && \
     echo '--- Phase 3: Set Operations ---' && \
     /usr/local/bin/bench_gpu_setops && \
     echo '' && \
     echo '--- Phase 4: Shortest Path ---' && \
     /usr/local/bin/bench_gpu_shortest_path && \
     echo '' && \
     echo '=== Benchmarks Complete ==='"]
