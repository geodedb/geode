# GPU-enabled multi-stage build for Geode with CUDA, OpenSSL FIPS, and MsQUIC support
#
# Stage 1: Build OpenSSL 3.3.2 with FIPS module
# Stage 2: Build MsQUIC v2.5.5
# Stage 3: Build Geode with GPU support
# Stage 4: Minimal runtime with GPU support

# ==============================================================================
# Stage 1: Build OpenSSL 3.3.2 with FIPS 140-2/140-3 module
# ==============================================================================
FROM ubuntu:22.04 AS openssl-builder

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    ca-certificates \
    perl \
    && rm -rf /var/lib/apt/lists/*

# Download and build OpenSSL with FIPS module
RUN curl -L https://www.openssl.org/source/openssl-3.3.2.tar.gz -o openssl-3.3.2.tar.gz && \
    tar xzf openssl-3.3.2.tar.gz && \
    cd openssl-3.3.2 && \
    ./Configure enable-fips \
        --prefix=/opt/openssl-fips \
        --openssldir=/opt/openssl-fips/ssl \
        && \
    make -j$(nproc) && \
    make install && \
    # Generate FIPS module configuration
    export LD_LIBRARY_PATH=/opt/openssl-fips/lib64:$LD_LIBRARY_PATH && \
    /opt/openssl-fips/bin/openssl fipsinstall \
        -out /opt/openssl-fips/ssl/fipsmodule.cnf \
        -module /opt/openssl-fips/lib64/ossl-modules/fips.so && \
    # Update openssl.cnf to include FIPS module
    cat >> /opt/openssl-fips/ssl/openssl.cnf <<'EOF'

[openssl_init]
providers = provider_sect

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1

[fips_sect]
activate = 1
EOF

# ==============================================================================
# Stage 2: Build MsQUIC v2.5.5
# ==============================================================================
FROM ubuntu:22.04 AS msquic-builder

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone and build MsQUIC
RUN git clone --depth 1 --branch v2.5.5 https://github.com/microsoft/msquic.git && \
    cd msquic && \
    git submodule update --init --recursive && \
    mkdir build && cd build && \
    cmake -G 'Unix Makefiles' \
        -DCMAKE_BUILD_TYPE=Release \
        -DQUIC_BUILD_SHARED=ON \
        .. && \
    cmake --build . --config Release -j$(nproc) && \
    cmake --install . --prefix /opt/msquic

# ==============================================================================
# Stage 3: Geode Builder with GPU support
# ==============================================================================
FROM nvidia/cuda:12.3.2-devel-ubuntu22.04 AS builder

ARG TARGETARCH
ARG ZIG_VERSION=0.15.1

# Copy OpenSSL FIPS and MsQUIC from previous stages
COPY --from=openssl-builder /opt/openssl-fips /opt/openssl-fips
COPY --from=msquic-builder /opt/msquic /opt/msquic

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    xz-utils \
    ca-certificates \
    git \
    build-essential \
    file \
    libvulkan-dev \
    glslang-tools \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for OpenSSL and MsQUIC
ENV OPENSSL_ROOT_DIR=/opt/openssl-fips \
    OPENSSL_CONF=/opt/openssl-fips/ssl/openssl.cnf \
    LD_LIBRARY_PATH=/opt/openssl-fips/lib64:/opt/msquic/lib:$LD_LIBRARY_PATH \
    PKG_CONFIG_PATH=/opt/openssl-fips/lib64/pkgconfig:/opt/msquic/lib/pkgconfig:$PKG_CONFIG_PATH

# Install Zig
COPY scripts/docker/install-zig.sh /tmp/install-zig.sh
RUN chmod +x /tmp/install-zig.sh && \
    if [ "$(uname -m)" = "aarch64" ]; then \
        ARCH="aarch64"; \
    else \
        ARCH="x86_64"; \
    fi && \
    /tmp/install-zig.sh ${ZIG_VERSION} $ARCH linux /opt && \
    rm /tmp/install-zig.sh

# Set working directory
WORKDIR /build

# Copy source code
COPY . .

# Build geode with GPU support
RUN echo "Building Geode with GPU support..." && \
    zig build -Doptimize=ReleaseFast && \
    zig build bench-gpu -Doptimize=ReleaseFast && \
    echo "Build complete!"

# ==============================================================================
# Stage 4: Minimal runtime with GPU support
# ==============================================================================
FROM nvidia/cuda:12.3.2-devel-ubuntu22.04 AS runtime

# Copy OpenSSL FIPS and MsQUIC libraries from builder stages
COPY --from=openssl-builder /opt/openssl-fips /opt/openssl-fips
COPY --from=msquic-builder /opt/msquic /opt/msquic

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1000 geode && \
    mkdir -p /data /certs /var/log/geode /benchmarks && \
    chown -R geode:geode /data /certs /var/log/geode /benchmarks

# Set environment variables for runtime
ENV OPENSSL_ROOT_DIR=/opt/openssl-fips \
    OPENSSL_CONF=/opt/openssl-fips/ssl/openssl.cnf \
    LD_LIBRARY_PATH=/opt/openssl-fips/lib64:/opt/msquic/lib:$LD_LIBRARY_PATH \
    FIPS_MODE=enabled

# Copy all built binaries from builder
COPY --from=builder /build/zig-out/bin/ /usr/local/bin/
COPY --from=builder /build/run_gpu_benchmarks.sh /benchmarks/

# Make benchmark script executable
RUN chmod +x /benchmarks/run_gpu_benchmarks.sh 2>/dev/null || true

# Switch to non-root user
USER geode
WORKDIR /benchmarks

# Expose ports (QUIC + metrics)
EXPOSE 8443/udp 9091/tcp

# Default command runs GPU benchmarks
CMD ["sh", "-c", "echo '=== GPU Acceleration Benchmarks ===' && \
     echo 'Date:' $(date) && \
     echo '' && \
     echo '--- Phase 1: BFS Traversal ---' && \
     /usr/local/bin/bench_gpu_bfs && \
     echo '' && \
     echo '--- Phase 2: PageRank ---' && \
     /usr/local/bin/bench_gpu_pagerank && \
     echo '' && \
     echo '--- Phase 3: Set Operations ---' && \
     /usr/local/bin/bench_gpu_setops && \
     echo '' && \
     echo '--- Phase 4: Shortest Path ---' && \
     /usr/local/bin/bench_gpu_shortest_path && \
     echo '' && \
     echo '=== Benchmarks Complete ==='"]
