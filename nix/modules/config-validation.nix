# Geode configuration validation and management utilities
{ lib, pkgs, ... }:

with lib;

let
  # Validation functions for Geode configuration
  validators = {
    # Validate memory size format (e.g., "2GB", "512MB")
    memorySize = value:
      let
        pattern = "^[0-9]+[KMGT]?B?$";
      in
      if builtins.match pattern value != null
      then true
      else throw "Invalid memory size format: ${value}. Use format like '2GB', '512MB', etc.";

    # Validate duration format (e.g., "5m", "1h", "30s")
    duration = value:
      let
        pattern = "^[0-9]+[smhd]$";
      in
      if builtins.match pattern value != null
      then true
      else throw "Invalid duration format: ${value}. Use format like '5m', '1h', '30s', etc.";

    # Validate cron schedule format
    cronSchedule = value:
      let
        parts = splitString " " value;
      in
      if length parts == 5
      then true
      else throw "Invalid cron schedule: ${value}. Must have 5 parts (minute hour day month weekday).";

    # Validate network address format
    networkAddress = value:
      let
        ipv4Pattern = "^([0-9]{1,3}\\.){3}[0-9]{1,3}$";
        hostnamePattern = "^[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?$";
      in
      if value == "0.0.0.0" || value == "127.0.0.1" || value == "localhost"
      then true
      else if builtins.match ipv4Pattern value != null
      then true
      else if builtins.match hostnamePattern value != null
      then true
      else throw "Invalid network address: ${value}";

    # Validate port number
    port = value:
      if value >= 1 && value <= 65535
      then true
      else throw "Invalid port number: ${toString value}. Must be between 1 and 65535.";

    # Validate log level
    logLevel = value:
      if elem value [ "debug" "info" "warn" "error" ]
      then true
      else throw "Invalid log level: ${value}. Must be one of: debug, info, warn, error.";

    # Validate federation role
    federationRole = value:
      if elem value [ "coordinator" "shard" ]
      then true
      else throw "Invalid federation role: ${value}. Must be 'coordinator' or 'shard'.";

    # Validate file path exists and is readable
    filePath = value:
      if pathExists value
      then true
      else throw "File not found: ${value}";

    # Validate directory path
    directoryPath = value:
      if hasPrefix "/" value
      then true
      else throw "Directory path must be absolute: ${value}";

    # Validate S3 bucket name
    s3Bucket = value:
      let
        pattern = "^[a-z0-9.-]{3,63}$";
      in
      if builtins.match pattern value != null
      then true
      else throw "Invalid S3 bucket name: ${value}. Must be 3-63 characters, lowercase letters, numbers, dots, and hyphens only.";

    # Validate URL format
    url = value:
      let
        pattern = "^https?://[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?\\.[a-zA-Z]{2,}";
      in
      if builtins.match pattern value != null
      then true
      else throw "Invalid URL format: ${value}";
  };

  # Configuration generator functions
  generators = {
    # Generate complete Geode configuration file
    geodeConfig = cfg: ''
      # Geode Configuration File
      # Generated by NixOS module
      
      [server]
      data_dir = "${cfg.dataDir}"
      log_dir = "${cfg.logDir}"
      listen_quic = "${cfg.network.listenAddress}:${toString cfg.network.quicPort}"
      
      [security]
      tls_cert = "${cfg.tls.certFile}"
      tls_key = "${cfg.tls.keyFile}"
      
      [performance]
      max_connections = ${toString cfg.performance.maxConnections}
      worker_threads = ${toString cfg.performance.workerThreads}
      memory_limit = "${cfg.performance.memoryLimit}"
      
      [logging]
      level = "${cfg.logging.level}"
      json = ${if cfg.logging.json then "true" else "false"}
      
      [storage]
      wal_segment_size = "${cfg.storage.walSegmentSize}"
      checkpoint_interval = "${cfg.storage.checkpointInterval}"
      page_size = ${toString cfg.storage.pageSize}
      
      ${optionalString cfg.federation.enable ''
      [federation]
      enable = true
      role = "${cfg.federation.role}"
      peers = [${concatStringsSep ", " (map (peer: ''"${peer}"'') cfg.federation.peers)}]
      ''}
      
      ${optionalString cfg.backup.enable ''
      [backup]
      enable = true
      s3_bucket = "${cfg.backup.s3Bucket}"
      s3_region = "${cfg.backup.s3Region}"
      schedule = "${cfg.backup.schedule}"
      ''}
      
      ${optionalString cfg.cdc.enable ''
      [cdc]
      enable = true
      webhook_url = "${cfg.cdc.webhookUrl}"
      retention = "${cfg.cdc.retention}"
      ''}
      
      ${optionalString cfg.monitoring.enable ''
      [monitoring]
      enable = true
      metrics_port = ${toString cfg.monitoring.metricsPort}
      ''}
      
      ${cfg.extraConfig}
    '';

    # Generate systemd environment file
    systemdEnvironment = cfg: ''
      GEODE_CONFIG=${generators.geodeConfig cfg}
      GEODE_DATA_DIR=${cfg.dataDir}
      GEODE_LOG_DIR=${cfg.logDir}
      ${concatStringsSep "\n" (mapAttrsToList (name: value: "${name}=${value}") cfg.environment)}
    '';

    # Generate Docker Compose configuration
    dockerCompose = cfg: ''
      version: '3.8'
      
      services:
        geode:
          image: geode:latest
          container_name: geode-server
          restart: unless-stopped
          ports:
            - "${toString cfg.network.quicPort}:8443"
            ${optionalString cfg.monitoring.enable "- \"${toString cfg.monitoring.metricsPort}:9090\""}
          volumes:
            - geode-data:/var/lib/geode
            - geode-logs:/var/log/geode
            - ./geode.conf:/etc/geode/geode.conf:ro
          environment:
            - GEODE_LOG_LEVEL=${cfg.logging.level}
            - GEODE_JSON_LOGS=${if cfg.logging.json then "true" else "false"}
          healthcheck:
            test: ["CMD", "geode", "health-check"]
            interval: 30s
            timeout: 10s
            retries: 3
            start_period: 60s
          
        ${optionalString cfg.monitoring.enable ''
        prometheus:
          image: prom/prometheus:latest
          container_name: geode-prometheus
          restart: unless-stopped
          ports:
            - "9091:9090"
          volumes:
            - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
            - prometheus-data:/prometheus
          command:
            - '--config.file=/etc/prometheus/prometheus.yml'
            - '--storage.tsdb.path=/prometheus'
            - '--web.console.libraries=/etc/prometheus/console_libraries'
            - '--web.console.templates=/etc/prometheus/consoles'
            - '--storage.tsdb.retention.time=200h'
            - '--web.enable-lifecycle'
        
        grafana:
          image: grafana/grafana:latest
          container_name: geode-grafana
          restart: unless-stopped
          ports:
            - "3000:3000"
          volumes:
            - grafana-data:/var/lib/grafana
          environment:
            - GF_SECURITY_ADMIN_PASSWORD=admin
            - GF_USERS_ALLOW_SIGN_UP=false
        ''}
      
      volumes:
        geode-data:
        geode-logs:
        ${optionalString cfg.monitoring.enable ''
        prometheus-data:
        grafana-data:
        ''}
    '';

    # Generate Kubernetes deployment
    kubernetesDeployment = cfg: ''
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: geode
        labels:
          app: geode
      spec:
        replicas: 1
        selector:
          matchLabels:
            app: geode
        template:
          metadata:
            labels:
              app: geode
          spec:
            containers:
            - name: geode
              image: geode:latest
              ports:
              - containerPort: 8443
                name: quic
                protocol: UDP
              ${optionalString cfg.monitoring.enable ''
              - containerPort: 9090
                name: metrics
                protocol: TCP
              ''}
              env:
              - name: GEODE_LOG_LEVEL
                value: "${cfg.logging.level}"
              - name: GEODE_JSON_LOGS
                value: "${if cfg.logging.json then "true" else "false"}"
              volumeMounts:
              - name: geode-data
                mountPath: /var/lib/geode
              - name: geode-config
                mountPath: /etc/geode
                readOnly: true
              livenessProbe:
                exec:
                  command:
                  - geode
                  - health-check
                initialDelaySeconds: 60
                periodSeconds: 30
                timeoutSeconds: 10
              readinessProbe:
                exec:
                  command:
                  - geode
                  - health-check
                initialDelaySeconds: 30
                periodSeconds: 10
                timeoutSeconds: 5
              resources:
                requests:
                  memory: "1Gi"
                  cpu: "500m"
                limits:
                  memory: "${cfg.performance.memoryLimit}"
                  cpu: "2000m"
            volumes:
            - name: geode-data
              persistentVolumeClaim:
                claimName: geode-data-pvc
            - name: geode-config
              configMap:
                name: geode-config
      ---
      apiVersion: v1
      kind: Service
      metadata:
        name: geode-service
      spec:
        selector:
          app: geode
        ports:
        - name: quic
          port: 8443
          targetPort: 8443
          protocol: UDP
        ${optionalString cfg.monitoring.enable ''
        - name: metrics
          port: 9090
          targetPort: 9090
          protocol: TCP
        ''}
        type: LoadBalancer
    '';
  };

  # Validation wrapper that applies all relevant validators
  validateConfig = cfg: let
    validations = [
      (validators.memorySize cfg.performance.memoryLimit)
      (validators.duration cfg.storage.walSegmentSize)
      (validators.duration cfg.storage.checkpointInterval)
      (validators.networkAddress cfg.network.listenAddress)
      (validators.port cfg.network.quicPort)
      (validators.logLevel cfg.logging.level)
      (validators.directoryPath cfg.dataDir)
      (validators.directoryPath cfg.logDir)
    ] ++ optionals cfg.federation.enable [
      (validators.federationRole cfg.federation.role)
    ] ++ optionals cfg.backup.enable [
      (validators.s3Bucket cfg.backup.s3Bucket)
      (validators.cronSchedule cfg.backup.schedule)
    ] ++ optionals cfg.cdc.enable [
      (validators.url cfg.cdc.webhookUrl)
      (validators.duration cfg.cdc.retention)
    ] ++ optionals cfg.monitoring.enable [
      (validators.port cfg.monitoring.metricsPort)
    ];
  in
  all (x: x) validations;

in
{
  inherit validators generators validateConfig;
}