# Geode Graph Database SystemD Service
[Unit]
Description=Geode Graph Database Daemon
Documentation=https://gitlab.com/devnw/codepros/geode
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=geode
Group=geode

# Main process
ExecStart=/usr/local/bin/geode serve --config=/etc/geode/geode.conf --data-dir=/var/lib/geode
ExecReload=/bin/kill -HUP $MAINPID

# Working directory
WorkingDirectory=/var/lib/geode

# Environment
Environment=GEODE_CONFIG=/etc/geode/geode.conf
Environment=GEODE_DATA_DIR=/var/lib/geode
Environment=GEODE_LOG_DIR=/var/log/geode

# Restart policy
Restart=always
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Resource limits
LimitNOFILE=65536
MemoryLimit=2G

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
PrivateTmp=true

# Allow access to required directories
ReadWritePaths=/var/lib/geode /var/log/geode
ReadOnlyPaths=/etc/geode

# Process management
KillMode=mixed
KillSignal=SIGTERM

# Standard output/error
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geode

[Install]
WantedBy=multi-user.target