# NixOS module for Geode graph database daemon
{ config, lib, pkgs, ... }:

with lib;

let
  cfg = config.services.geode;
  
  # Create the geode package
  geodePkg = pkgs.callPackage ../packages/geode.nix { 
    enableOptimization = true;
    enableQuic = cfg.quic.enable;
  };

  # Configuration file generation
  configFile = pkgs.writeText "geode.conf" (''
    # Geode Configuration File
    # Generated by NixOS module
    
    # Server Configuration
    data_dir = "${cfg.dataDir}"
    log_dir = "${cfg.logDir}"
    
    # Network Configuration
    listen_quic = "${cfg.network.listenAddress}:${toString cfg.network.quicPort}"
    
    # Security Configuration
    tls_cert = "${cfg.tls.certFile}"
    tls_key = "${cfg.tls.keyFile}"
    
    # Performance Configuration
    max_connections = ${toString cfg.performance.maxConnections}
    worker_threads = ${toString cfg.performance.workerThreads}
    memory_limit = "${cfg.performance.memoryLimit}"
    
    # Logging Configuration
    log_level = "${cfg.logging.level}"
    log_json = ${if cfg.logging.json then "true" else "false"}
    
    # Storage Configuration
    wal_segment_size = "${cfg.storage.walSegmentSize}"
    checkpoint_interval = "${cfg.storage.checkpointInterval}"
    page_size = ${toString cfg.storage.pageSize}
    
    # Federation Configuration
    ${optionalString cfg.federation.enable ''
    federation_enable = true
    federation_role = "${cfg.federation.role}"
    federation_peers = [${concatStringsSep ", " (map (peer: ''"${peer}"'') cfg.federation.peers)}]
    ''}
    
    # Backup Configuration
    ${optionalString cfg.backup.enable ''
    backup_enable = true
    backup_s3_bucket = "${cfg.backup.s3Bucket}"
    backup_s3_region = "${cfg.backup.s3Region}"
    backup_schedule = "${cfg.backup.schedule}"
    ''}
    
    # CDC Configuration
    ${optionalString cfg.cdc.enable ''
    cdc_enable = true
    cdc_webhook_url = "${cfg.cdc.webhookUrl}"
    cdc_retention = "${cfg.cdc.retention}"
    ''}
    
    # Additional configuration
    ${cfg.extraConfig}
  '');

  # Create systemd service environment
  serviceEnvironment = {
    GEODE_CONFIG = configFile;
    GEODE_DATA_DIR = cfg.dataDir;
    GEODE_LOG_DIR = cfg.logDir;
  } // cfg.environment;

in {
  options.services.geode = {
    enable = mkEnableOption "Geode graph database daemon";

    package = mkOption {
      type = types.package;
      default = geodePkg;
      description = "The Geode package to use.";
    };

    user = mkOption {
      type = types.str;
      default = "geode";
      description = "User under which Geode runs.";
    };

    group = mkOption {
      type = types.str;
      default = "geode";
      description = "Group under which Geode runs.";
    };

    dataDir = mkOption {
      type = types.path;
      default = "/var/lib/geode";
      description = "Directory where Geode stores its data.";
    };

    logDir = mkOption {
      type = types.path;
      default = "/var/log/geode";
      description = "Directory where Geode stores its logs.";
    };

    network = {
      listenAddress = mkOption {
        type = types.str;
        default = "0.0.0.0";
        description = "IP address to bind to.";
      };

      quicPort = mkOption {
        type = types.port;
        default = 8443;
        description = "Port for QUIC connections.";
      };
    };

    quic = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = "Enable QUIC transport protocol.";
      };
    };

    tls = {
      certFile = mkOption {
        type = types.path;
        default = "/etc/geode/server.crt";
        description = "Path to TLS certificate file.";
      };

      keyFile = mkOption {
        type = types.path;
        default = "/etc/geode/server.key";
        description = "Path to TLS private key file.";
      };

      generateSelfSigned = mkOption {
        type = types.bool;
        default = true;
        description = "Generate self-signed certificates if none provided.";
      };
    };

    performance = {
      maxConnections = mkOption {
        type = types.int;
        default = 1000;
        description = "Maximum number of concurrent connections.";
      };

      workerThreads = mkOption {
        type = types.int;
        default = 0; # 0 = auto-detect
        description = "Number of worker threads (0 for auto-detection).";
      };

      memoryLimit = mkOption {
        type = types.str;
        default = "2GB";
        description = "Memory limit for the Geode process.";
      };
    };

    logging = {
      level = mkOption {
        type = types.enum [ "debug" "info" "warn" "error" ];
        default = "info";
        description = "Logging level.";
      };

      json = mkOption {
        type = types.bool;
        default = true;
        description = "Enable JSON logging format.";
      };
    };

    storage = {
      walSegmentSize = mkOption {
        type = types.str;
        default = "64MB";
        description = "WAL segment size.";
      };

      checkpointInterval = mkOption {
        type = types.str;
        default = "5m";
        description = "Checkpoint interval.";
      };

      pageSize = mkOption {
        type = types.int;
        default = 8192;
        description = "Database page size in bytes.";
      };
    };

    federation = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = "Enable federation mode.";
      };

      role = mkOption {
        type = types.enum [ "coordinator" "shard" ];
        default = "shard";
        description = "Federation role (coordinator or shard).";
      };

      peers = mkOption {
        type = types.listOf types.str;
        default = [];
        description = "List of federation peer addresses.";
      };
    };

    backup = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = "Enable S3 backups.";
      };

      s3Bucket = mkOption {
        type = types.str;
        default = "";
        description = "S3 bucket for backups.";
      };

      s3Region = mkOption {
        type = types.str;
        default = "us-east-1";
        description = "S3 region for backups.";
      };

      schedule = mkOption {
        type = types.str;
        default = "0 2 * * *"; # Daily at 2 AM
        description = "Backup schedule (cron format).";
      };
    };

    cdc = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = "Enable Change Data Capture.";
      };

      webhookUrl = mkOption {
        type = types.str;
        default = "";
        description = "Webhook URL for CDC events.";
      };

      retention = mkOption {
        type = types.str;
        default = "7d";
        description = "CDC event retention period.";
      };
    };

    monitoring = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = "Enable Prometheus metrics endpoint.";
      };

      metricsPort = mkOption {
        type = types.port;
        default = 9090;
        description = "Port for Prometheus metrics.";
      };
    };

    environment = mkOption {
      type = types.attrsOf types.str;
      default = {};
      description = "Additional environment variables for the Geode process.";
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
      description = "Additional configuration options.";
    };

    extraArgs = mkOption {
      type = types.listOf types.str;
      default = [];
      description = "Additional command-line arguments.";
    };
  };

  config = mkIf cfg.enable {
    # Create user and group
    users.users.${cfg.user} = {
      description = "Geode graph database daemon user";
      isSystemUser = true;
      group = cfg.group;
      home = cfg.dataDir;
      createHome = true;
    };

    users.groups.${cfg.group} = {};

    # Create directories with proper permissions
    systemd.tmpfiles.rules = [
      "d '${cfg.dataDir}' 0750 ${cfg.user} ${cfg.group} - -"
      "d '${cfg.logDir}' 0750 ${cfg.user} ${cfg.group} - -"
      "d '/etc/geode' 0755 root root - -"
    ];

    # Generate self-signed certificates if requested
    systemd.services.geode-cert-gen = mkIf cfg.tls.generateSelfSigned {
      description = "Generate self-signed certificates for Geode";
      wantedBy = [ "geode.service" ];
      before = [ "geode.service" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        User = "root";
        Group = "root";
      };
      script = ''
        if [ ! -f "${cfg.tls.certFile}" ] || [ ! -f "${cfg.tls.keyFile}" ]; then
          echo "Generating self-signed certificates for Geode..."
          ${pkgs.openssl}/bin/openssl req -x509 -newkey rsa:4096 -keyout "${cfg.tls.keyFile}" \
            -out "${cfg.tls.certFile}" -days 365 -nodes -subj "/CN=geode-server"
          chown ${cfg.user}:${cfg.group} "${cfg.tls.certFile}" "${cfg.tls.keyFile}"
          chmod 600 "${cfg.tls.keyFile}"
          chmod 644 "${cfg.tls.certFile}"
        fi
      '';
    };

    # Main Geode systemd service
    systemd.services.geode = {
      description = "Geode Graph Database Daemon";
      documentation = [ "https://github.com/spyderorg/geode" ];
      wantedBy = [ "multi-user.target" ];
      after = [ "network.target" ] ++ optional cfg.tls.generateSelfSigned "geode-cert-gen.service";
      wants = optional cfg.tls.generateSelfSigned "geode-cert-gen.service";

      serviceConfig = {
        Type = "exec";
        User = cfg.user;
        Group = cfg.group;
        ExecStart = concatStringsSep " " ([
          "${cfg.package}/bin/geode"
          "serve"
          "--config=${configFile}"
          "--data-dir=${cfg.dataDir}"
        ] ++ cfg.extraArgs);
        
        # Security settings
        NoNewPrivileges = true;
        ProtectSystem = "strict";
        ProtectHome = true;
        ProtectKernelTunables = true;
        ProtectKernelModules = true;
        ProtectControlGroups = true;
        RestrictRealtime = true;
        RestrictSUIDSGID = true;
        RemoveIPC = true;
        PrivateTmp = true;
        
        # Allow access to required directories
        ReadWritePaths = [ cfg.dataDir cfg.logDir ];
        ReadOnlyPaths = [ "/etc/geode" ];
        
        # Resource limits
        LimitNOFILE = 65536;
        MemoryLimit = cfg.performance.memoryLimit;
        
        # Restart policy
        Restart = "always";
        RestartSec = 10;
        TimeoutStartSec = 60;
        TimeoutStopSec = 30;
        
        # Health check
        ExecReload = "${pkgs.coreutils}/bin/kill -HUP $MAINPID";
        KillMode = "mixed";
        KillSignal = "SIGTERM";
      };
      
      environment = serviceEnvironment;
    };

    # Backup service if enabled
    systemd.services.geode-backup = mkIf cfg.backup.enable {
      description = "Geode Database Backup";
      serviceConfig = {
        Type = "oneshot";
        User = cfg.user;
        Group = cfg.group;
        ExecStart = "${cfg.package}/bin/geode backup --s3-bucket=${cfg.backup.s3Bucket} --s3-region=${cfg.backup.s3Region}";
      };
      environment = serviceEnvironment;
    };

    # Backup timer if enabled
    systemd.timers.geode-backup = mkIf cfg.backup.enable {
      description = "Geode Database Backup Timer";
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnCalendar = cfg.backup.schedule;
        Persistent = true;
        RandomizedDelaySec = 300; # 5 minutes
      };
    };

    # Open firewall ports
    networking.firewall = mkIf cfg.enable {
      allowedTCPPorts = [ cfg.network.quicPort ] ++ optional cfg.monitoring.enable cfg.monitoring.metricsPort;
      allowedUDPPorts = [ cfg.network.quicPort ]; # QUIC uses UDP
    };

    # Log rotation
    services.logrotate.settings.geode = mkIf cfg.enable {
      files = "${cfg.logDir}/*.log";
      frequency = "daily";
      rotate = 30;
      compress = true;
      delaycompress = true;
      missingok = true;
      notifempty = true;
      copytruncate = true;
      su = "${cfg.user} ${cfg.group}";
    };
  };
}