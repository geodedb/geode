# Geode Docker Development Environment Configuration
# Copy this file to .env and customize as needed:
#   cp .env.docker-dev.example .env

# User Configuration (match your host user to avoid permission issues)
USER_UID=1000
USER_GID=1000
USERNAME=dev

# Development Settings
GEODE_ENV=development
LOG_LEVEL=debug
RUST_BACKTRACE=1

# Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=geode-dev-token

# Redis Configuration
REDIS_PASSWORD=geode-dev-password
REDIS_URL=redis://:geode-dev-password@redis:6379

# MinIO (S3) Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=geode-dev-admin
S3_SECRET_KEY=geode-dev-secret-123
S3_BUCKET=geode-dev-backups

# Security Settings
FIPS_MODE=enabled

# Build Configuration
ZIG_VERSION=0.15.1
TARGETARCH=amd64

# Optional: Monitoring Stack
# Uncomment to customize Grafana/Prometheus
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=geode-dev-password
# PROMETHEUS_RETENTION=7d
