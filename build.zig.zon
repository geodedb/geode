.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.1.4",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.15.1",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#68b603c30375393cf76d111017f5b0c5ffd2961f",
            .hash = "uri-0.1.0-zVvOsZlhAgBafFPMKItHDONtUJRATlLWy0JetxUMbzl3",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git#7aae63cd0ac2d38b8cf8103c6915e2aff0c85d6a",
            .hash = "yaml-0.1.1-lcW-hPehBAClU9UapP0GogTW5F_t4UVMCkKwSm3cM9hZ",
        },

        // TOML v1.1.0 parser
        .toml = .{
            .url = "git+https://gitlab.com/devnw/zig/toml.git#a4eeb604098f31158d452354d81eaae56c6b3f06",
            .hash = "toml-0.1.0-MHnSh8otAgDvGZTheWwT2tCZ1TRKQIxKIFiDlTYlszPK",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#ec56f30914582f5b5005edc5043f4a9b845be876",
            .hash = "strings-0.1.0-adMOtbqaJgB-ofnNlia2TnnGrFT0mr8vYO1ys0hefeim",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            .url = "git+https://gitlab.com/devnw/zig/repl.git#b27a287420d33be9848fe0f2e4921f39fc6c16a2",
            .hash = "repl-0.1.0-gwF1T0haBQB4jId_6euLKrM_FsDv-5dvyw2GZyHh-Bgs",
        },

        // Vulkan compute library
        .vulkan = .{
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git#ccd7679b1411e605e38e079bb6e911ea5b4a819b",
            .hash = "vulkan-0.1.0-zh1htQ1lEQDl9u0wV9KyHmoNQIGCqPw_2WPgQ0DOWxLt",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#f9ed006f54f49dfa7b067e478fba25287d6882f0",
            .hash = "json-0.1.0-tOue4QGoCwBCW2fq2BeCL3TLptE7K5XXeoP5NWiMcQOz",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-03-27: v0.1.11+ (a979f59) — split endpoint mutex,
        // ACK data race fix, bytes_in_flight leak fix, narrow handshake locks.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#0d4178eac097db0012437e40ad33dad9a9b28c67",
            .hash = "quic-0.1.11-gBIqUV_iNQCxxXGcginIT8nclBglP6tPzKF530LrWLka",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#4f979be2fe1a1625d01845547f110282014f9c0c",
            .hash = "slog-0.1.0-SamED4U0BgA8WdNZCC7Xx_0fGwb22V7S5vcbiFXysXG4",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#fffce60b188441be7b6422522cb412f988897a5f",
            .hash = "config-0.1.0-TiLumtlACgCU1wB3O9kf3ko_DrCSSra3qmZyuVU-28Pe",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git#09a7caf6f46d0da13daf213008c1328f69932a7a",
            .hash = "cli-0.1.1-0aso9IulBgAopCkKkuAMOffqXsM2LfuSnzftSU0b3LSs",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#c947e3af747923b0aa170009384167c6b66d9ffd",
            .hash = "dns-0.1.0-x4U-zWZXEAD9KqyMwESwwKEuMcRD0yrP6E8zMkEHwkvt",
        },

        // Thread Pool - Bounded, lock-free thread pool with work-stealing
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#98a94afb01726bd533c109e28901e58b18848b81",
            .hash = "thread_pool-0.2.0-11B1BlZbOQCfrvQ2WzuIbCsl9TIjkrC6H_U1CbI9vm3K",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git#71e9376c5b3209666cf3bfd7f57027db24a61995",
            .hash = "mcp-0.1.0-exAeBJ9hBQC_1F-0YJ3h-rUeZeI_DxqhUpcJIgTsw4tM",
        },

        // Protocol Buffers - Zig 0.15.2 compatible
        .protobuf = .{
            .url = "git+https://gitlab.com/devnw/zig/protobuf.git#c02f3aa0abc445eb033ac9bbe0cc914e44e2c70b",
            .hash = "protobuf-3.0.0-0e82ar5fKQCTVWPjChWGJ2esh1wKBDTVX_UfmQy7XRPO",
        },

        // gRPC for Zig
        // Updated 2026-02-11: concurrent connections, HPACK Huffman, TLS errdefer
        // GAP-0443: Use git+https URL with full commit hash for supply chain auditability
        .grpc_zig = .{
            .url = "git+https://gitlab.com/devnw/zig/grpc-zig.git#b2bd249737ec6b041947597676db102df2a10067",
            .hash = "grpc_zig-0.1.0-7FnvpFi7AQAR6YQ_iC-CGmKsyD4SRMKMnUWCzW4ROtmb",
        },
        .geode_client_zig = .{
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git#8cc6935151361488f5024f26869f96431fd493a2",
            .hash = "geode_client_zig-0.2.1-8ysbVw2NCACwLGlEvLYlZ9WHmmbTTmAFprfW0mtRGw1F",
        },

        // =======================================================================
        // Phase 6: Extracted Core Libraries
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7, injectable generator
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#4a960e8e573ef79497ec2a2470273cf17df89e5d",
            .hash = "uuid-0.1.0-tL1irqsGDAAcOzxBzLlKrEEsemPKKNsLhgxurxXZgSdL",
        },

        // WAL - Generic, payload-agnostic Write-Ahead Log with AES-256-GCM encryption
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git#bbba4b9a66c8dcc576f6932687a3e7a2a84974dc",
            .hash = "wal-0.1.0-EqPqpuyTAwCE7t1JjvjLT7k8t0NFsPDFIWEJ4AEMEX1U",
        },

        // Page-based graph storage engine
        // Updated 2026-04-07: audit closure plus iterator-backed scans, streamed
        // backup/recovery paths, bounded deserialization, persisted edge index,
        // and fail-closed integrity handling
        .graph_storage = .{
            .url = "git+https://gitlab.com/devnw/zig/graph-storage.git#c5fb53aad8913aed6bc8f0f2749d94230dca49c1",
            .hash = "graph_storage-0.1.0-9UyJS-hECwDePxWrqdehrCfA7FozBeXDorB9CiUetVIN",
        },

        // Raft - Full Raft consensus with pre-vote, joint consensus, snapshotting
        .raft = .{
            .url = "git+https://gitlab.com/devnw/zig/raft.git#ea8fbbd4e48001a03af5eca49f8268c610e314ec",
            .hash = "raft-0.1.0-PqJyvkNCBACjoZFAj6zbFbS34oSK6-vWrefceScAmxxJ",
        },

        // =======================================================================
        // Phase 7: Extracted Domain Libraries
        // =======================================================================

        // Audit - Event modeling, filtering, CEF formatting, syslog/file sinks
        .audit = .{
            .url = "git+https://gitlab.com/devnw/zig/audit.git#6afedb73cb7f794d895abb3c3614d6a81988cc83",
            .hash = "audit-0.1.0-J9TtCCQhAwCed_BuOaShB2sYqYr5sjRA94KZVv7lmBRT",
        },

        // HNSW - Approximate nearest-neighbor index with configurable distance metrics
        .hnsw = .{
            .url = "git+https://gitlab.com/devnw/zig/hnsw.git#cbf643d02a7841833e0fc8f8eafb88a99521785e",
            .hash = "hnsw-0.1.0-wYzBy0ESAQAshb0jxmLk1TKVWmwOKtglTlEVQnqWbRrh",
        },

        // R-tree - Spatial index with bounding-box search
        .rtree = .{
            .url = "git+https://gitlab.com/devnw/zig/rtree.git#24f5986527b46f983390277f5e02c38a8f7c2464",
            .hash = "rtree-0.1.0-kIpcH5waAQCaVsXM94KXn7lgOm0xlEUjevgrTP0lCNkZ",
        },

        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#d75714987f4689cc902590fe1ae45583ab864eb3",
            .hash = "advanced_types-0.1.0-pbHnCtw-AgDAdsufaeR7F6-jj8PERUbCIvO_O8zHX7VX",
        },

        // FLE - Field-level encryption with AEAD, HKDF, blind indices
        .fle = .{
            .url = "git+https://gitlab.com/devnw/zig/fle.git#4e3cdfca8ce29f603b879ba2940f9d57b060e9a8",
            .hash = "fle-0.1.0-1Cfwlb5KAQDmGZPa_-DMrgHUn5L8gujyUi8SEc8Abumm",
        },

        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#c9145b8aae3a57eb3436a380f332deb60aea753c",
            .hash = "gql-0.1.0-T1ANDYqLCAAJHOhJBVqrV_KBvQwXsobgpLIGoiBRFqCV",
        },

        // Timeseries - Pattern matching, DTW, matrix profile, PELT change-point detection
        .timeseries = .{
            .url = "git+https://gitlab.com/devnw/zig/timeseries.git#f511a0e69cbe10978a593e46e00e8f1ab2b2b82d",
            .hash = "timeseries-0.1.0-iAEwOq7oAwDjfmZH7eMadUIalphxV5EI5hyjl4TWsT6c",
        },

        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#e63466720b5e019cdb3684b12728187f6478c243",
            .hash = "auth-0.1.0-W76ZZ2r9AABn71BDR_5VIfH9lWTDbuVk7TT64MfgYbt3",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "benchmarks",
        "tools",
        "geodetestlab",
    },
}
