            .hash = "repl-0.1.0-gwF1T66xAgCW6w1v0xNV5V5CzO7NjZNVxwnDZB57vFqz",
        },

        // Data structures and graph algorithms
        .ds = .{
            .url = "git+https://gitlab.com/devnw/zig/ds.git#84099102faa97f15c61400cbc5d34439ba21c48f",
            .hash = "ds-0.1.0-aDfG0wXVBwDdvKydZbkkjzWY-a_yV9LKiL0P-3UKjvmD",
