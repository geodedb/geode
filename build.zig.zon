        .fips = .{ .url = "git+https://gitlab.com/devnw/zig/fips.git#v0.1.1", .hash = "fips-0.1.1-1wf3na01BwC3voljVu61_0g6DXp6BCedXrq4QMuMeQBq", .lazy = true },
