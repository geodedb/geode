            .hash = "protobuf-3.0.0-0e82alVdKQAeG_KZQVDXKUNSeMH2vbT1c-ceP6Iz5g10",
        },

        // gRPC for Zig
        // Updated 2026-02-11: concurrent connections, HPACK Huffman, TLS errdefer
        // GAP-0443: Use git+https URL with full commit hash for supply chain auditability
        .grpc_zig = .{
            .url = "git+https://gitlab.com/devnw/zig/grpc-zig.git#8d019736ae1ae016eae3183bdeb319c4c524057f",
            .hash = "grpc_zig-0.1.0-7FnvpLe5AQB55BMGuoZVuPYg3JGT8Gj1tSRfhmDqQGQe",
        },

        // =======================================================================
        // Phase 6: Extracted Core Libraries
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7, injectable generator
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#8cdb557c8eff300024bee366910d07d48a0fc1d7",
            .hash = "uuid-0.1.0-tL1irlIADAAxQDmRzbR1y1LDpYQ4kECnByt-CzlET8HW",
