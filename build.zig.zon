        .fips = .{ .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.3#f7395a3bab363d75b651be0775f43dd037c14a9c", .hash = "fips-0.1.3-1wf3natvCACgXCcDLw4o0KwZtrNNpXyyRp1hNIA9oi2m", .lazy = true },
