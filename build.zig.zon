            .url = "git+https://gitlab.com/devnw/zig/wal.git?ref=v0.1.27#e8d1c51ea00e7788fe950e6f3251c48e8852d2bc",
            .hash = "wal-0.1.27-EqPqpqU_CAB-RfhJaHAM2nOpRpSxl6sykpzcdKXPuKpd",
        },

        // Page-based graph storage engine
        // Updated 2026-04-24: ShardedGraphEngine with N=16 single-threaded shards,
        // per-shard WAL/manifest, 2PC cross-shard edges, parallel per-shard crash
        // recovery. Microbench verified ≥4× throughput vs single-engine at 16 cores.
        // See docs/superpowers/specs/2026-04-24-sharded-graph-engine-design.md
        // in the graph-storage repo.
        // 2026-06-18: v0.2.3 (98f179b) — GAP-0900 Layer-2 incremental checkpoint:
        // adds engine.checkpointLight()/sharded_engine.checkpointLight() that flush
        // dirty pages + truncate the WAL but SKIP the O(graph) derived-index save
        // (recovery rebuilds those from pages). Cherry-picked onto v0.2.2 so sibling
        // dep pins are unchanged. Bounds deferred-mode checkpoint cost to O(dirty) so
        // the periodic checkpoint keeps pace with sustained bulk ingest.
        // Bumped 2026-06-23 to v0.2.7 (1c73f44) — lock-free buffer-pool pin/unpin hit path
        // + pin mutex-leak fix (aborts under concurrent reads+writes with eviction).
        //
        // PHASE 3 (edge-engine-direct) DEV PIN — 2026-06-24:
        // Temporarily overridden to a LOCAL PATH so geode builds against the
        // unreleased graph-storage edge-EXISTENCE index (probeEdge / O(1) durable
        // MERGE dedup; commit d91173e on branch feat/edge-engine-direct in the
        // graph-storage worktree). `git+file://` is unsupported by `zig fetch` and
        // the commit is not pushed, so a path override is the correct sandbox dev
        // pin. AT MERGE-TO-MAIN: tag graph-storage (e.g. v0.2.8), restore the
        // url+hash form below, then run the diamond-cascade bump across consumers.
        // Prior pin (restore at release):
        //   .url  = "git+https://gitlab.com/devnw/zig/graph-storage.git?ref=v0.2.8#<sha>",
        //   .hash = "graph_storage-0.2.8-<...>",
        .graph_storage = .{
            // v0.2.15 = v0.2.14 + value-ordered secondary index (H3): order-preserving
            // encoder + ordered B+Tree + per-(label,key) per-shard index, counter-gated
            // persistence + checkpoint-refresh. Additive/gated (active only when an
            // ordered index is registered). Same FIPS transitive deps -> no diamond.
            // v0.2.14 = v0.2.13 + Lever B: a CLEAN restart LOADS the persisted
            // derived index snapshots (O(snapshot)) instead of the O(graph)
            // rebuildDerivedIndexes — a full checkpoint now persists dirty derived
            // indexes even when pages are clean. Crash restarts still rebuild
            // (manifest.counter gate + recovery bump unchanged → stale snapshots
            // rejected). v0.2.13 = v0.2.12 + parallel 16-shard open recovery
            // (concurrent shard opens; recovery makes no thread-pool calls so it
            // cannot re-enter the v0.2.12 pin deadlock). Same FIPS transitive deps
            // → no diamond.
            // v0.2.21 (2026-07-01): O(1)-amortized CLOCK eviction (buffer_pool)
            // + getPropertyNoDerived (chain read without derived-index hydration)
            // + open-time pool-recreate hardening — the engine half of the
            // sub-second cold-open work (geode perf/coldopen-loop1-prop_head).
            // Same transitive deps as v0.2.20 (no diamond).
            // v0.2.23 (2026-07-01): prop-store SLAB PACKING — node property
            // blobs packed into shared pages (~55-59x props-store reduction,
            // measured 149.4 bytes/node through the geode stack vs 8192);
            // read-both (legacy chains still read); WAL/crash-safe (whole-page
            // images of decoded slab pages); edge properties stay legacy via
            // putPropertyLegacyTxn (adapter sites switched). Whole-branch
            // review: READY TO RELEASE (no blockers). Supersedes the v0.2.22
            // tag (points pre-version-bump; do not pin it).
            // v0.2.24 (2026-07-02): INLINE EDGE PUBLIC ID (GAP-ENT-0024) —
            // adjacency EdgeEntry carries `public_id: u64` in v2 blocks (v1
            // blocks surface 0; block-granular read-both, no store migration);
            // addEdgeColocatedWithPublicId on GraphEngine + ShardedGraphEngine;
            // EdgeIndexEntry / FanInEdgeIterator / edge-index snapshot carry the
            // id. Manifest V3: pre-v0.2.24 binaries loudly reject v0.2.24
            // stores; v2 stores auto-upgrade at open. Lets geode stop writing
            // the `__geode_internal_edge_id` property page per edge (~8 KB/edge
            // -> 0 for propertyless edges). Same transitive deps (no diamond).
            // v0.2.29 (2026-07-06): WAL-aware derived-index durability (Path B) —
            // Manifest V4 adds a durable `checkpoint_epoch` advanced ONLY by
            // doCheckpoint (never by recovery), so a derived-index snapshot
            // stamped (checkpoint_epoch, covered_lsn) survives a deferred-WAL
            // tail on reopen: the engine's own label/property/edge/edge_exist
            // indexes RELOAD when epoch matches and RECONCILE the bounded WAL
            // tail (re-derive entries for tail-touched pages) at first access,
            // instead of the O(graph) rebuild the counter gate forced. Geode
            // rides the SAME contract for its own prop_exact.idx via the epoch
            // getter the adapter's engine handle exposes. Manifest V4:
            // pre-v0.2.29 binaries loudly reject v4 stores. Same transitive
            // deps as v0.2.28 (no diamond).
            // v0.2.35 (2026-07-07): GAP-0060 EDGE-PROP SLAB PACKING — edge
            // prop_head widened u32->u64 across the edge index + durable
            // adjacency (new v3/slab-v3 40B wire formats, edge-index magic
            // GSEIDX5->GSEIDX6, block-granular read-both, LOUD no-truncate on a
            // >u32 head into a legacy record). Edge properties now slab-pack via
            // putPropertyTxn (adapter edge-write sites re-routed, gated on
            // edge_prop_slab_packing, default ON) — ~8 KB/edge -> ~90 B/edge
            // (~111 GB -> few GB at 13.6M edges). Bundles GAP-0050: value-ordered
            // (H3) index on the (checkpoint_epoch,last_checkpoint_lsn) reload
            // contract. No manifest bump (stays V4; the adjacency entry-format
            // byte + read-both is the versioning). Same transitive deps as
            // v0.2.34 (no diamond).
            // v0.4.0 (2026-08-25): PROPERTY-VALUE OVERFLOW — a property value
            // whose entry (2 + key.len + encoded value) exceeds the ~8142-byte
            // inline per-page budget no longer fails: the encoded value spills
            // into a VarStore overflow chain and a fixed 13-byte tag-7 stub
            // takes its place in the entry, so the insert path downstream is
            // unchanged. New `GraphConfig.max_property_value_bytes` (default
            // 1 MiB) is the sanity cap that bounds WAL record volume and per-op
            // memory for a spill (SEC/DoS); a value above it is refused BEFORE
            // any page or WAL byte is owed. TRUTHFUL ERROR SPLIT:
            // `error.PropertyValueTooLarge` now means the VALUE exceeded the
            // cap, and `error.PropertyKeyTooLong` is reserved for a genuinely
            // oversized KEY (one whose key bytes + the 13-byte stub cannot fit
            // an entry) — geode's adapter re-map for the mis-attributed case is
            // therefore obsolete. A VECTOR<f32> now stores up to ~262,144 dims
            // (4096-dim embeddings are 16 KB) instead of 2030. Stores that hold
            // no overflowed values stay byte-compatible (no manifest bump; the
            // stub tag is the versioning). Same transitive deps as v0.3.2 (no
            // diamond).
            // v0.4.13 (2026-11-13, SONNY-6461): `GraphEngine.repairAdjTailEntries`
            // restores the adjacency-entry fields that stores written by <= 0.4.11
            // with TDE lost to the page-tail tag (the last entry of a full v3
            // block at 4 KiB, a full v1 block at 8 KiB) from the opposite-direction
            // mirror, and reports what it cannot restore; `edge.legacyTailLoss`
            // owns the loss table. Page checksums use hardware CRC32C (SSE4.2 /
            // ARMv8 CRC, software fallback): an 8 KiB page ~15.6 us -> ~0.75 us on
            // every buffer-pool miss and flush. Adds an offline `free_space.FreeStore`
            // reader (`FreeSpaceManager.buffer_pool` is now `?*BufferPool`) and
            // fixes the compare-bench zero-baseline PASS. No geode dependency
            // other than geode itself consumes graph-storage (no diamond on it).
            // v0.4.14 (2026-11-13, SONNY-6473, SONNY-6491, SONNY-6470): crash
            // recovery applies only the newest committed image of each page (by
            // LSN), so overlapping batched transactions no longer lose committed
            // writes after a crash, including WALs already on disk. Checkpoint
            // side files are ordered for crash safety (free.store durable before
            // the manifest; the manifest rename dir-fsynced before the WAL
            // truncate; a stale free.store from an older release is detected and
            // rebuilt). Label names are made durable when first assigned
            // (`getOrAssignLabel` does tmp+fsync+rename+dir-fsync of the shard's
            // labels.dict per NEW name; checkpoints no longer write labels.dict;
            // `create` writes an empty one): labels are not in the WAL, so a
            // crash used to lose names assigned since the last checkpoint. WAL
            // record checksums use streaming hardware CRC32C; free.store refuses
            // a host layout it would misread. API additions only
            // (`crc32c.Hasher`, `free_space.checkHostLayout`,
            // `free_space.host_layout_supported`). Same transitive deps as
            // v0.4.13 (no diamond).
            // v0.4.15 (2026-11-13, SONNY-6524): a new label name is made
            // durable on shard 0, then on shards 1..15 in parallel with shard
            // 0's id (was 16 shards one after another); a failed durable write
            // is undone in memory; a shard that holds the name or the id
            // differently fails with `error.LabelDictionaryDiverged`.
            // `ShardedGraphEngine.open` compares every shard's labels.dict with
            // shard 0's: it repairs a shard when no record there uses a
            // disputed id and otherwise refuses with
            // `error.LabelDictionaryDiverged` (opt-in
            // `GraphConfig.label_dict_divergence = .adopt_shard0` rewrites
            // from shard 0). API additions only; no store format change. Same
            // transitive deps as v0.4.14 (no diamond).
            // v0.4.16 (2026-11-14, SONNY-6529, SONNY-6527): `abortTxn` UNDOES
            // the transaction's writes (per-write journal; the undo is logged
            // in the aborting transaction and ended with COMMIT, so it is
            // crash-safe). A transaction it cannot undo exactly (a page the
            // caller imaged with `logPagePublic`/`zeroPageLogged`, a property
            // change on a legacy chain or one freeing an overflow value, a
            // `putNodeTxn` moving a chain pointer of an existing node, more
            // than 1,048,576 writes) fails with `error.AbortNotUndone`, after
            // which every write, commit and checkpoint of that engine fails
            // until it is reopened (`abort_undo = .fail_closed`, the default;
            // geode never sets `.keep_writes`). `setEdgePropertyTxn` joins the
            // caller's transaction; the tail reconcile re-derives `.adj_out`
            // page owners, so a relationship-property SET no longer needs the
            // source node-page image. `persistence_dirty` is atomic;
            // `error.LabelIdSpaceExhausted`; `GraphConfig.label_dict_report`;
            // `Metrics.txn_aborts_undone`/`txn_aborts_not_undone`. No store
            // format change. Same transitive deps as v0.4.15 (no diamond).
            // v0.4.17 (2026-11-15, SONNY-6590): ON-DISK FORMAT CHANGE under
            // `GraphConfig.encryption_key`. `labels.dict`, `props.idx`,
            // `ordered_propidx.snap`, `props.catalog` and `propidx_*.btree`
            // are sealed (AES-256-GCM, HKDF-SHA256 side-file key, random
            // 96-bit nonce, AD = header + graph uuid + file name; envelope
            // in `side_file_crypto`). Manifest format_version 5 marks a
            // sealed store; a <= 0.4.16 store under a key is upgraded in
            // place at open (crash-safe; 5 written by the next checkpoint or
            // close). New open errors: `error.SideFileEncrypted` (sealed, no
            // key), `error.SideFileAuthFailed` (wrong key, modified or foreign
            // file), `error.SideFileNotSealed` (plaintext in a sealed store).
            // `LabelDictionary.loadFromFile` refuses a sealed file (use
            // `loadFromFileWith`). graph_storage <= 0.4.16 cannot open a
            // store once it is sealed (no downgrade). Same transitive deps as
            // v0.4.16 (no diamond).
            // v0.4.18 (SONNY-6605): `BufferPool.pageNewerThanDisk` /
            // `PageFrame.newerThanDisk` (dirty, or a flush's write of the
            // page still in flight). geode's hydration scan reads every
            // resident frame through the pool (SONNY-6597), a superset.
            // v0.4.20 (2026-11-15, SONNY-6616, SONNY-6622): a wrong key is
            // `error.EncryptionKeyMismatch` (was `NoManifest`); the graph
            // registry (`GraphRegistry.saveToFileWith` / `loadFromFileWith`)
            // and the topology snapshots `edges.idx` / `edges_exist.idx` are
            // sealed under the key; `side_file_crypto.Kind` 128..255 are the
            // consumer's (`Kind.consumer(n)`); `WalManager.init` maps wal's
            // WalAuthFailed / WalEncryptionMismatch to EncryptionKeyMismatch
            // and keeps WalCorrupted; a refused WAL compaction no longer
            // fails the checkpoint; `VerifyTool` reads the WAL from a copy
            // under the key. Pins wal v0.1.25 and thread_pool v0.2.11
            // (geode's); its otel chain's thread_pool v0.2.9 is the
            // pre-existing diamond (SONNY-6630). The tag is on the MR merge
            // commit cacb325, whose tree is the release commit 845b454's.
            // v0.4.21 (2026-11-15, SONNY-6632): writes of one frame land in
            // copy order (a flush waits for the frame's write in flight
            // before copying it), and flushAll / flushDirty wait for every
            // write in flight, so a checkpoint no longer truncates the WAL
            // before a page's new image is on disk. No API change; same
            // dependencies as v0.4.20. Tagged on the MR merge 160046c, same
            // tree as the release commit 3ffeba7.
            // v0.4.22 (2026-11-16, SONNY-6599, SONNY-6595 item 5): recovery
            // fsyncs the directory and truncates the WAL it replayed, and an
            // open drains a WAL whose contents the pages already cover (a
            // shard not written after a crash restart kept its tail); a
            // double delete no longer under-counts; `removeEdgeTxn` also
            // removes legacy `adj_in` entries; edge-property slab slots are
            // attributed (GSRVIX2); an overflow replacement is freed at commit
            // (undoable); iterator wrappers release on OOM. Tagged on
            // 8271e65. Same dependencies as v0.4.21 (wal v0.1.25,
            // thread_pool v0.2.11, otel v0.1.28); same wal routing (build.zig
            // points its "wal" import at geode's v0.1.25).
            // v0.4.25 (2026-11-16, SONNY-6659): a page has one open writer: a
            // second open transaction's write to a page another open one
            // wrote fails with `error.WriteConflict` (it cannot commit; its
            // abort undoes it in memory). Each open transaction fills slab
            // pages of its own, and `allocNodeTxn` (GraphEngine,
            // ShardedGraphEngine) gives it node ids from a node page of its
            // own; plain `allocNode` while another transaction is open
            // shares a node page and conflicts. Same dependencies as v0.4.24.
            // Tagged on f92e685, same tree as the release commit 9d84132.
            // v0.4.26 (2026-11-16, SONNY-6635): a data directory's registry
            // is sealed under its own identity (`registry.DataDirIdentity`,
            // `data_dir.identity`, sealed; a random uuid and a "registry
            // bound" flag), not the shared `SEAL_UUID`, so a registry copied
            // from another data directory under the same key fails
            // authentication; `side_file_crypto.Kind.data_dir_identity` (9).
            // `VerifyTool` copies the WAL into `.verify-wal-<random>` inside
            // the graph's directory (0700), not $TMPDIR. Additive API, same
            // dependencies as v0.4.25. Tagged on 4ba18a0 (MR !35,
            // fix/sonny-6635-registry-identity).
            // v0.4.27 (2026-11-17, SONNY-6692): `GraphEngine` /
            // `ShardedGraphEngine.scrubDeadSpace` overwrite dead space (free
            // property and var-store pages, tombstoned slab blobs) in one
            // logged transaction; the next checkpoint writes the cleared
            // pages and truncates the WAL. Additive API, same dependencies as
            // v0.4.26. Tagged on 2c2c560 (MR !36,
            // fix/sonny-6692-scrub-dead-space).
            // v0.4.28 (2026-11-17, SONNY-6700): `scrubDeadSpace` proves
            // ownership first (a walk of every live node's properties and
            // labels and every out-edge's properties, following overflowed
            // values) and also clears freed var-store slab runs and zeroes
            // and frees allocated pages no live record owns; `ScrubReport`
            // gains `var_slab_blocks_scrubbed`, `var_slab_bytes_zeroed`,
            // `orphan_pages_freed`. Same dependencies as v0.4.27. Pinned to
            // the v0.4.28 tag on 024e7be (MR !37,
            // fix/sonny-6700-scrub-var-slab-orphans).
            // 2026-11-18: v0.4.30 (ccd73b5, SONNY-6630) — re-released on otel
            // v0.1.30 / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/graph-storage.git?ref=v0.4.30#ccd73b5118c266b0f4cb08afae4e4a81a2144545",
            .hash = "graph_storage-0.4.30-9UyJS9AOOAAWdZCcHhGeN5jLrUYwnZeT0XxuNCc19SsG",
        },

        // Raft - Full Raft consensus with pre-vote, joint consensus, snapshotting
        // Bumped 2026-06-14 to v0.1.8 (d101908) — RC-B: etcd-style candidate
        // demotion on quorum vote rejection (a quorum-denied / frozen candidate
        // now steps down to follower instead of cycling the election loop),
        // closing the consensus-layer half of the no-leader all-candidate livelock
        // (docs/bugs/2026-06-04-cluster-raft-no-stable-quorum-writes-time-out.md).
        // Bumped 2026-06-15 to v0.1.9 (555dbb3) — RC-B iteration 2: timer-based
        // candidate demotion. v0.1.8's demotion only fires on a quorum REJECTION;
        // a transport-degraded candidate or a pre-vote mutual-grant lockstep
        // forms no rejection quorum and stayed a candidate forever (v0.6.27-30
        // residual). After N consecutive failed elections the candidate now steps
        // down + backs off (Config.candidate_demote_threshold, default 4).
        // 2026-11-15: v0.2.0 (d736de4, SONNY-6592, breaking) — votes, a
        // candidate's RequestVote and every vote / append / snapshot reply are
        // queued in Ready.messages ([]const Outbound{to, msg}) for the consumer
        // to send after advancePersist(), no longer sent from step()/tick();
        // leader AppendEntries, heartbeats and InstallSnapshot still go to the
        // Transport at once (the node frees their data when send returns).
        // Storage.entries and RaftLog.slice return owned entry data
        // (freeEntries); committed_entries data lives until advanceApply(). A
        // node outside its voter set no longer campaigns. Same wal and
        // thread_pool pins as geode (its thread_pool 0.2.9 diamond is gone).
        // 2026-11-15: v0.2.2 (25614ee, SONNY-6622, SONNY-6611) — wal v0.1.24;
        // FileStorage refuses a damaged log (StorageError.LogCorrupted /
        // LogAuthFailed / LogEncryptionMismatch) instead of truncating it; the
        // leader counts only persisted entries toward commit (a commit shows
        // one Ready cycle later); a second ready() before advanceApply() is
        // ReadyNotAdvanced; a snapshot installed between ready() and advance()
        // is delivered in Ready.snapshot (owned by the Ready until
        // advanceApply()); fast backtracking (AppendEntriesResponse
        // conflict_index / conflict_term, match_index = the rejected
        // prev_log_index); saving a snapshot trims the log.
        // 2026-11-15: v0.2.3 (27b2b22, SONNY-6636, breaking) — still wal
        // v0.1.24; InProcessTransport copies an InstallSnapshot's data and
        // configuration (it read the freed chunk); a refused snapshot is
        // re-sent after 16, 32, 64 ... rounds (at most 256,
        // SNAPSHOT_RESEND_MAX_TICKS), not at the next round, and a
        // successful install resets the backoff.
        // 2026-11-16: v0.2.5 (SONNY-6652, SONNY-6653; v0.2.4 only moved wal to
        // v0.1.26 and otel to v0.1.29, routed to geode's wal in build.zig) --
        // InstallSnapshotResponse gains last_index / next_offset: a follower
        // acknowledges a snapshot it already holds, and reports the offset to
        // resume at after a lost chunk instead of refusing the rest; staged
        // snapshot save (snapshotPoint / Storage.stageSnapshot off the lock,
        // commitSnapshot under it); Config.stream_snapshots hands sends to
        // the consumer (Ready.snapshot_sends, streamSnapshot); FileStorage
        // commits a snapshot's data before its metadata.
        // 2026-11-16: v0.2.6 (SONNY-6666) -- Config.stage_received_snapshots:
        // a follower writes each InstallSnapshot chunk to a staged file
        // (Ready.staged_snapshot; Storage.syncStagedSnapshot off the lock,
        // advancePersist() commits it with renames; with FileStorage
        // Ready.snapshot then carries metadata only); stepping the node
        // between ready() and advancePersist() is safe (every Ready owns
        // copies of its committed entries); RaftNode.init reads only the
        // snapshot's metadata.
        .raft = .{
            // 2026-11-18: v0.2.7 (59fe60a, SONNY-6630) — re-released on otel v0.1.30
            // / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/raft.git?ref=v0.2.7#59fe60ad298c17ab544a38053cb8ff31c33922d9",
            .hash = "raft-0.2.7-PqJyvlfYCwBeWqfg8yCK_Uy5dOI56sxT1V3jpWSpaCBa",
        },

        // =======================================================================
        // Phase 7: Extracted Domain Libraries
