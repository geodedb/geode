            .hash = "hnsw-0.1.4-wYzBy6mBAQCqfVCG6pA_HVHSrM-O88XzjazgGEKtRaUX",
        },

        // R-tree - Spatial index with bounding-box search
        .rtree = .{
            .url = "git+https://gitlab.com/devnw/zig/rtree.git?ref=v0.1.5#6cdcb2b1ebc61d7b7811f78d66e35d88bb48d73e",
            .hash = "rtree-0.1.4-kIpcH2yYAQC1yAg72bBdI9ayOKM5ENyqnr_OmxIh69UK",
