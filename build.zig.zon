.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.1.4",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.16.0",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#d9bc1f9f6fafc58cd0aea7ff4826d775f5c0f4db",
            .hash = "uri-0.1.0-zVvOsYtkAgAfqsg2EJGWFAyE1CScnxR2dk-3LinmtLwZ",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git#315ffc641200825ae522e3963ffeff8deb9dd189",
            .hash = "yaml-0.1.1-lcW-hHyjBABKD4wQNN7MBYLC_8St6_sONAzYYvhRpZqb",
        },

        // TOML v1.1.0 parser
        .toml = .{
            // Bumped to v0.2.0 in lockstep with config (2026-04-28). toml v0.2.0
            // changed Value.array to a raw ArrayList (dropped .items.len indirection).
            // config was bumped simultaneously (402bc274) to track the new API.
            // If reverting, revert both toml and config together.
            .url = "git+https://gitlab.com/devnw/zig/toml.git#3c914b1908a3bdcd2ee8c8b534eb3ef197588e09",
            .hash = "toml-0.2.0-MHnSh4OWBQBfS7-MITFOKv6lojQlI07ieXSR0mvyYHx_",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#6d5fcf63521596861b827dbd0e1be8e576f1e671",
            .hash = "strings-0.1.0-adMOtWtxJgAqW3HU7vOh-VDxVkDNmS7V6ns8qJQfonwW",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            .url = "git+https://gitlab.com/devnw/zig/repl.git#3e04c2604edd551852a339359679f57a9ba2b75d",
            .hash = "repl-0.1.0-gwF1T5P0BQC0Wa03SuIVPmYeVDP3JNuOqF3hy2mtln0Y",
        },

        // Vulkan compute library
        .vulkan = .{
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git#ba4eef9843dba8a4269736d58ea46a522acaefaf",
            .hash = "vulkan-0.1.0-zh1htbcDEgAMh8npElUuOVC6bv_SWEz-45Nz79Cw2yyj",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#1cc10b77e648fdacd1a185c59de390cad92ce84d",
            .hash = "json-0.1.0-tOue4cGpCwCANP-tUb193snfTKWV0NLdcVb4_Bz-d83e",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-04-28 (later): bump to 4b246b2 — sendHandshakePackets
        // now drives the TLS state machine via pollCrypto BEFORE checking
        // hs_tx_keys.  Fixes a benign race that capped concurrent client
        // fan-out at c=4: under msft-graph --workers 16, the keys check
        // raced the install callback and lost on 12 of 16 connections,
        // leaving them in TLS-incomplete state and stalling the seed at
        // flushed=281 with quic_active_connections=4.  Reordering lets
        // pollCrypto fire the install callback before the check.
        // Earlier 2026-04-28: v0.1.14 (67720c1) — coalesce server
        // Initial+Handshake into a 1200-byte datagram, exact varint Length
        // projection for coalesced datagram pad, TLS bumped to 7d9efd3.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#c42657d97aee213f530e26cc68c553db3bfdbe46",
            .hash = "quic-0.1.14-gBIqUQ3AOACbHux60u1GqaCDu7H1ky556uc6wNLGVUPr",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#97593b9f4e48322eb45b1899afaa63f9bf369bc0",
            .hash = "slog-0.1.0-SamEDz-uBgB_90dznNlaUGl6bd7dd8W7S4jH-mXI07Af",
        },

        // OpenTelemetry client library — metrics, tracing, logs surface.
        // Pinned commit 20078af2 (2026-04-28). Intended for production use:
        // /metrics (rendered via otel.exporters.prometheus) and OTLP/HTTP push.
        // Build flags `use_devnw_grpc`, `use_devnw_protobuf`, `use_devnw_pool`
        // are LEFT DEFAULT-OFF — turning them on pulls otel's pinned versions
        // of grpc_zig / protobuf / thread_pool into the module graph and
        // collides with geode's own pins (Zig 0.16 forbids overlapping
        // module paths). OTLP/HTTP transport works on stdlib std.http.Client
        // alone; gRPC OTLP is gated on resolving the pin conflict.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#ee492166dfefc7914229979c933411e6da9e504e",
            .hash = "otel-0.1.0-B0v3lr2UMwA5qFJCa20OT-1huDPLm1sTIFD22PQBADDD",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#402bc274f293fd64191b3c9ab5f5d26c6cf416c6",
            .hash = "config-0.1.0-TiLumvdgCgAk1UDzQfr5x2lB_jvLmqyT4vtV2445Qr-z",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git#454d8eca2e03714ae8e83577240565950dcc4748",
            .hash = "cli-0.1.1-0aso9FDBBgABWC1Ez9P0U56N-70Wuq93QY9x126sCFK7",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#d21a9bf850f494f97721a8385124ec0d37dd302f",
            .hash = "dns-0.1.0-x4U-zQE4EQDjcYemckjTGpYoH9ZsoSnJSzU9IJXj084B",
        },

        // Thread Pool - Bounded, lock-free thread pool with work-stealing
        .thread_pool = .{
            // Bumped to v0.2.1 (2026-04-28) — builds successfully with quic 0.1.14
            // pinned at 4b246b2. The old "file exists in modules" conflict was
            // triggered by newer quic/grpc_zig/mcp/etc. that pull a different
            // thread_pool version transitively; those deps remain pinned. If
            // bumping those deps in future, verify no overlapping module paths.
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#1674ebbeb0eed7107e6e488cc9fd7b97a8036966",
            .hash = "thread_pool-0.2.1-11B1BqycdgAPt02YXm95pvBtazxHeJlzMBIUHZ0yTzSa",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git#76ca755bd11d2e4fdacc87ed8f4a47d0a9809923",
            .hash = "mcp-0.1.0-exAeBEKjBQBQjQ7wGOz5fh8f2MHuWw-dYHfZ3vYOAhdr",
        },

        // Protocol Buffers - Zig 0.15.2 compatible
        .protobuf = .{
            .url = "git+https://gitlab.com/devnw/zig/protobuf.git#925d0896b49b26c141727baddfb862d8f88866f4",
            .hash = "protobuf-3.0.0-0e82atImKgC12aCCoaGNPjzHK71iseW701-R1PDlskhe",
        },

        // gRPC for Zig
        // Updated 2026-02-11: concurrent connections, HPACK Huffman, TLS errdefer
        // GAP-0443: Use git+https URL with full commit hash for supply chain auditability
        .grpc_zig = .{
            .url = "git+https://gitlab.com/devnw/zig/grpc-zig.git#1775cc78aed2eb76032d6127b4fea5fa04302927",
            .hash = "grpc_zig-0.1.0-7FnvpPSQBAA4Zy82lVlAlkoeUV2QnorS8S2SnikRq2Ci",
        },
        .geode_client_zig = .{
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git#a06d520a745cde5c393286fbf5099ea9c63a605f",
            .hash = "geode_client_zig-0.2.1-8ysbV7QQCQDhVKyMC7gPITMWRFjtN5C1kCXIQBXfsOt-",
        },

        // =======================================================================
        // Phase 6: Extracted Core Libraries
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7, injectable generator
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#a91e1f832056473860565c10affbe7fac92e4d4a",
            .hash = "uuid-0.1.0-tL1irrA0GADY2e0kOBcNmyil_J5z-4ZGZc1D4u5qPb3G",
        },

        // WAL - Generic, payload-agnostic Write-Ahead Log with AES-256-GCM encryption
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git#09cd440d11e0739ab7e3998fa609833a40df9b47",
            .hash = "wal-0.1.0-EqPqpjs7BAB-dsQiJttXHtTuWcMaR8qSsUXfsoSKqCWu",
        },

        // Page-based graph storage engine
        // Updated 2026-04-24: ShardedGraphEngine with N=16 single-threaded shards,
        // per-shard WAL/manifest, 2PC cross-shard edges, parallel per-shard crash
        // recovery. Microbench verified ≥4× throughput vs single-engine at 16 cores.
        // See docs/superpowers/specs/2026-04-24-sharded-graph-engine-design.md
        // in the graph-storage repo.
        .graph_storage = .{
            .url = "git+https://gitlab.com/devnw/zig/graph-storage.git#5ead31bc3204f117c24bbdffcbb280a545007be7",
            .hash = "graph_storage-0.2.0-9UyJS6hCDQD37eSPpiDtHllpD4uyZ-kuTlrRCa2J0q28",
        },

        // Raft - Full Raft consensus with pre-vote, joint consensus, snapshotting
        .raft = .{
            .url = "git+https://gitlab.com/devnw/zig/raft.git#320c9da917a481a87d49793e13aa647e3ee96c9b",
            .hash = "raft-0.1.0-PqJyvuplBAAvTOTGEv5-m3LF9Y2Q-ieg4UmObVFQ7TFh",
        },

        // =======================================================================
        // Phase 7: Extracted Domain Libraries
        // =======================================================================

        // Audit - Event modeling, filtering, CEF formatting, syslog/file sinks
        .audit = .{
            .url = "git+https://gitlab.com/devnw/zig/audit.git#79cd1256b21a838757b4242d38557e77b01d8b93",
            .hash = "audit-0.1.0-J9TtCKFCAwDpoiu7P8KZE9LR6_d4_7ko2HTIPcbBkcz6",
        },

        // HNSW - Approximate nearest-neighbor index with configurable distance metrics
        .hnsw = .{
            .url = "git+https://gitlab.com/devnw/zig/hnsw.git#4e9ce5fa659f5af6af7f2f8ab71ee7fa48a5a622",
            .hash = "hnsw-0.1.0-wYzBy1kjAQCxJMClGp7TVmlkchtxfAkpqlfwbpfRmxFo",
        },

        // R-tree - Spatial index with bounding-box search
        .rtree = .{
            .url = "git+https://gitlab.com/devnw/zig/rtree.git#a898999adb9ccb920a14aa833894824be868ad2a",
            .hash = "rtree-0.1.0-kIpcH3IqAQBbQDOVaeqRQEqu7-1wbXTUwxVRxlkBp9M6",
        },

        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#7861b2ca7851fed5ba9fcf42750e41c070c81791",
            .hash = "advanced_types-0.1.0-pbHnCsviAgAwhdbQhsZ2h8mgMLmvHpWNNaQmptlbL55X",
        },

        // FLE - Field-level encryption with AEAD, HKDF, blind indices
        .fle = .{
            .url = "git+https://gitlab.com/devnw/zig/fle.git#75e904805d93b6a7a8ca3b226f35eee52e3b32f6",
            .hash = "fle-0.1.0-1CfwlUefAQCtHS4m20iyB1aiPLHB1y4bHIW6eTXV6nJM",
        },

        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#19f900656a549326e114da54f1ad7c8020f334b1",
            .hash = "gql-0.1.0-T1ANDSbyCAC9sJjmrQT1_juauzN83QIhkjJ8-SkFgV1O",
        },

        // Timeseries - Pattern matching, DTW, matrix profile, PELT change-point detection
        .timeseries = .{
            .url = "git+https://gitlab.com/devnw/zig/timeseries.git#52acf1611716a9408df9d93d535f3799dd590435",
            .hash = "timeseries-0.1.0-iAEwOmpdBACERCDmdEmBzWM1wUsehzKaZlVOeePh4GOB",
        },

        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#ff44150a28f885314d5ac9e54e18777b55196c5a",
            .hash = "auth-0.1.0-W76ZZ3UBAQAAYOL9rx0rk9bQ0sTr63ZPLjbPu6yN3xWM",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "benchmarks",
        "tools",
        "geodetestlab",
    },
}
