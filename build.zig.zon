.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.1.4",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.15.1",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#2b27b53d64d67d92439282aa35cc3bc2a96c0674",
            .hash = "uri-0.1.0-zVvOscCwAQDMv-46SmW70_KEIx_UKYuIm4FEoRW7_7kK",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git#1bf4078eecdf5638de07728d02784040296c801b",
            .hash = "yaml-0.1.1-lcW-hHGjBAAr_oVfe9ueg4aWt1P70CU1g_LdRBphzxlg",
        },

        // TOML v1.1.0 parser
        .toml = .{
            .url = "git+https://gitlab.com/devnw/zig/toml.git#325dd0a65249458ecf4ecf6746bde0aa8be17e28",
            .hash = "toml-0.1.0-MHnSh64vAgAjI7CtbKkA7megV9k-TcduiLmxmF2nJNrq",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
