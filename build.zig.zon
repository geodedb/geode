            .hash = "timeseries-0.1.11-iAEwOkw4BgDOlmPVE4rn9LqNhTDnbcrPoxYVfQ9sfw2X",
        },

        .timeseries_storage = .{
            // 2026-07-13: v0.2.10 — carries the thread_pool v0.2.7 lockstep pin
            // (popMany stalled-producer livelock fix) plus accumulated main.
            .url = "git+https://gitlab.com/devnw/zig/timeseries-storage.git?ref=v0.2.10#ad19c0e4846bfcc8d7506f3be076f11bfdf0e42d",
            .hash = "timeseries_storage-0.2.10-5wzBJN_lEwDMkTav7Tk9NTTKbSoAc37j6Ehlr_DERpyX",
