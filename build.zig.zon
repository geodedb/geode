.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.8.25",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.16.0",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git?ref=v0.1.17#5dcd7d203ad3b81de01a31c28e8c396f45c6b50e",
            .hash = "uri-0.1.17-zVvOseOkAgC_LhhYsTrPtJvjRDPzhvL4hJLoEDA2XwdW",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git?ref=v0.1.11#080ce41549f85714e50c297676dcd5bdb276c188",
            .hash = "yaml-0.1.11-lcW-hJ8sCABoerFNWFrCnSXOfs4QuKgOmp064Qu7yfsv",
        },

        // TOML v1.1.0 parser
        .toml = .{
            // Bumped to v0.2.0 in lockstep with config (2026-04-28). toml v0.2.0
            // changed Value.array to a raw ArrayList (dropped .items.len indirection).
            // config was bumped simultaneously (402bc274) to track the new API.
            // If reverting, revert both toml and config together.
            .url = "git+https://gitlab.com/devnw/zig/toml.git?ref=v0.1.16#204bdeec0e88caaeb23876ab9746b31a6f633711",
            .hash = "toml-0.1.16-MHnShwN5GQBYxI1w_gSsmUnNFOSD01kD32H2auSV9yM0",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            // 2026-11-18: v0.1.7 (c43105f, SONNY-6630) — re-released on otel v0.1.30
            // / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/strings.git?ref=v0.1.7#c43105f1b847aeecc081279675482599f17bd3a9",
            .hash = "strings-0.1.7-adMOtbcoYwAaTh4bv0HI7C53-uDwzrQQBQyJmpCNLltw",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            // 2026-11-18: v0.1.23 (653c909, SONNY-6630) — re-released on otel
            // v0.1.30 / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/repl.git?ref=v0.1.23#653c909b226529322966ef60ca84d190d8cd99a5",
            .hash = "repl-0.1.23-gwF1T1whCAABOf0oN0iLrRORxNMcxxmPqcdPtgmIfBKn",
        },

        // Vulkan compute library
        .vulkan = .{
            // 2026-11-18: v0.1.21 (e66fdf2, SONNY-6630) — re-released on otel
            // v0.1.30 / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git?ref=v0.1.21#e66fdf2713d86ef521931bcc823bab051a4978af",
            .hash = "vulkan-0.1.21-zh1htbQPEgDeCI0DerJkJR5-ZRLXQXEEHGxATENCvk8D",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git?ref=v0.1.21#a73791a1fe2365949db02ba7eb5a4fb91fdd7f69",
            .hash = "json-0.1.21-tOue4YaW6ACrNXeY2rLSDiON1ZH5jRpB_riq5dqzbKyP",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-04-30: bump to 1226ece — fix(quic): use full peer SCID
        // for standalone ECN-ACK packet routing.  Closes the long-response
        // stream stall (BUG_LONG_RESPONSE_STREAM_STALL.md): once the receiver's
        // ECN flag fired, every standalone ACK packet was emitted with a
        // 4-byte DCID that did not match the peer's full 8-byte our_scid, so
        // localDcidMatchLen rejected the packet and the sender's recovery
        // layer never advanced largest_acked.  cwnd stayed pinned at the
        // initial 10×MDS value and bytes_in_flight >= cwnd blocked every
        // subsequent writeStream.  The Geode integration repro was MATCH+
        // RETURN over >550 multi-column rows; setup batches in
        // gap_0257 went from timing-out at 30 s to all green after this bump.
        // Earlier 2026-04-28 (later): bump to 4b246b2 — sendHandshakePackets
        // now drives the TLS state machine via pollCrypto BEFORE checking
        // hs_tx_keys.  Fixes a benign race that capped concurrent client
        // fan-out at c=4: under msft-graph --workers 16, the keys check
        // raced the install callback and lost on 12 of 16 connections,
        // leaving them in TLS-incomplete state and stalling the seed at
        // flushed=281 with quic_active_connections=4.  Reordering lets
        // pollCrypto fire the install callback before the check.
        // Earlier 2026-04-28: v0.1.14 (67720c1) — coalesce server
        // Initial+Handshake into a 1200-byte datagram, exact varint Length
        // projection for coalesced datagram pad, TLS bumped to 7d9efd3.
        .quic = .{
            // Bumped 2026-04-30 to 49f59f7 — fix(handshake): defer + retry
            // sendHandshakePackets on NoHandshakeKeys. Server-side fix
            // for the host-haleth bug-triager finding
            //   ERROR: processInitial: sendHandshakePackets failed: NoHandshakeKeys
            // Pre-fix processInitial logged-and-dropped on a single
            // first-tick race; under msft-graph --workers 16 fan-in 12
            // of 16 connections never reached the accept queue and
            // stalled past the QUIC idle timeout. Post-fix processInitial
            // sets conn.pending_hs_send and the endpoint poll loop's
            // Phase 4.5 drain retries the flush every tick until the
            // TLS engine derives hs_tx_keys.
            //
            // 2026-05-02 — macOS cross-compile fix vendored as a patch.
            // Upstream `b73a804` adds `fcntlCmd(comptime tag)` to handle
            // the per-OS `std.c.F` shape divergence and rewrites
            // posixSendTo/posixRecvFrom against `std.c.{sendto,recvfrom}`
            // (Zig 0.16 dropped `std.posix.{sendto,recvfrom}`). Bumping
            // the pin to b73a804 directly trips a Zig 0.16 module-dedup
            // diamond ("file exists in modules 'build_options13' and
            // 'build_options0'") even though the upstream content-tree is
            // otherwise identical to 49f59f7. The fix is therefore
            // overlaid via `scripts/apply-vendored-patches.sh` (wired
            // into `.goreleaser.yaml` `before:hooks` and the Makefile
            // `cross-macos-{x86_64,arm64}` targets). Sunset the patch
            // and bump to b73a804+ once the sibling-pin convergence
            // resolves the diamond.
            // 2026-05-27: pin to the post-v0.1.21 upstream commit so the quic
            // lib includes the high-concurrency route-cache, poll-budget,
            // accepted-queue, diagnostic gating, Zig 0.16 tool fixes, and the
            // aligned tls/thread_pool graph used by Geode.
            // 2026-05-28: picks up tx-credit wakes for Initial/Handshake ACKs
            // and explicit tx_credit_generation init for allocator-created
            // connections, avoiding HELLO fan-out write stalls.
            // 2026-05-28: also keeps the trusted-localhost cwnd bypass used by
            // high-fanout loopback integration tests while preserving the
            // normal congestion gate for remote peers.
            // 2026-05-28: serializes QUIC's legacy sent-packet maps so
            // concurrent poll workers cannot race PTO accounting on one
            // connection.
            // 2026-05-28: serializes PTO dirty recompute on conn.mu so endpoint
            // timer arming cannot race high-parallel STREAM response writes.
            // 2026-05-28: retransmits retained app STREAM data when recovery
            // compacts time-threshold lost packets before app retx queries.
            // 2026-05-28: rearms app PTO after send failures so retained
            // STREAM responses do not strand high-concurrency clients.
            // 2026-05-28: adds gated short-header drop diagnostics used to
            // isolate missing first post-handshake requests under fan-out.
            // 2026-05-28: keeps port-0 client UDP binds unique under fan-out and
            // fixes sendmmsg peer storage so batched paced sends cannot target
            // the wrong client socket.
            // 2026-05-28: serializes per-connection TLS Context access so
            // concurrent poll workers cannot race pollCrypto ownership drains.
            // 2026-05-28: increases server-side receive drain budget so
            // synchronized request bursts do not strand STREAM retransmits in PTO.
            // 2026-05-28: sheds contended server ACK-frame work while preserving
            // immediate app-stream flow-control feedback.
            // 2026-05-28: restores the proven wider server short-header drain
            // after rejecting one-batch, two-batch, and packet-shedding variants.
            // 2026-05-29: defers the first server-side STREAM-only standalone
            // ACK so request/response traffic can piggyback ACKs on response
            // packets, with AppAckDelay preserving max_ack_delay for quiet peers.
            // 2026-05-29: restores the proven four-batch server drain after
            // short-header wall-clock yield experiments regressed Geode's
            // accepted 4096 single-op gate.
            // 2026-05-29: pins the upstream-main revert of the slow-batch
            // short-header cadence experiment after it regressed Geode's
            // accepted 4096 single-op gate. Content is equivalent to the
            // proven 108d06d four-batch receive behavior.
            // 2026-05-29: pins REQ-QUIC-HC-168, which routes generic and
            // coalesced long-header dispatch through the same per-connection
            // TLS serializer as the optimized burst receive path.
            // 2026-05-29: pins a1858c1, reverting the rejected
            // REQ-QUIC-HC-177 busy-connection shedding experiment after it
            // regressed Geode's 2048x8 mixed workload.
            // 2026-06-14: v0.1.27 — fix(endpoint): batch connection teardown.
            // api.destroyBatch frees a churn backlog in ONE O(N+keys) map sweep
            // instead of O(backlog×N) per-conn scans under ep.mu (acceptor-wedge:
            // long ep.mu hold starved poll workers → UDP rx_queue backed up →
            // AppendEntries dropped → stranded candidate). See
            // docs/bugs/2026-06-03-acceptor-wedge-connection-burst-new-conns-refused.md.
            // Bumped 2026-06-14 to v0.1.28 (8ed9425) — acceptor-wedge RC-A: the
            // per-poll socket-DRAIN cap is decoupled from the Initial PROCESSING
            // budget so a reconnect storm's surplus Initials are cheaply shed and
            // the kernel UDP rx_queue stays bounded (the destroyBatch teardown fix
            // alone did not bound rx-queue growth). Tunable via GEODE_QUIC_DRAIN_PACKETS.
            // Bumped 2026-06-15 to v0.1.29 (69d5363) — RC-A iteration 2: v0.1.28's
            // drain cap was still gated behind the 256-Initial ep.mu-serialized
            // PROCESSING budget (16 workers all blocked on ep.mu → none draining),
            // so the k8s rx_queue still wedged at ~11.4 MB. Drop the Initial
            // processing budget to one UDP batch (64) + raise the drain cap to
            // empty a full 16 MiB SO_RCVBUF per cycle, so the lock-free shed-drain
            // engages immediately and the rx_queue is actually bounded. Initial
            // budget tunable via GEODE_QUIC_INITIAL_BUDGET.
            // 2026-06-15: v0.1.30 — RC-C (it.3): wire the dead/churned-connection
            // reaper (idle close + same-peer stale close). Server-side opt-in via
            // dead_conn_reap_ms (OFF by default; the raft listener opts in at 30s),
            // so client behaviour is unchanged. The raft server reaps a churned
            // peer's stale INBOUND connection (the ~12-min proto_reader stall) so
            // the replacement pod can re-handshake. NOTE: the v0.1.30 tag commit
            // (245ecae) predated its own .version bump, so its content hash was
            // labelled 0.1.29 — pinned by commit, reproducible, lockstep with
            // geode-client-zig.
            // 2026-06-17: bump to v0.1.31 (02cee4a) — GAP-0900 lever (a): eliminate
            // the per-poll 256 KiB memset in endpoint.pollWithStats (stack
            // `= undefined` is 0xAA-filled every call in ReleaseSafe across 16
            // poll threads). Moved the receive scratch to threadlocal static.
            // Validated: compiler_rt.memset 44%→17.7% of CPU, +14.8% poll-bound
            // RETURN 1 throughput, correctness verified, quic `zig build test` green.
            // .version now tracks the tag (0.1.31).
            // 2026-07-13: v0.1.38 — pin-only release aligning quic's
            // thread_pool to v0.2.7 (popMany stalled-producer livelock fix)
            // in lockstep with geode + timeseries-storage.
            // Includes main's v0.1.47 lost-STREAM retransmission fix (3ca1e9f), plus
            // portable entropy, clocks, sleep, and checked nonblocking POSIX sockets.
            // Native macOS transport and current-main paired UDP gate passed.
            // 2026-10-26: serialize FIN, RESET_STREAM and STOP_SENDING with
            // stream mutations. QUIC !51 and its main pipeline passed all checks.
            // 2026-11-13: v0.1.49 (f4ea768, SONNY-6434) — ACK processing and
            // STREAM loss recovery do bounded work per packet: retransmit
            // entries are kept in packet-number order, an ACK frame's ranges
            // reach recovery whole (no 256-PN enumeration cap), at most two
            // lost packets are retransmitted per ACK oldest first, and a failed
            // send leaves the entry tracked. Fixes the remote-backup stall at
            // 11-14 MB (SONNY-6430 item 1, test-sonny6430-remote-backup-large).
            // Lockstep with geode-client-zig v0.3.14 (one quic module).
            // 2026-11-13: v0.1.50 (b2f1bf1, SONNY-6457) — adds
            // `QuicConfig.inline_client_ca_der`, passed to the server TLS
            // context as `trusted_ca_der`, so a server completes a client
            // chain from the configured client CAs (a CA-issued leaf sent
            // alone is accepted). Pins tls v0.1.27 (RFC 8446 exporter, client
            // chain completion, HKDF-Expand-Label fix). Lockstep with
            // geode-client-zig v0.3.15 (one quic module).
            // 2026-11-13: v0.1.51 (79cb495, SONNY-6478) — finished streams are
            // retired (RFC 9000 section 3) and acknowledged STREAM data is no
            // longer resent, so a long-lived connection stays flat instead of
            // slowing down per request and sending when idle; also the
            // large-transfer reassembly, final-size and control-frame
            // retransmission fixes, and the failed-connect use-after-free.
            // Same tls v0.1.27. Lockstep with geode-client-zig v0.3.16 (one
            // quic module).
            // 2026-11-17: v0.1.55 (0f52e64, SONNY-6522, 6649, 6654, 6655, 6673) —
            // key-update desync, handshake RTT sample and exclusive UDP binds
            // (0.1.52); packet-number length, coalesced STREAM retransmission and
            // no reused packet numbers (0.1.53/0.1.54); ACK ranges read from the
            // decoded frame and writer/ACK lock fairness (0.1.55). tls v0.1.28,
            // thread-pool v0.2.11; its lazy otel is still v0.1.28. Lockstep with
            // geode-client-zig v0.3.20 (one quic module).
            // 2026-11-18: v0.1.56 (54491db, SONNY-6630) — otel v0.1.30 (lazy), so
            // one otel/thread-pool tree; no transport change (test-only fixes since
            // v0.1.55). Lockstep with geode-client-zig v0.3.21 (one quic module).
            // 2026-11-18: v0.1.57 (7bdc807, SONNY-6737) — after a partial sendBatch
            // every paced datagram is sent exactly once (none freed unsent, none
            // sent twice). Same otel v0.1.30 tree. Lockstep with geode-client-zig
            // v0.3.21 (one quic module).
            .url = "git+https://gitlab.com/devnw/zig/quic.git?ref=v0.1.57#7bdc8073bde250d6371d1fdc3808cd1363647f7e",
            .hash = "quic-0.1.57-gBIqUQ2LRwBumm60rOnTJEjPv06fMFO2EwpPw0MrnufD",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git?ref=v0.1.16#b525a9e1784be2bc9d1c61da724deae84b514310",
            .hash = "slog-0.1.16-SamED1H5BwCeK8xauLkBgS6gCBEgN6wWnhSLWW2tbPZy",
        },

        // OpenTelemetry client library - metrics, tracing, logs surface.
        // 2026-05-27: aligned with the converged devnw/zig graph so direct
        // and transitive consumers resolve a single otel module instance.
        // Build flags `use_devnw_grpc`, `use_devnw_protobuf`, `use_devnw_pool`
        // remain default-off unless the whole telemetry stack is verified
        // together. `otel_use_devnw_tls` IS enabled by geode (build.zig) so the
        // std.http.Client OTLP transport is compiled in.
        //
        // NOTE (2026-05-29): a BatchSpanProcessor span-reuse UAF (non-atomic
        // SpanState.ended → double-enqueue/double-recycle under concurrent
        // double-end) is fixed on otel branch `fix/bsp-span-reuse-uaf`
        // (9fa2e97af5f9ee527db20dcf09847a0589cdd6df, atomic end-claim). It is
        // NOT pinned here: bumping otel forces a ~18-lib ecosystem convergence
        // (all sibling libs declare otel@455ad2b8 for their hardcoded-off
        // observability seam — see detect_diamond_deps). Geode instead enforces
        // exactly-once span end() at its own facade (src/monitoring/otel_metrics
        // span wrapper), which prevents the double-end that triggers the UAF.
        // Pin to 9fa2e97 (or descendant) at the next ecosystem-wide otel
        // convergence. See docs/superpowers/plans/2026-05-29-otel-full-instrumentation-program.md.
        .otel = .{
            // 2026-11-17: v0.1.29 (3cdcb91, SONNY-6630) — slog, json, config, yaml,
            // metrics and tls pins carry thread-pool v0.2.11; raft v0.2.6 and wal
            // v0.1.26 pin it.
            // 2026-11-18: v0.1.30 (dbf58ba, SONNY-6630) — re-released on otel
            // v0.1.30 / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.30#dbf58bae612ef3f5f78c62c130b4c6d63f5aa297",
            .hash = "otel-0.1.30-B0v3lrGuNQDL0D3_KAb6qK6MaYmz2QeutCp0Sg3SL1H7",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git?ref=v0.1.19#25a1eba6d04340ec2b9a6f8efd22bec9d488c6ef",
            .hash = "config-0.1.19-TiLumvqyDABNujdbGvFqsIj3aAt7LdDphgGhqdU31Y3q",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            // 2026-11-18: v0.1.15 (a0ca22c, SONNY-6630) — re-released on otel
            // v0.1.30 / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/cli.git?ref=v0.1.15#a0ca22c4ac03918ded371a3c3ce9a66b2f22100d",
            .hash = "cli-0.1.15-0aso9JFHCwDTP9dzHsBA9zlowbJN0aPugKesm_vjjOMP",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        // 2026-11-13: v0.1.28 (3c0a560, SONNY-6447) — Address.eql no longer
        // panics: it sized both addresses by family (getOsSockLen) and a
        // receive's source address left unwritten (undefined) had none. It now
        // compares by family, and the receive paths zero the source address.
        // Lockstep with audit v0.1.24, which pins the same dns, and with
        // geode-client-zig v0.3.18 (2026-11-15; v0.3.17 pinned dns v0.1.27).
        .dns = .{
            // 2026-11-18: v0.1.29 (3c184d3, SONNY-6630) — re-released on otel
            // v0.1.30 / thread-pool v0.2.11 (one dependency tree).
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.29#3c184d3678ee8709f47a7f5ec58cba17376dc5d7",
            .hash = "dns-0.1.29-x4U-zSeCGACiftNR0oJoHugYo1ElseP7po9H8LkiXyNO",
        },

        // Thread Pool - Bounded, lock-free thread pool with work-stealing
        .thread_pool = .{
            // 2026-05-27: pin to 39528a3 for the WaitGroup completion-broadcast
            // lifetime fix used by Geode's QUIC bounded parallel facade. This
            // must stay aligned with quic and the lazy telemetry graph.
            // 2026-07-13: thread-pool v0.2.7 (54a2ddd) carries the
            // BoundedRing.popMany check-then-reserve fix — consumers no longer
            // spin unbounded on a mid-push (preempted) producer. That spin
            // livelocks CPU-throttled CI runners and is the prime suspect for
            // the silent 6h test-shard hangs (unit/release-safe shard [6]/[7]
            // job_execution_timeout, e.g. pipeline #2670033275). LOCKSTEP:
            // quic and timeseries-storage type-share *ThreadPool with geode
            // (src/timeseries/timeseries.zig passes the pool into
            // timeseries-storage), so this round bumps all three together:
            // thread_pool v0.2.7 + quic v0.1.38 + timeseries-storage v0.2.10
            // (each pin-aligned to the same thread_pool hash). A partial bump
            // fails with "expected '*pool.ThreadPool', found '*pool.ThreadPool'".
            // 2026-11-12 (SONNY-6375): thread-pool v0.2.10 fixes the LocalQueue
            // dispatch, finalizeTask and scratch-counter data races. The
            // lockstep partner is timeseries-storage only (v0.2.19); quic no
            // longer type-shares the pool (build.zig passes `.thread_pool =
            // false` to quic). graph-storage v0.4.11 moves with it because it
            // runs its own pools from its own thread_pool copy.
            // 2026-11-13: v0.2.11 (666b7ac, SONNY-6479) — a submit wakes a
            // parked worker whenever one is parked (no longer only every
            // `wake_coalesce_batch`-th submit), default-lane work wakes the
            // parked blocking-lane helper, and the lane helper takes one task
            // at a time. Fixes SONNY-2440 in the library; geode's
            // `wake_coalesce_batch = 1` workaround is dropped.
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.11#666b7ac0cc8b92d5773df5e79ea4fd421bd77e99",
            .hash = "thread_pool-0.2.11-11B1Bk2GegC5mn18xNrkmF0lMrgrWqijO7PXmftrkuSe",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        // 2026-11-14: v0.1.22 (eb9da27, SONNY-6531) frees the result of EVERY
        // handler callback with the allocator given to Server.init (v0.1.12 to
        // v0.1.21 freed only tools/call, so every resources/read response
        // leaked for the life of `geode mcp`), and the JSON it stringifies for
        // prompts/get arguments and completion/complete params. Every geode
        // handler (src/mcp/server.zig) therefore returns allocator-owned bytes,
        // never a literal. Same json/thread_pool/otel pins as v0.1.21. See
        // docs/MCP_SERVER.md.
        // 2026-11-15: v0.1.23 (472a64bb, SONNY-6585): ToolNotFound and
        // PromptNotFound answer -32602 (were -32002, the resource code);
        // a notification or a peer-cancelled request gets no reply; error
        // messages and string ids are JSON-escaped; mcp.setErrorDetail lets
        // a handler give the error message and data; a handler result that
        // is not exactly one JSON value is answered -32603; the built-in
        // "barrier" tool is gone. Same json/thread_pool/otel/fips pins.
        // 2026-11-16: v0.1.26 (c0c0178c, SONNY-6644): Streamable HTTP
        // sessions (initialize answers an Mcp-Session-Id every later request
        // must carry: 400 without, 404 unknown; per-client streams), a
        // thread per HTTP connection, full-body reads; v0.1.24/25: a client's
        // reply resolves a server request, duplicate in-flight ids are
        // -32600. createTask/getTask return copies (geode uses neither).
        // Same json/thread_pool/otel/fips pins.
        .mcp = .{
