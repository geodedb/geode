            .url = "git+https://gitlab.com/devnw/zig/toml.git#8b70e25a9513fe4526d239c2bc50dead2997f413",
            .hash = "toml-0.1.0-MHnSh8otAgBkuwTmIuInubh7mbZ8vic8oMYxZwvUnoqY",
