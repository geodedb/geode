.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.1.4",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.16.0",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#3d196fbf25a78b8c38d43fbc694d779dce1f5ce2",
            .hash = "uri-0.1.0-zVvOsTxgAgBybnD1lefeYXFLb1QreSi2lb-jh_mAman0",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git#f6172bf852fd90fffb80ddd16ccccff5b447e536",
            .hash = "yaml-0.1.1-lcW-hEOgBADDSnGhFpUHKTwcQP3-LeoK-gOTndFijljG",
        },

        // TOML v1.1.0 parser
        .toml = .{
            .url = "git+https://gitlab.com/devnw/zig/toml.git#13d32e1cc96c7b3c32e4fa107b6811d12bb873fb",
            .hash = "toml-0.1.0-MHnShxEvAgAJa1cG8LMs3FwEHZqy4DjazTdZ7-A6A1d6",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#6d60769ce1a1e736d3c34e6636e8f3656c2b4303",
            .hash = "strings-0.1.0-adMOtWtxJgBmixUJ-J2v3aegmy4iUIjxRTsJ4H73aVBA",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            .url = "git+https://gitlab.com/devnw/zig/repl.git#ea718c9ca4a2444be94fde3113965e9fbd17211f",
            .hash = "repl-0.1.0-gwF1T-6LBQDX_OEoEsJYxDM2S_hFL8Y1YVguEFWQA34D",
        },

        // Vulkan compute library
        .vulkan = .{
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git#4c7dbfab7ce3edfbcc78f45302074a17b0011ac9",
            .hash = "vulkan-0.1.0-zh1htXeEEQBovC-6fOr8r2aHv27l4E8JFd4-L4Wqy1MU",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#04dea9f1812ec04e948b1aa872d7ff3d57b5c624",
            .hash = "json-0.1.0-tOue4R6nCwAJqBxNrIjoVTG20N7h7OgQpjoXvXsIoT4t",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-03-27: v0.1.11+ (a979f59) — split endpoint mutex,
        // ACK data race fix, bytes_in_flight leak fix, narrow handshake locks.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#51c1a033b73e8f80305f8cccc7f792b42206931f",
            .hash = "quic-0.1.11-gBIqUUxlNgAHRJSmpRgg2LU_nq6vHgNYufwDZXZ2ikCh",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#35ffe3e93511fed269e1c93f3cf41dbb1c9086fa",
            .hash = "slog-0.1.0-SamEDyVLBgDkwoIb2TUuoKUhpkzm_EbjHT_oauBj6ABK",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#5ae76c9599bd1a4d4c9d5a0517260a546201cb92",
            .hash = "config-0.1.0-TiLummVcCgC2E0z8-TpYHqAEVFD4L3CYOLzWQQTZDrGg",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git#76d83dc6b1e4e1374d6bc9ad7e2e0323ec6eaad6",
            .hash = "cli-0.1.1-0aso9Gm9BgDV8XOtwDPWgooA3QJ1A84iOLW1j422jumJ",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#6bcb06754659ee0376d501061c74ba9b9854f0ba",
            .hash = "dns-0.1.0-x4U-zXfVEAAWKoQSTifznuPO_OdgE8Qp3CrZ4uvxe1tY",
        },

        // Thread Pool - Bounded, lock-free thread pool with work-stealing
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#56c109a355eb4316450a216a74cc619b7809183b",
            .hash = "thread_pool-0.2.0-11B1Bsw4RACrT8yj1Moe2s1sdiDixZE3LPlbj3xLYXDG",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git#07c958ffba9810ba8892be35cb2538d27e6c4715",
            .hash = "mcp-0.1.0-exAeBGF1BQDq-PTco8dk01OGx36rzYWmdUQE0w_ubWg-",
        },

        // Protocol Buffers - Zig 0.15.2 compatible
        .protobuf = .{
            .url = "git+https://gitlab.com/devnw/zig/protobuf.git#f18747d87010afc0517a0f0e40cb00fd352e4191",
            .hash = "protobuf-3.0.0-0e82akVdKQBR-5UyQkdGI2f9WiRtiENLEMw_nH7HusOd",
        },

        // gRPC for Zig
        // Updated 2026-02-11: concurrent connections, HPACK Huffman, TLS errdefer
        // GAP-0443: Use git+https URL with full commit hash for supply chain auditability
        .grpc_zig = .{
            .url = "git+https://gitlab.com/devnw/zig/grpc-zig.git#8c499c17662b2253e10c1e510e9c30ff407d26aa",
            .hash = "grpc_zig-0.1.0-7FnvpIu9AQAPZxjgM1lW4gKwyNqI6fR49tTCN7uWm3Yl",
        },
        .geode_client_zig = .{
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git#c4d678cce8dff27aff637c703899150aeed94124",
            .hash = "geode_client_zig-0.2.1-8ysbVw8QCQAQOzFcTrqi3pJVsnnNiNbxDFETThnPgaVo",
        },

        // =======================================================================
        // Phase 6: Extracted Core Libraries
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7, injectable generator
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#5af72b4815f5512633da8383e66b209d8d8d0754",
            .hash = "uuid-0.1.0-tL1irpURDADBWV1YTG1QwE-DCe7OftV4j54sJrQfa7db",
        },

        // WAL - Generic, payload-agnostic Write-Ahead Log with AES-256-GCM encryption
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git#05865e6111eda99ffc05f384417f9490a0bfd67e",
            .hash = "wal-0.1.0-EqPqpofJAwCTcTvn2mCVhPcBvtI_cZiSwVnwq8VuETle",
        },

        // Page-based graph storage engine
        // Updated 2026-04-07: audit closure plus iterator-backed scans, streamed
        // backup/recovery paths, bounded deserialization, persisted edge index,
        // and fail-closed integrity handling
        .graph_storage = .{
            .url = "git+https://gitlab.com/devnw/zig/graph-storage.git#51afaf3f0f2c6d1e444c92e63476794c9f997da6",
            .hash = "graph_storage-0.1.0-9UyJS32jCwBoL9xOI0xCqigRPvXVmT-bFJ07--yUalMa",
        },

        // Raft - Full Raft consensus with pre-vote, joint consensus, snapshotting
        .raft = .{
            .url = "git+https://gitlab.com/devnw/zig/raft.git#ea8fbbd4e48001a03af5eca49f8268c610e314ec",
            .hash = "raft-0.1.0-PqJyvkNCBACjoZFAj6zbFbS34oSK6-vWrefceScAmxxJ",
        },

        // =======================================================================
        // Phase 7: Extracted Domain Libraries
        // =======================================================================

        // Audit - Event modeling, filtering, CEF formatting, syslog/file sinks
        .audit = .{
            .url = "git+https://gitlab.com/devnw/zig/audit.git#dc0a0fc4d40e5d7843d8daaad9e01af19e3d06b4",
            .hash = "audit-0.1.0-J9TtCKFCAwAu9gBRRoROo1Gsh0J5h4UQmga-cqNZVXvz",
        },

        // HNSW - Approximate nearest-neighbor index with configurable distance metrics
        .hnsw = .{
            .url = "git+https://gitlab.com/devnw/zig/hnsw.git#f4d1bc0d2b204192464dffd37842a314bd61aa8a",
            .hash = "hnsw-0.1.0-wYzBy2UUAQBqri1sudz8-bBoa47n19B5ud9qPcRIihyT",
        },

        // R-tree - Spatial index with bounding-box search
        .rtree = .{
            .url = "git+https://gitlab.com/devnw/zig/rtree.git#24f5986527b46f983390277f5e02c38a8f7c2464",
            .hash = "rtree-0.1.0-kIpcH5waAQCaVsXM94KXn7lgOm0xlEUjevgrTP0lCNkZ",
        },

        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#d75714987f4689cc902590fe1ae45583ab864eb3",
            .hash = "advanced_types-0.1.0-pbHnCtw-AgDAdsufaeR7F6-jj8PERUbCIvO_O8zHX7VX",
        },

        // FLE - Field-level encryption with AEAD, HKDF, blind indices
        .fle = .{
            .url = "git+https://gitlab.com/devnw/zig/fle.git#1c9c076d0d87905490710e0aa0435f1f832b1a4f",
            .hash = "fle-0.1.0-1Cfwle1LAQDvA3IBVvKQ_IgMGymt4qqkn-UaqFwz7xg0",
        },

        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#c9145b8aae3a57eb3436a380f332deb60aea753c",
            .hash = "gql-0.1.0-T1ANDYqLCAAJHOhJBVqrV_KBvQwXsobgpLIGoiBRFqCV",
        },

        // Timeseries - Pattern matching, DTW, matrix profile, PELT change-point detection
        .timeseries = .{
            .url = "git+https://gitlab.com/devnw/zig/timeseries.git#90151db3aeeb8d9fcb15275d913edf2fb4989c3f",
            .hash = "timeseries-0.1.0-iAEwOirvAwBbqpZy47FtrG01_aU9H2gczYLJyCYjQDk1",
        },

        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#74a3afab57d6a286f5fb6ebd043a85987f8a0aa7",
            .hash = "auth-0.1.0-W76ZZ3UBAQAAYOL9rx0rk9bQ0sTr63ZPLjbPu6yN3xWM",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "benchmarks",
        "tools",
        "geodetestlab",
    },
}
