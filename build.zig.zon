.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.1.4",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.16.0",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#4b333e02b170022b7e724783702914ed24abafd8",
            .hash = "uri-0.1.0-zVvOsYtkAgA5xW6KzmyWVBhb9qWWJKp5jp-kJgmMNyh7",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git#d2151db9c6da63a71538d3118a5f064079facbf7",
            .hash = "yaml-0.1.1-lcW-hHyjBAB9Q8-Bm9ihxzMrOnvfa5T_h6fXJVmXZJvk",
        },

        // TOML v1.1.0 parser
        .toml = .{
            .url = "git+https://gitlab.com/devnw/zig/toml.git#535e23e893d2a402f7b63bf6d95b2e15b5ecc8e7",
            .hash = "toml-0.1.0-MHnSh18vAgDJpxCvZrTGhXaQ-ZYx-SJL-oJr1Tn0ZRWk",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#a4e0566cb73123c95a887e82da283858658e6f15",
            .hash = "strings-0.1.0-adMOtWtxJgD0_SKjaeHUaLKTbnogEUC8DJtXy6Qjb_uE",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            .url = "git+https://gitlab.com/devnw/zig/repl.git#6e8148454903c0bf2027c8f9fed6cea5a589a88d",
            .hash = "repl-0.1.0-gwF1T-6LBQDX_OEoEsJYxDM2S_hFL8Y1YVguEFWQA34D",
        },

        // Vulkan compute library
        .vulkan = .{
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git#9ea860f294e1b4d9175b97a4f6ae71c90a33300d",
            .hash = "vulkan-0.1.0-zh1htb-MEQBAfXIofxcILhxobM8EeA_B2x_9-KbK4kDs",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#30b3983dfaab83ebc827205567c32542e111616b",
            .hash = "json-0.1.0-tOue4cGpCwCGYhHHbM0EF6LxFTxPS2s9rcbKRD-o5xW7",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-03-27: v0.1.11+ (a979f59) — split endpoint mutex,
        // ACK data race fix, bytes_in_flight leak fix, narrow handshake locks.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#b88e3a46776450a11998bfce2ae283d34455a29e",
            .hash = "quic-0.1.11-gBIqUcqNNgAwvTY37dRYuK6iBYncB8YEHKmiTUX8eNRj",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#65e0792d4140a736fb1e04a7b1ee84c9333d58a9",
            .hash = "slog-0.1.0-SamEDyVLBgDLhCULhAYXGTkLtFFch_zMfAj8MRz2E3Cb",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#7eda77bda98f5bf48570f43ec292ec9219f71480",
            .hash = "config-0.1.0-TiLumu9gCgAHypciAx8sv9vlgG6b-BjAAjdtL47r3raM",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git#53dd108f8afd0774115e28ec708d10a6904e7309",
            .hash = "cli-0.1.1-0aso9FDBBgCM5276lsMjLcS18RsCQM7JASin-kqnUTvh",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#e5aaca3ebc71472c054fcebe6e7a3bc064c2ee82",
            .hash = "dns-0.1.0-x4U-zWXVEAAnOZ5ztklM3TtrW4-Sr5jklMM_mWdzWWQ9",
        },

        // Thread Pool - Bounded, lock-free thread pool with work-stealing
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#ee8440f69012cad49fa1d5f22fe18c68f944d9ab",
            .hash = "thread_pool-0.2.0-11B1Bj_edQCU0Y_-zzOoXuytAgqEkDkfuw2nB-YxUmEL",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git#76ca755bd11d2e4fdacc87ed8f4a47d0a9809923",
            .hash = "mcp-0.1.0-exAeBEKjBQBQjQ7wGOz5fh8f2MHuWw-dYHfZ3vYOAhdr",
        },

        // Protocol Buffers - Zig 0.15.2 compatible
        .protobuf = .{
            .url = "git+https://gitlab.com/devnw/zig/protobuf.git#f18747d87010afc0517a0f0e40cb00fd352e4191",
            .hash = "protobuf-3.0.0-0e82akVdKQBR-5UyQkdGI2f9WiRtiENLEMw_nH7HusOd",
        },

        // gRPC for Zig
        // Updated 2026-02-11: concurrent connections, HPACK Huffman, TLS errdefer
        // GAP-0443: Use git+https URL with full commit hash for supply chain auditability
        .grpc_zig = .{
            .url = "git+https://gitlab.com/devnw/zig/grpc-zig.git#78d5f40a5264b993f35911cd232c3851407a0990",
            .hash = "grpc_zig-0.1.0-7FnvpPS-AQAcOiKlDGx-6R8JkhFAx5S3p8MsyDyPznOY",
        },
        .geode_client_zig = .{
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git#d73e3fac2c8a7ddaed8d193860aba5d930f66a44",
            .hash = "geode_client_zig-0.2.1-8ysbVw8QCQDKt4Hz0dW4rQTINnOif0FbFHVA5dq3Rw2O",
        },

        // =======================================================================
        // Phase 6: Extracted Core Libraries
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7, injectable generator
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#cede45bed26d9e1c11cb0234fb0014807c9c8bef",
            .hash = "uuid-0.1.0-tL1irrcPDAAPFdwSHWfwiKCC9lvvYGu6U0XH8efaTXP_",
        },

        // WAL - Generic, payload-agnostic Write-Ahead Log with AES-256-GCM encryption
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git#3e7eceeebc12105af2f9fba26869d07abf00e0fc",
            .hash = "wal-0.1.0-EqPqpoLbAwDrjPynZD6LJvElo7cSflDM5bfMNWUpTe5H",
        },

        // Page-based graph storage engine
        // Updated 2026-04-07: audit closure plus iterator-backed scans, streamed
        // backup/recovery paths, bounded deserialization, persisted edge index,
        // and fail-closed integrity handling
        .graph_storage = .{
            .url = "git+https://gitlab.com/devnw/zig/graph-storage.git#4e983ef3c1888269927b4903f4e225f2d1804ce5",
            .hash = "graph_storage-0.1.0-9UyJS0y3CwA9EIMV3K2xezJNy_e7j8KVUqxkrj8uiMnJ",
        },

        // Raft - Full Raft consensus with pre-vote, joint consensus, snapshotting
        .raft = .{
            .url = "git+https://gitlab.com/devnw/zig/raft.git#ea8fbbd4e48001a03af5eca49f8268c610e314ec",
            .hash = "raft-0.1.0-PqJyvkNCBACjoZFAj6zbFbS34oSK6-vWrefceScAmxxJ",
        },

        // =======================================================================
        // Phase 7: Extracted Domain Libraries
        // =======================================================================

        // Audit - Event modeling, filtering, CEF formatting, syslog/file sinks
        .audit = .{
            .url = "git+https://gitlab.com/devnw/zig/audit.git#df70a860d603196ae984551f45945a3047bbd968",
            .hash = "audit-0.1.0-J9TtCKFCAwAfz9avfYlwleJ25vI5Dugf9Tyz_ifmccQX",
        },

        // HNSW - Approximate nearest-neighbor index with configurable distance metrics
        .hnsw = .{
            .url = "git+https://gitlab.com/devnw/zig/hnsw.git#4e9ce5fa659f5af6af7f2f8ab71ee7fa48a5a622",
            .hash = "hnsw-0.1.0-wYzBy1kjAQCxJMClGp7TVmlkchtxfAkpqlfwbpfRmxFo",
