        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git#71626fe12e1acc88a6e73f14aa6d704f83f2c934",
            .hash = "mcp-0.1.0-exAeBIliBQBxqaejQTvHHeE1mCXSpCUtchobVfv1zZKD",
