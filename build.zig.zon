.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.19.0",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.15.1",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git",
            .hash = "uri-0.1.0-zVvOsXZLAQAfg1wUuvR2yQC3FLtQPAV85R2aS6EFiaZn",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git",
            .hash = "yaml-0.1.1-lcW-hEyJBABZo0NG6sKHQkL4gciVKTQ4GLwXVeA2kpCe",
        },

        // TOML v1.1.0 parser
        .toml = .{
            .url = "git+https://gitlab.com/devnw/zig/toml.git",
            .hash = "toml-0.1.0-MHnSh1XcAQBQcxyP1MWysHD43Y4LDb_0klB_hfM_sFRe",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git",
            .hash = "strings-0.1.0-adMOtbd1HABrved9iMt4lKxtonWX5dKNIWrdaWc2B5mo",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            .url = "git+https://gitlab.com/devnw/zig/repl.git",
            .hash = "repl-0.1.0-gwF1T66xAgCW6w1v0xNV5V5CzO7NjZNVxwnDZB57vFqz",
        },

        // Data structures and graph algorithms
        .ds = .{
            .url = "git+https://gitlab.com/devnw/zig/ds.git",
            .hash = "ds-0.1.0-aDfG04NfBgA1YVvVP7RmsobOasrM6uUa1R8EycPfssXq",
        },

        // Vulkan compute library
        .vulkan = .{
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git",
            .hash = "vulkan-0.1.0-zh1htcsSEQAdVTyZAhLTPxbhndNokVOSC4-Ureyd0dJx",
        },

        // CUDA compute library
        .cuda = .{
            .url = "git+https://gitlab.com/devnw/zig/cuda.git",
            .hash = "cuda-0.1.0-OCmgen2yBwC_15T5G8KeQ-9tC3zMjSdNZWuByJFcOXUy",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git",
            .hash = "json-0.1.0-tOue4WZ_CwDmY9dvdVfuFN_LcZZs6XcHmnQqkvsqdNCM",
        },

        // TLS 1.3 library for QUIC
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git",
            .hash = "tls-0.1.0-mtEaLEtsEQAcNcPqUq9or5b7zwp9seF_JIhc74uLLvBz",
        },

        // QUIC v1/v2 protocol implementation
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#v0.1.1",
            .hash = "quic-0.1.1-gBIqUS4GOgDlxTLOQ0C5JxOOiwIBNiEQF6gu_X6d1lYn",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git",
            .hash = "slog-0.1.0-SamED1LeAwCLXUkdx2TVZ1LB7WsDeB7hMILer1kpuiPs",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git",
            .hash = "config-0.1.0-TiLumiKJBQDP5bfj9FFnfZB8unOVJZGv6eMQVN5_eUNH",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git",
            .hash = "cli-0.1.0-0aso9F-vBAAoH-0L84gQXM4-y2NC_HzjU3KLsGEfBea3",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git",
            .hash = "dns-0.1.0-x4U-zYgMCwDlLjH2DUzIcVIqEfCj5x_2yGKIWFaiFJLA",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git",
            .hash = "mcp-0.1.0-exAeBHj7BAAYmmNRjZD3HG6hXVJG8-LEtybCLkBu7oj6",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "benchmarks",
        "tools",
        "geodetestlab",
    },
}
