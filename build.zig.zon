        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#f8924477c708ee0ecc546003175dbb60540e1339",
            .hash = "json-0.1.0-tOue4QSpCwCpF5cK2b-gB_Hanst_Btx76cS4JrKRBdhj",
        },

        // TLS 1.3 library for QUIC
        // Updated 2026-03: HRR state reset, mTLS with OpenSSL/BoringSSL interop
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#0929ceb8beaa11a0650cb2d164a8418596a6580e",
            .hash = "tls-0.1.0-mtEaLHPLEgD7ulluN9vsG7kzhkYx54baqhK8taaYW0Y5",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-03: v0.1.11 split endpoint mutex (mu + timer_mu),
        // thread-safe poll with spice, eliminates c=8 contention bottleneck.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#81f273fce8ba27ce985a207401fd77adec5bba01",
            .hash = "quic-0.1.10-gBIqUa8tMwBhD3bP1dvIP6e-XxjbYb2xfFUUOhqy_wpV",
        },

