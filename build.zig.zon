        // Timeseries - Pattern matching, DTW, matrix profile, PELT change-point detection
        .timeseries = .{
            .url = "git+https://gitlab.com/devnw/zig/timeseries.git?ref=v0.1.19#3ef621add8b956631b03a17f7e4d2a371e56a23f",
