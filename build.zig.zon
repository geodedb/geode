.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.8.23",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.16.0",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git?ref=v0.1.16#e5e784ca6defa4cf897e6b18d9f08ef7336b588d",
            .hash = "uri-0.1.16-zVvOseGkAgDNDu5FLweN4VsghRQxNEDVC539D0_Dpgdi",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git?ref=v0.1.10#d2455fdbc2676858988c94b4116ff11df65565a4",
            .hash = "yaml-0.1.10-lcW-hJ0sCAC3Ic7RLgYMLTI5r3HDCUT48ThG46wKCbGN",
        },

        // TOML v1.1.0 parser
        .toml = .{
            // Bumped to v0.2.0 in lockstep with config (2026-04-28). toml v0.2.0
            // changed Value.array to a raw ArrayList (dropped .items.len indirection).
            // config was bumped simultaneously (402bc274) to track the new API.
            // If reverting, revert both toml and config together.
            .url = "git+https://gitlab.com/devnw/zig/toml.git?ref=v0.1.15#db5571d99e7beefbaf596f438dfc32df4082237e",
            .hash = "toml-0.1.15-MHnSh2d3GQCA3jxCr0CnZGCAC-RpEx1ykQqfxLrJO3ST",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git?ref=v0.1.6#a0de39afeaa103a49b4458882f42457077eeaede",
            .hash = "strings-0.1.6-adMOtbUoYwCleEij9NYkFEnisu2MZULZlL4tb1excHFe",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            .url = "git+https://gitlab.com/devnw/zig/repl.git?ref=v0.1.22#1f4db816d3524895a0ab24b4f7319ea34a28e00b",
            .hash = "repl-0.1.22-gwF1T1whCABQdVsXpucrPDH0OV71vbtG9K_uKmp3cYx7",
        },

        // Vulkan compute library
        .vulkan = .{
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git?ref=v0.1.20#e4aed09dd22c1d078aa0e72efa314cf773e382da",
            .hash = "vulkan-0.1.20-zh1htbIPEgCHYSE8Zz9vsYcgjpPMFJqDBUgi7m0YDxSp",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git?ref=v0.1.20#22154db734abf5264a716086fc0669eb9d6c082a",
            .hash = "json-0.1.20-tOue4YSW6ACsmrKTooK2625fgWaZHPTZbu2R_EWVY4aU",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-04-30: bump to 1226ece — fix(quic): use full peer SCID
        // for standalone ECN-ACK packet routing.  Closes the long-response
        // stream stall (BUG_LONG_RESPONSE_STREAM_STALL.md): once the receiver's
        // ECN flag fired, every standalone ACK packet was emitted with a
        // 4-byte DCID that did not match the peer's full 8-byte our_scid, so
        // localDcidMatchLen rejected the packet and the sender's recovery
        // layer never advanced largest_acked.  cwnd stayed pinned at the
        // initial 10×MDS value and bytes_in_flight >= cwnd blocked every
        // subsequent writeStream.  The Geode integration repro was MATCH+
        // RETURN over >550 multi-column rows; setup batches in
        // gap_0257 went from timing-out at 30 s to all green after this bump.
        // Earlier 2026-04-28 (later): bump to 4b246b2 — sendHandshakePackets
        // now drives the TLS state machine via pollCrypto BEFORE checking
        // hs_tx_keys.  Fixes a benign race that capped concurrent client
        // fan-out at c=4: under msft-graph --workers 16, the keys check
        // raced the install callback and lost on 12 of 16 connections,
        // leaving them in TLS-incomplete state and stalling the seed at
        // flushed=281 with quic_active_connections=4.  Reordering lets
        // pollCrypto fire the install callback before the check.
        // Earlier 2026-04-28: v0.1.14 (67720c1) — coalesce server
        // Initial+Handshake into a 1200-byte datagram, exact varint Length
        // projection for coalesced datagram pad, TLS bumped to 7d9efd3.
        .quic = .{
            // Bumped 2026-04-30 to 49f59f7 — fix(handshake): defer + retry
            // sendHandshakePackets on NoHandshakeKeys. Server-side fix
            // for the host-haleth bug-triager finding
            //   ERROR: processInitial: sendHandshakePackets failed: NoHandshakeKeys
            // Pre-fix processInitial logged-and-dropped on a single
            // first-tick race; under msft-graph --workers 16 fan-in 12
            // of 16 connections never reached the accept queue and
            // stalled past the QUIC idle timeout. Post-fix processInitial
            // sets conn.pending_hs_send and the endpoint poll loop's
            // Phase 4.5 drain retries the flush every tick until the
            // TLS engine derives hs_tx_keys.
            //
            // 2026-05-02 — macOS cross-compile fix vendored as a patch.
            // Upstream `b73a804` adds `fcntlCmd(comptime tag)` to handle
            // the per-OS `std.c.F` shape divergence and rewrites
            // posixSendTo/posixRecvFrom against `std.c.{sendto,recvfrom}`
            // (Zig 0.16 dropped `std.posix.{sendto,recvfrom}`). Bumping
            // the pin to b73a804 directly trips a Zig 0.16 module-dedup
            // diamond ("file exists in modules 'build_options13' and
            // 'build_options0'") even though the upstream content-tree is
            // otherwise identical to 49f59f7. The fix is therefore
            // overlaid via `scripts/apply-vendored-patches.sh` (wired
            // into `.goreleaser.yaml` `before:hooks` and the Makefile
            // `cross-macos-{x86_64,arm64}` targets). Sunset the patch
            // and bump to b73a804+ once the sibling-pin convergence
            // resolves the diamond.
            // 2026-05-27: pin to the post-v0.1.21 upstream commit so the quic
            // lib includes the high-concurrency route-cache, poll-budget,
            // accepted-queue, diagnostic gating, Zig 0.16 tool fixes, and the
            // aligned tls/thread_pool graph used by Geode.
            // 2026-05-28: picks up tx-credit wakes for Initial/Handshake ACKs
            // and explicit tx_credit_generation init for allocator-created
            // connections, avoiding HELLO fan-out write stalls.
            // 2026-05-28: also keeps the trusted-localhost cwnd bypass used by
            // high-fanout loopback integration tests while preserving the
            // normal congestion gate for remote peers.
            // 2026-05-28: serializes QUIC's legacy sent-packet maps so
            // concurrent poll workers cannot race PTO accounting on one
            // connection.
            // 2026-05-28: serializes PTO dirty recompute on conn.mu so endpoint
            // timer arming cannot race high-parallel STREAM response writes.
            // 2026-05-28: retransmits retained app STREAM data when recovery
            // compacts time-threshold lost packets before app retx queries.
            // 2026-05-28: rearms app PTO after send failures so retained
            // STREAM responses do not strand high-concurrency clients.
            // 2026-05-28: adds gated short-header drop diagnostics used to
            // isolate missing first post-handshake requests under fan-out.
            // 2026-05-28: keeps port-0 client UDP binds unique under fan-out and
            // fixes sendmmsg peer storage so batched paced sends cannot target
            // the wrong client socket.
            // 2026-05-28: serializes per-connection TLS Context access so
            // concurrent poll workers cannot race pollCrypto ownership drains.
            // 2026-05-28: increases server-side receive drain budget so
            // synchronized request bursts do not strand STREAM retransmits in PTO.
            // 2026-05-28: sheds contended server ACK-frame work while preserving
            // immediate app-stream flow-control feedback.
            // 2026-05-28: restores the proven wider server short-header drain
            // after rejecting one-batch, two-batch, and packet-shedding variants.
            // 2026-05-29: defers the first server-side STREAM-only standalone
            // ACK so request/response traffic can piggyback ACKs on response
            // packets, with AppAckDelay preserving max_ack_delay for quiet peers.
            // 2026-05-29: restores the proven four-batch server drain after
            // short-header wall-clock yield experiments regressed Geode's
            // accepted 4096 single-op gate.
            // 2026-05-29: pins the upstream-main revert of the slow-batch
            // short-header cadence experiment after it regressed Geode's
            // accepted 4096 single-op gate. Content is equivalent to the
            // proven 108d06d four-batch receive behavior.
            // 2026-05-29: pins REQ-QUIC-HC-168, which routes generic and
            // coalesced long-header dispatch through the same per-connection
            // TLS serializer as the optimized burst receive path.
            // 2026-05-29: pins a1858c1, reverting the rejected
            // REQ-QUIC-HC-177 busy-connection shedding experiment after it
            // regressed Geode's 2048x8 mixed workload.
            // 2026-06-14: v0.1.27 — fix(endpoint): batch connection teardown.
            // api.destroyBatch frees a churn backlog in ONE O(N+keys) map sweep
            // instead of O(backlog×N) per-conn scans under ep.mu (acceptor-wedge:
            // long ep.mu hold starved poll workers → UDP rx_queue backed up →
            // AppendEntries dropped → stranded candidate). See
            // docs/bugs/2026-06-03-acceptor-wedge-connection-burst-new-conns-refused.md.
            // Bumped 2026-06-14 to v0.1.28 (8ed9425) — acceptor-wedge RC-A: the
            // per-poll socket-DRAIN cap is decoupled from the Initial PROCESSING
            // budget so a reconnect storm's surplus Initials are cheaply shed and
            // the kernel UDP rx_queue stays bounded (the destroyBatch teardown fix
            // alone did not bound rx-queue growth). Tunable via GEODE_QUIC_DRAIN_PACKETS.
            // Bumped 2026-06-15 to v0.1.29 (69d5363) — RC-A iteration 2: v0.1.28's
            // drain cap was still gated behind the 256-Initial ep.mu-serialized
            // PROCESSING budget (16 workers all blocked on ep.mu → none draining),
            // so the k8s rx_queue still wedged at ~11.4 MB. Drop the Initial
            // processing budget to one UDP batch (64) + raise the drain cap to
            // empty a full 16 MiB SO_RCVBUF per cycle, so the lock-free shed-drain
            // engages immediately and the rx_queue is actually bounded. Initial
            // budget tunable via GEODE_QUIC_INITIAL_BUDGET.
            // 2026-06-15: v0.1.30 — RC-C (it.3): wire the dead/churned-connection
            // reaper (idle close + same-peer stale close). Server-side opt-in via
            // dead_conn_reap_ms (OFF by default; the raft listener opts in at 30s),
            // so client behaviour is unchanged. The raft server reaps a churned
            // peer's stale INBOUND connection (the ~12-min proto_reader stall) so
            // the replacement pod can re-handshake. NOTE: the v0.1.30 tag commit
            // (245ecae) predated its own .version bump, so its content hash was
            // labelled 0.1.29 — pinned by commit, reproducible, lockstep with
            // geode-client-zig.
            // 2026-06-17: bump to v0.1.31 (02cee4a) — GAP-0900 lever (a): eliminate
            // the per-poll 256 KiB memset in endpoint.pollWithStats (stack
            // `= undefined` is 0xAA-filled every call in ReleaseSafe across 16
            // poll threads). Moved the receive scratch to threadlocal static.
            // Validated: compiler_rt.memset 44%→17.7% of CPU, +14.8% poll-bound
            // RETURN 1 throughput, correctness verified, quic `zig build test` green.
            // .version now tracks the tag (0.1.31).
            // 2026-07-13: v0.1.38 — pin-only release aligning quic's
            // thread_pool to v0.2.7 (popMany stalled-producer livelock fix)
            // in lockstep with geode + timeseries-storage.
            // Includes main's v0.1.47 lost-STREAM retransmission fix (3ca1e9f), plus
            // portable entropy, clocks, sleep, and checked nonblocking POSIX sockets.
            // Native macOS transport and current-main paired UDP gate passed.
            .url = "git+https://gitlab.com/devnw/zig/quic.git?ref=4c20fbabd7e1b756f6776a87af59f1e3fc8f239a#4c20fbabd7e1b756f6776a87af59f1e3fc8f239a",
            .hash = "quic-0.1.47-gBIqUb9-QAAkC9VxvIxRKD9mjRH1fSZY_Vj5Hc23QxA2",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git?ref=cc52d6604e3662eb189afe7b31a40af819656732#cc52d6604e3662eb189afe7b31a40af819656732",
            .hash = "slog-0.1.15-SamED0_5BwDjEO-i_tcG2pY86JOX7NZ-IR6_KGYw4fay",
        },

        // OpenTelemetry client library - metrics, tracing, logs surface.
        // 2026-05-27: aligned with the converged devnw/zig graph so direct
        // and transitive consumers resolve a single otel module instance.
        // Build flags `use_devnw_grpc`, `use_devnw_protobuf`, `use_devnw_pool`
        // remain default-off unless the whole telemetry stack is verified
        // together. `otel_use_devnw_tls` IS enabled by geode (build.zig) so the
        // std.http.Client OTLP transport is compiled in.
        //
        // NOTE (2026-05-29): a BatchSpanProcessor span-reuse UAF (non-atomic
        // SpanState.ended → double-enqueue/double-recycle under concurrent
        // double-end) is fixed on otel branch `fix/bsp-span-reuse-uaf`
        // (9fa2e97af5f9ee527db20dcf09847a0589cdd6df, atomic end-claim). It is
        // NOT pinned here: bumping otel forces a ~18-lib ecosystem convergence
        // (all sibling libs declare otel@455ad2b8 for their hardcoded-off
        // observability seam — see detect_diamond_deps). Geode instead enforces
        // exactly-once span end() at its own facade (src/monitoring/otel_metrics
        // span wrapper), which prevents the double-end that triggers the UAF.
        // Pin to 9fa2e97 (or descendant) at the next ecosystem-wide otel
        // convergence. See docs/superpowers/plans/2026-05-29-otel-full-instrumentation-program.md.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.28#e56f1c1fe9385c8cc0d93ec118eb5538a23d2966",
            .hash = "otel-0.1.28-B0v3lj-uNQAmn4BzC6lmEzihawdobgIFviswkb2hpfFN",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git?ref=v0.1.18#cf328f6f9c9d115fcafb573d2fec82f0c51fc0e8",
            .hash = "config-0.1.18-TiLumviyDABHAt1Am31WtoSYVORg1fPL0XagLW_YeNjK",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git?ref=v0.1.14#75b181d1afcb4a3f246a4c08c3adf5f9895d6723",
            .hash = "cli-0.1.14-0aso9I9HCwDxOBxILQV8gOiOROxsEotN9GE0ILMZhD5h",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=5b71169ae2763020482a7672b7f0b16d3b577f75#5b71169ae2763020482a7672b7f0b16d3b577f75",
            .hash = "dns-0.1.27-x4U-zfVqGACo8cYBKhXmcD9V8CTwM-E7064GPc7L6Du_",
        },

        // Thread Pool - Bounded, lock-free thread pool with work-stealing
        .thread_pool = .{
            // 2026-05-27: pin to 39528a3 for the WaitGroup completion-broadcast
            // lifetime fix used by Geode's QUIC bounded parallel facade. This
            // must stay aligned with quic and the lazy telemetry graph.
            // 2026-07-13: thread-pool v0.2.7 (54a2ddd) carries the
            // BoundedRing.popMany check-then-reserve fix — consumers no longer
            // spin unbounded on a mid-push (preempted) producer. That spin
            // livelocks CPU-throttled CI runners and is the prime suspect for
            // the silent 6h test-shard hangs (unit/release-safe shard [6]/[7]
            // job_execution_timeout, e.g. pipeline #2670033275). LOCKSTEP:
            // quic and timeseries-storage type-share *ThreadPool with geode
            // (src/timeseries/timeseries.zig passes the pool into
            // timeseries-storage), so this round bumps all three together:
            // thread_pool v0.2.7 + quic v0.1.38 + timeseries-storage v0.2.10
            // (each pin-aligned to the same thread_pool hash). A partial bump
            // fails with "expected '*pool.ThreadPool', found '*pool.ThreadPool'".
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.9#1d7275da020a43588c4f1885f7f725d5e8ce079e",
            .hash = "thread_pool-0.2.9-11B1Bqf7eQDfHhrQAkHk0e2ABigRBFNkFEAmc8t9raZe",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        // Updated 2026-08-29 (Task 6): v0.1.11 hardcoded owned=false for tools/call
        // results while the dispatch free-site only frees owned results, leaking
        // every dynamically-allocated tool response for the life of `geode mcp`.
        // v0.1.12 marks tools/call owned=true (server frees it); see
        // docs/MCP_SERVER.md. Upstream fix: gitlab.com/devnw/zig/mcp@956b07d.
        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git?ref=ddb3d0a125ece885a42e99e53a7d8ffbba2f8a0c#ddb3d0a125ece885a42e99e53a7d8ffbba2f8a0c",
            .hash = "mcp-0.1.21-exAeBBAUCACOUX7iMou6kvpH1s_Oy9bykx-LzwmqQF0v",
        },

        // Protocol Buffers - Zig 0.15.2 compatible
        .protobuf = .{
            .url = "git+https://gitlab.com/devnw/zig/protobuf.git?ref=v0.1.6#8d8dbd814c7f66862c91fbb9f362ffbc234042cd",
            .hash = "protobuf-0.1.6-0e82auWaKgDC4D1fIyd0DolpnGr0CF8oJZ6xwTSBuJFh",
        },

        // gRPC for Zig
        // Updated 2026-02-11: concurrent connections, HPACK Huffman, TLS errdefer
        // GAP-0443: Use git+https URL with full commit hash for supply chain auditability
        .grpc_zig = .{
            // 2026-09-15: the whole telemetry stack WAS repinned together by
            // the zig-tool sync-diamond cascade onto grpc-zig v0.1.10
            // (SONNY-1568 per-connection reader threads); otel is now v0.1.20.
            .url = "git+https://gitlab.com/devnw/zig/grpc-zig.git?ref=fe88ba8dd81911a784b55118b24c9d8508596578#fe88ba8dd81911a784b55118b24c9d8508596578",
            .hash = "grpc_zig-0.1.15-7FnvpLMcCQB93y-UXU0IyaKVxjIUIElCi8OiCtl859lp",
        },
        .geode_client_zig = .{
            // 2026-05-01: bumped to d1af792 — picks up the matching
            // quic e33e7bf pin (macOS std.posix -> std.c.* fix). The
            // geode and geode-client-zig quic pins must agree to keep
            // a single quic module instance in geode's build graph
            // (else "file exists in modules 'quic' and 'quic0'").
            // 2026-05-01: bumped to 36ae5bb — matches geode's quic
            // pin at 49f59f7 (NoHandshakeKeys retry fix). Without
            // this both quic versions appear in the build graph and
            // the Phase 4.5 drain wouldn't engage on client paths.
            // 2026-05-27: bumped to 6576e08 so the client library shares
            // Geode's converged quic/thread_pool high-concurrency graph.
            // 2026-05-28: bumped to 0ce6bdb so the client and server share
            // the tx-credit wake fix from quic f8a39e8.
            // 2026-05-28: bumped to 9e185b4 so the client and server share
            // quic d3382eb's trusted-localhost cwnd bypass.
            // 2026-05-28: bumped to b502799 so the client and server share
            // quic ef8d143's sent-packet legacy map mutex.
            // 2026-05-28: bumped to f1f10db so the client and server share
            // quic 0d0acfb's PTO dirty recompute serialization.
            // 2026-05-28: bumped to c733b2b so the client and server share
            // quic 203bb27's time-threshold app STREAM retransmit fix.
            // 2026-05-28: bumped to f781d1e so client and server share
            // quic adac2dc's app PTO rearm-on-send-failure fix.
            // 2026-05-28: bumped to 0886276 so client and server share
            // quic d12803f's gated short-header drop diagnostics.
            // 2026-05-28: bumped to a3a5dde so client and server share
            // quic d7d023c's UDP fan-out fixes.
            // 2026-05-28: bumped to 65336fe so client and server share
            // quic 292fb1a's TLS pollCrypto serialization.
            // 2026-05-28: bumped to 0fb1eae so client and server share
            // quic 553975f's server receive burst drain.
            // 2026-05-28: bumped to b963a95 so client and server share
            // quic 6934965's final server-drain contention controls.
            // 2026-05-28: bumped to ed542ca so client and server share
            // quic 4eebb8e's bounded server short-header app cadence.
            // 2026-05-28: bumped to 9c5b4c7 so client and server share
            // quic b8d331d's server short-header contention shedding.
            // 2026-05-28: bumped to 959a43a so client and server share
            // quic fc7efc2's restored server short-header drain.
            // 2026-05-29: bumped to e96ca35 so client and server share
            // quic a68d36e's server STREAM ACK fanout reduction.
            // 2026-05-29: bumped to 5a6b65a so client and server share
            // quic 9a35274's revert of the rejected one-batch short-header
            // receive budget experiment.
            // 2026-05-29: bumped to 2f1bfe0 after rejecting quic
            // c2874fb/76b45ec's receive-cadence yield experiments; client and
            // server now share quic 108d06d's revert to the proven four-batch
            // drain.
            // 2026-05-29: bumped to 533cde8 so client and server share quic
            // eeeb216's upstream-main revert of the slow-batch cadence
            // experiment.
            // 2026-05-29: bumped to 5ae3102 so client and server share quic
            // 06f4aad's generic long-header TLS dispatch serialization.
            // 2026-05-29: bumped to 942641c so the embedded client shares
            // quic a1858c1's revert of the rejected short-header shedding
            // experiment.
            // 2026-06-10: bumped to 9ba815e (GAP-0849) — client now sends
            // tenant_id (field 3), graph (field 7), and role (field 8) in the
            // HELLO handshake, matching the geode server's HelloRequest wire
            // format (server already consumes all three: see
            // quic_connection_handler.zig:4768/4789/4816). This commit does NOT
            // change geode-client-zig's quic pin (diff e66fdf5..9ba815e of
            // build.zig.zon is empty), so the single-quic-module convergence
            // constraint is preserved. Commit is on origin/main (ahead of the
            // v0.2.11 tag), hence ref=main.
            // 2026-06-14: v0.2.13 — bumps quic to v0.1.27 too, so geode's direct
            // quic pin and geode-client-zig's quic pin agree (single quic module
            // instance / diamond constraint preserved).
            // 2026-06-14: v0.2.14 — keeps geode-client-zig's quic pin in lockstep
            // with geode's bump to v0.1.28 (acceptor-wedge RC-A) so the build
            // graph has a single quic module instance (no diamond).
            // 2026-06-15: v0.2.15 — lockstep with geode's quic v0.1.29 bump
            // (acceptor-wedge RC-A it.2).
            // 2026-06-15: v0.2.16 — lockstep with geode's quic v0.1.30 bump
            // (RC-C dead-connection reaper). Keeps a single quic module instance.
            // 2026-06-17: v0.2.17 — quic v0.1.31 lockstep (GAP-0900 poll-loop
            // memset fix). Both pins now resolve the same quic v0.1.31 module,
            // so the build graph stays diamond-free.
            // 2026-10-18: main commit 2ea3490 (geode-client-zig !32), lockstep with
            // geode's quic v0.1.45 bump so the graph has one quic module. No
            // geode-client-zig tag pins quic v0.1.45 yet, hence ref=main.
            // 2026-10-20: main commit 8819899 (geode-client-zig !34), lockstep with
            // geode's quic v0.1.46 bump (client Finished retransmit until
            // HANDSHAKE_DONE). Still no client tag on this quic, hence ref=main.
            // Includes main's be724ae transport/entropy pins, plus portable deadlines.
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git?ref=57240957a2b5e690b83829d5de3a827a3004d6c8#57240957a2b5e690b83829d5de3a827a3004d6c8",
            .hash = "geode_client_zig-0.3.8-8ysbV1WBCwDb9bKkda9TcgMGWmGNfxTxyumNnCQRyUyI",
        },

        // =======================================================================
        // Phase 6: Extracted Core Libraries
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7, injectable generator
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git?ref=c8206cbf2f3abc756b62b9e099715c81a452a2aa#c8206cbf2f3abc756b62b9e099715c81a452a2aa",
            .hash = "uuid-0.1.9-tL1iruPmHAAJ2ebApUBKroge9t-yDmrcPJ-2A2FEduNj",
        },

        // WAL - Generic, payload-agnostic Write-Ahead Log with AES-256-GCM encryption
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git?ref=8a17e4080f77f45c6c9169682105dc31fef7ec8d#8a17e4080f77f45c6c9169682105dc31fef7ec8d",
            .hash = "wal-0.1.22-EqPqppQ5BwBoP4VyV5UqOInJ4UWxA3xfjxdRTfixr7j-",
        },

        // Page-based graph storage engine
        // Updated 2026-04-24: ShardedGraphEngine with N=16 single-threaded shards,
        // per-shard WAL/manifest, 2PC cross-shard edges, parallel per-shard crash
        // recovery. Microbench verified ≥4× throughput vs single-engine at 16 cores.
        // See docs/superpowers/specs/2026-04-24-sharded-graph-engine-design.md
        // in the graph-storage repo.
        // 2026-06-18: v0.2.3 (98f179b) — GAP-0900 Layer-2 incremental checkpoint:
        // adds engine.checkpointLight()/sharded_engine.checkpointLight() that flush
        // dirty pages + truncate the WAL but SKIP the O(graph) derived-index save
        // (recovery rebuilds those from pages). Cherry-picked onto v0.2.2 so sibling
        // dep pins are unchanged. Bounds deferred-mode checkpoint cost to O(dirty) so
        // the periodic checkpoint keeps pace with sustained bulk ingest.
        // Bumped 2026-06-23 to v0.2.7 (1c73f44) — lock-free buffer-pool pin/unpin hit path
        // + pin mutex-leak fix (aborts under concurrent reads+writes with eviction).
        //
        // PHASE 3 (edge-engine-direct) DEV PIN — 2026-06-24:
        // Temporarily overridden to a LOCAL PATH so geode builds against the
        // unreleased graph-storage edge-EXISTENCE index (probeEdge / O(1) durable
        // MERGE dedup; commit d91173e on branch feat/edge-engine-direct in the
        // graph-storage worktree). `git+file://` is unsupported by `zig fetch` and
        // the commit is not pushed, so a path override is the correct sandbox dev
        // pin. AT MERGE-TO-MAIN: tag graph-storage (e.g. v0.2.8), restore the
        // url+hash form below, then run the diamond-cascade bump across consumers.
        // Prior pin (restore at release):
        //   .url  = "git+https://gitlab.com/devnw/zig/graph-storage.git?ref=v0.2.8#<sha>",
        //   .hash = "graph_storage-0.2.8-<...>",
        .graph_storage = .{
            // v0.2.15 = v0.2.14 + value-ordered secondary index (H3): order-preserving
            // encoder + ordered B+Tree + per-(label,key) per-shard index, counter-gated
            // persistence + checkpoint-refresh. Additive/gated (active only when an
            // ordered index is registered). Same FIPS transitive deps -> no diamond.
            // v0.2.14 = v0.2.13 + Lever B: a CLEAN restart LOADS the persisted
            // derived index snapshots (O(snapshot)) instead of the O(graph)
            // rebuildDerivedIndexes — a full checkpoint now persists dirty derived
            // indexes even when pages are clean. Crash restarts still rebuild
            // (manifest.counter gate + recovery bump unchanged → stale snapshots
            // rejected). v0.2.13 = v0.2.12 + parallel 16-shard open recovery
            // (concurrent shard opens; recovery makes no thread-pool calls so it
            // cannot re-enter the v0.2.12 pin deadlock). Same FIPS transitive deps
            // → no diamond.
            // v0.2.21 (2026-07-01): O(1)-amortized CLOCK eviction (buffer_pool)
            // + getPropertyNoDerived (chain read without derived-index hydration)
            // + open-time pool-recreate hardening — the engine half of the
            // sub-second cold-open work (geode perf/coldopen-loop1-prop_head).
            // Same transitive deps as v0.2.20 (no diamond).
            // v0.2.23 (2026-07-01): prop-store SLAB PACKING — node property
            // blobs packed into shared pages (~55-59x props-store reduction,
            // measured 149.4 bytes/node through the geode stack vs 8192);
            // read-both (legacy chains still read); WAL/crash-safe (whole-page
            // images of decoded slab pages); edge properties stay legacy via
            // putPropertyLegacyTxn (adapter sites switched). Whole-branch
            // review: READY TO RELEASE (no blockers). Supersedes the v0.2.22
            // tag (points pre-version-bump; do not pin it).
            // v0.2.24 (2026-07-02): INLINE EDGE PUBLIC ID (GAP-ENT-0024) —
            // adjacency EdgeEntry carries `public_id: u64` in v2 blocks (v1
            // blocks surface 0; block-granular read-both, no store migration);
            // addEdgeColocatedWithPublicId on GraphEngine + ShardedGraphEngine;
            // EdgeIndexEntry / FanInEdgeIterator / edge-index snapshot carry the
            // id. Manifest V3: pre-v0.2.24 binaries loudly reject v0.2.24
            // stores; v2 stores auto-upgrade at open. Lets geode stop writing
            // the `__geode_internal_edge_id` property page per edge (~8 KB/edge
            // -> 0 for propertyless edges). Same transitive deps (no diamond).
            // v0.2.29 (2026-07-06): WAL-aware derived-index durability (Path B) —
            // Manifest V4 adds a durable `checkpoint_epoch` advanced ONLY by
            // doCheckpoint (never by recovery), so a derived-index snapshot
            // stamped (checkpoint_epoch, covered_lsn) survives a deferred-WAL
            // tail on reopen: the engine's own label/property/edge/edge_exist
            // indexes RELOAD when epoch matches and RECONCILE the bounded WAL
            // tail (re-derive entries for tail-touched pages) at first access,
            // instead of the O(graph) rebuild the counter gate forced. Geode
            // rides the SAME contract for its own prop_exact.idx via the epoch
            // getter the adapter's engine handle exposes. Manifest V4:
            // pre-v0.2.29 binaries loudly reject v4 stores. Same transitive
            // deps as v0.2.28 (no diamond).
            // v0.2.35 (2026-07-07): GAP-0060 EDGE-PROP SLAB PACKING — edge
            // prop_head widened u32->u64 across the edge index + durable
            // adjacency (new v3/slab-v3 40B wire formats, edge-index magic
            // GSEIDX5->GSEIDX6, block-granular read-both, LOUD no-truncate on a
            // >u32 head into a legacy record). Edge properties now slab-pack via
            // putPropertyTxn (adapter edge-write sites re-routed, gated on
            // edge_prop_slab_packing, default ON) — ~8 KB/edge -> ~90 B/edge
            // (~111 GB -> few GB at 13.6M edges). Bundles GAP-0050: value-ordered
            // (H3) index on the (checkpoint_epoch,last_checkpoint_lsn) reload
            // contract. No manifest bump (stays V4; the adjacency entry-format
            // byte + read-both is the versioning). Same transitive deps as
            // v0.2.34 (no diamond).
            // v0.4.0 (2026-08-25): PROPERTY-VALUE OVERFLOW — a property value
            // whose entry (2 + key.len + encoded value) exceeds the ~8142-byte
            // inline per-page budget no longer fails: the encoded value spills
            // into a VarStore overflow chain and a fixed 13-byte tag-7 stub
            // takes its place in the entry, so the insert path downstream is
            // unchanged. New `GraphConfig.max_property_value_bytes` (default
            // 1 MiB) is the sanity cap that bounds WAL record volume and per-op
            // memory for a spill (SEC/DoS); a value above it is refused BEFORE
            // any page or WAL byte is owed. TRUTHFUL ERROR SPLIT:
            // `error.PropertyValueTooLarge` now means the VALUE exceeded the
            // cap, and `error.PropertyKeyTooLong` is reserved for a genuinely
            // oversized KEY (one whose key bytes + the 13-byte stub cannot fit
            // an entry) — geode's adapter re-map for the mis-attributed case is
            // therefore obsolete. A VECTOR<f32> now stores up to ~262,144 dims
            // (4096-dim embeddings are 16 KB) instead of 2030. Stores that hold
            // no overflowed values stay byte-compatible (no manifest bump; the
            // stub tag is the versioning). Same transitive deps as v0.3.2 (no
            // diamond).
            .url = "git+https://gitlab.com/devnw/zig/graph-storage.git?ref=5fe21929aa851e7df97dc3bbdff5d48ca64e77b5#5fe21929aa851e7df97dc3bbdff5d48ca64e77b5",
            .hash = "graph_storage-0.4.10-9UyJS7TBLAC90y84DCss2l2n9_gx_6jbUYU2Zawpxten",
        },

        // Raft - Full Raft consensus with pre-vote, joint consensus, snapshotting
        // Bumped 2026-06-14 to v0.1.8 (d101908) — RC-B: etcd-style candidate
        // demotion on quorum vote rejection (a quorum-denied / frozen candidate
        // now steps down to follower instead of cycling the election loop),
        // closing the consensus-layer half of the no-leader all-candidate livelock
        // (docs/bugs/2026-06-04-cluster-raft-no-stable-quorum-writes-time-out.md).
        // Bumped 2026-06-15 to v0.1.9 (555dbb3) — RC-B iteration 2: timer-based
        // candidate demotion. v0.1.8's demotion only fires on a quorum REJECTION;
        // a transport-degraded candidate or a pre-vote mutual-grant lockstep
        // forms no rejection quorum and stayed a candidate forever (v0.6.27-30
        // residual). After N consecutive failed elections the candidate now steps
        // down + backs off (Config.candidate_demote_threshold, default 4).
        .raft = .{
            .url = "git+https://gitlab.com/devnw/zig/raft.git?ref=b80fd49f7bb445636b4c23d63e6f171b9ecc28dc#b80fd49f7bb445636b4c23d63e6f171b9ecc28dc",
            .hash = "raft-0.1.21-PqJyvpinCADH3w-cgzAwsvA0eSk703D7J5yFyKr6TjJ0",
        },

        // =======================================================================
        // Phase 7: Extracted Domain Libraries
