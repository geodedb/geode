        .fle = .{
            .url = "git+https://gitlab.com/devnw/zig/fle.git#1c9c076d0d87905490710e0aa0435f1f832b1a4f",
            .hash = "fle-0.1.0-1Cfwle1LAQDvA3IBVvKQ_IgMGymt4qqkn-UaqFwz7xg0",
        },

        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#c9145b8aae3a57eb3436a380f332deb60aea753c",
            .hash = "gql-0.1.0-T1ANDYqLCAAJHOhJBVqrV_KBvQwXsobgpLIGoiBRFqCV",
        },

        // Timeseries - Pattern matching, DTW, matrix profile, PELT change-point detection
        .timeseries = .{
            .url = "git+https://gitlab.com/devnw/zig/timeseries.git#90151db3aeeb8d9fcb15275d913edf2fb4989c3f",
            .hash = "timeseries-0.1.0-iAEwOirvAwBbqpZy47FtrG01_aU9H2gczYLJyCYjQDk1",
        },

        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#74a3afab57d6a286f5fb6ebd043a85987f8a0aa7",
            .hash = "auth-0.1.0-W76ZZ3UBAQAAYOL9rx0rk9bQ0sTr63ZPLjbPu6yN3xWM",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "benchmarks",
        "tools",
        "geodetestlab",
    },
}
