.{
    // Geode Graph Database - ISO/IEC 39075:2024 GQL Implementation
    .name = .geode,
    .version = "0.1.4",
    .fingerprint = 0x9e0aec1832a82609,
    .minimum_zig_version = "0.15.1",

    // Dependencies from gitlab.com/devnw/zig/* libraries
    .dependencies = .{
        // =======================================================================
        // Phase 1: Foundation Libraries (No Dependencies)
        // =======================================================================

        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#16449fb29e214a20dc12a5c80a70f61618ebb010",
            .hash = "uri-0.1.0-zVvOsTxgAgDWhxELBAoEpGXAFc64tGHSdI3l4ElDjZNf",
        },

        // YAML 1.2.2 parser/emitter
        .yaml = .{
            .url = "git+https://gitlab.com/devnw/zig/yaml.git#aed86886a01bf8806d8dce4c4c70c0c5936e4af3",
            .hash = "yaml-0.1.1-lcW-hEOgBABscY5S5-XPG2ePcvM8Bb90R6t6h4aHLIHh",
        },

        // TOML v1.1.0 parser
        .toml = .{
            .url = "git+https://gitlab.com/devnw/zig/toml.git#6677fb1c93f39dda5dbb018d105d8def9c20d15b",
            .hash = "toml-0.1.0-MHnSh9gsAgD5RNXKcN72j6kNmOq2VpZvbhiKpShNsb-_",
        },

        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#2ef162064944efbd099d37c32f6066c18936e880",
            .hash = "strings-0.1.0-adMOtaJuJgD_QEgA4P9U-Xah05Teuc48dUModyUzBZa-",
        },

        // REPL library with Emacs/Vi keybindings
        .repl = .{
            .url = "git+https://gitlab.com/devnw/zig/repl.git#ea718c9ca4a2444be94fde3113965e9fbd17211f",
            .hash = "repl-0.1.0-gwF1T-6LBQDX_OEoEsJYxDM2S_hFL8Y1YVguEFWQA34D",
        },

        // Vulkan compute library
        .vulkan = .{
            .url = "git+https://gitlab.com/devnw/zig/vulkan.git#fd7a222bf3dc7732aa61b37e662e1d2766a0cc7a",
            .hash = "vulkan-0.1.0-zh1htXeEEQBr3goLSXRbGYMgDYe8GsIPVxFalGdZEOOQ",
        },

        // =======================================================================
        // Phase 2: Core Libraries
        // =======================================================================

        // JSON parser/encoder - RFC 8259 compliant with JSON Schema 2020-12
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#5aaf7a44a611497eb80f192f5ff650a2deda524c",
            .hash = "json-0.1.0-tOue4R6nCwAPrqSJZk-IkAB13WBlAwaNVPQdqxnyZE6H",
        },

        // QUIC v1/v2 protocol implementation
        // Updated 2026-03-27: v0.1.11+ (a979f59) — split endpoint mutex,
        // ACK data race fix, bytes_in_flight leak fix, narrow handshake locks.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#0c5f1a75d8095f1cc53bdcee811a475a5a28e0e7",
            .hash = "quic-0.1.11-gBIqUbJHNgBuftM4SZxh0-iz75zxt6NFuynBYMrtHxbQ",
        },

        // =======================================================================
        // Phase 3: Integration Libraries
        // =======================================================================

        // Structured logging - slog-style logging with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#4781e6433a3243db043d4dd40ac7e2f34b7fad46",
            .hash = "slog-0.1.0-SamEDwJFBgC97AnwMLmSwA8ECMSAK1EB3-x8Cy8jkTX_",
        },

        // Configuration management - XDG compliant, multi-format support
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#5ae76c9599bd1a4d4c9d5a0517260a546201cb92",
            .hash = "config-0.1.0-TiLummVcCgC2E0z8-TpYHqAEVFD4L3CYOLzWQQTZDrGg",
        },

        // =======================================================================
        // Phase 4: Application Libraries
        // =======================================================================

        // CLI framework - Cobra/Viper-class command-line interface
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git#76d83dc6b1e4e1374d6bc9ad7e2e0323ec6eaad6",
            .hash = "cli-0.1.1-0aso9Gm9BgDV8XOtwDPWgooA3QJ1A84iOLW1j422jumJ",
        },

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ support
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#135cce8f16d0522104d20e19820f2ae47c80bf89",
            .hash = "dns-0.1.0-x4U-zWrTEAA-V_OO-tIxxyHUALuJKY89Thb5kju7vAG0",
        },

        // Thread Pool - Bounded, lock-free thread pool with work-stealing
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#a572f2c255f6d1d7163bacdad266b3f199854822",
            .hash = "thread_pool-0.2.0-11B1BnYIQwCpbLn6Mm8gNc8_0eN-z0BaN6B3yNU0Y1-q",
        },

        // =======================================================================
        // Phase 5: Optional Enhancements
        // =======================================================================

        // Model Context Protocol (MCP) - AI/LLM integration
        .mcp = .{
            .url = "git+https://gitlab.com/devnw/zig/mcp.git#deeb40f8b39421de29c92da32f948e538f646432",
            .hash = "mcp-0.1.0-exAeBGF1BQCNLetJAcXgXwobTB4osGMlQOpriBS6STSc",
        },

        // Protocol Buffers - Zig 0.15.2 compatible
        .protobuf = .{
            .url = "git+https://gitlab.com/devnw/zig/protobuf.git#f18747d87010afc0517a0f0e40cb00fd352e4191",
            .hash = "protobuf-3.0.0-0e82akVdKQBR-5UyQkdGI2f9WiRtiENLEMw_nH7HusOd",
        },

        // gRPC for Zig
        // Updated 2026-02-11: concurrent connections, HPACK Huffman, TLS errdefer
        // GAP-0443: Use git+https URL with full commit hash for supply chain auditability
        .grpc_zig = .{
            .url = "git+https://gitlab.com/devnw/zig/grpc-zig.git#8c499c17662b2253e10c1e510e9c30ff407d26aa",
            .hash = "grpc_zig-0.1.0-7FnvpIu9AQAPZxjgM1lW4gKwyNqI6fR49tTCN7uWm3Yl",
        },
        .geode_client_zig = .{
            .url = "git+https://gitlab.com/devnw/codepros/geode/geode-client-zig.git#e7b064330bf8e7b886a408935bf620a72a8e04f0",
            .hash = "geode_client_zig-0.2.1-8ysbV3WSCAABTPL63dn9Dn20ddh-lWJ7fJ5K6W_2XEQl",
        },

        // =======================================================================
        // Phase 6: Extracted Core Libraries
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7, injectable generator
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#5af72b4815f5512633da8383e66b209d8d8d0754",
            .hash = "uuid-0.1.0-tL1irpURDADBWV1YTG1QwE-DCe7OftV4j54sJrQfa7db",
        },

        // WAL - Generic, payload-agnostic Write-Ahead Log with AES-256-GCM encryption
        .wal = .{
            .url = "git+https://gitlab.com/devnw/zig/wal.git#e864e90ab3b0c42bc31ffa6abac3c1f5a10c20fb",
            .hash = "wal-0.1.0-EqPqpofJAwDSHxRjTBzlSZWKsg_FRzNOn7ONN18DwURs",
        },

        // Page-based graph storage engine
        // Updated 2026-04-07: audit closure plus iterator-backed scans, streamed
        // backup/recovery paths, bounded deserialization, persisted edge index,
        // and fail-closed integrity handling
        .graph_storage = .{
            .url = "git+https://gitlab.com/devnw/zig/graph-storage.git#59a05ecb4cad8995026784483867be3eb65ec81f",
            .hash = "graph_storage-0.1.0-9UyJS32jCwDnhqICmGKc4JBVLapz8WpH3gsQrouoCvAr",
        },

        // Raft - Full Raft consensus with pre-vote, joint consensus, snapshotting
        .raft = .{
            .url = "git+https://gitlab.com/devnw/zig/raft.git#ea8fbbd4e48001a03af5eca49f8268c610e314ec",
            .hash = "raft-0.1.0-PqJyvkNCBACjoZFAj6zbFbS34oSK6-vWrefceScAmxxJ",
        },

        // =======================================================================
        // Phase 7: Extracted Domain Libraries
        // =======================================================================

        // Audit - Event modeling, filtering, CEF formatting, syslog/file sinks
        .audit = .{
            .url = "git+https://gitlab.com/devnw/zig/audit.git#6afedb73cb7f794d895abb3c3614d6a81988cc83",
            .hash = "audit-0.1.0-J9TtCCQhAwCed_BuOaShB2sYqYr5sjRA94KZVv7lmBRT",
        },

        // HNSW - Approximate nearest-neighbor index with configurable distance metrics
