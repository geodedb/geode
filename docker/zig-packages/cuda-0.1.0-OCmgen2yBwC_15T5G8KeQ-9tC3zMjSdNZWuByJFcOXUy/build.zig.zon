.{
    // Package name within the Zig package namespace
    .name = .cuda,

    // Semantic Version (https://semver.org/)
    .version = "0.1.0",

    // Globally unique package identifier
    // Generated by Zig toolchain, never changes after initial creation
    .fingerprint = 0x61c9d2277aa02938,

    // Minimum supported Zig version
    .minimum_zig_version = "0.15.1",

    // Package dependencies
    // Use `zig build --fetch` to fetch all dependencies
    .dependencies = .{
        // No external dependencies - pure Zig implementation
        // CUDA driver (libcuda.so) is loaded dynamically at runtime
    },

    // Files and directories included in this package
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "benchmarks",
        "examples",
        "docs",
        "LICENSE",
        "README.md",
    },
}
