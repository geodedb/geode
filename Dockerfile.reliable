# Reliable Dockerfile using community mirrors properly
FROM debian:bookworm-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

# ARG needs to be declared at the beginning of the stage
ARG TARGETARCH

# Install dependencies
RUN set -eux; \
        echo "Updating apt metadata..."; \
        for i in 1 2 3; do apt-get update && break || { echo "apt-get update failed (attempt $i), retrying"; sleep 3; }; done; \
        apt-get install -y --no-install-recommends \
            curl \
            xz-utils \
            ca-certificates \
            git \
            build-essential \
            file \
            minisign \
        ; \
        rm -rf /var/lib/apt/lists/*

# Install Zig 0.15.1 directly with correct filename format
ARG ZIG_VERSION=0.15.1
RUN set -ex && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        ARCH="aarch64"; \
    else \
        ARCH="x86_64"; \
    fi && \
    TARBALL="zig-${ARCH}-linux-${ZIG_VERSION}.tar.xz" && \
    echo "Downloading Zig ${ZIG_VERSION} for ${ARCH}..." && \
    curl -fsSL --connect-timeout 30 --max-time 300 \
         -o "/tmp/${TARBALL}" \
         "https://ziglang.org/download/${ZIG_VERSION}/${TARBALL}" && \
    echo "Extracting Zig..." && \
    tar -xJf "/tmp/${TARBALL}" -C /opt && \
    rm "/tmp/${TARBALL}" && \
    ln -s "/opt/zig-${ARCH}-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig && \
    zig version

# Set working directory
WORKDIR /build

# Copy build configuration files first (for better caching)
COPY build.zig ./

# Create empty src directory to satisfy build.zig
RUN mkdir -p src && touch src/main.zig

# Now copy the actual source code
COPY . .

# Build geode with multiple fallback options
RUN echo "Building with Zig $(zig version)..." && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        export ZIG_TARGET="aarch64-linux-gnu"; \
    else \
        export ZIG_TARGET="x86_64-linux-gnu"; \
    fi && \
    (zig build -Doptimize=ReleaseSafe -Dtarget=$ZIG_TARGET 2>/dev/null || \
     zig build -Dtarget=$ZIG_TARGET 2>/dev/null || \
     (echo "Build failed, trying without target..." && zig build)) && \
    echo "Main build complete" && \
    # Try to build tools (optional)
    (zig build tools -Doptimize=ReleaseSafe -Dtarget=$ZIG_TARGET 2>/dev/null || \
     zig build tools -Dtarget=$ZIG_TARGET 2>/dev/null || \
     echo "Note: Some tools may not have built")

# Runtime stage
FROM debian:bookworm-slim AS runtime
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN set -eux; \
        for i in 1 2 3; do apt-get update && break || { echo "apt-get update failed (attempt $i), retrying"; sleep 3; }; done; \
        apt-get install -y --no-install-recommends \
            ca-certificates \
            openssl \
        ; \
        rm -rf /var/lib/apt/lists/*; \
        useradd -m -u 1000 geode; \
        mkdir -p /data /certs /var/log/geode; \
        chown -R geode:geode /data /certs /var/log/geode

# Copy all built binaries
COPY --from=builder /build/zig-out/bin/ /usr/local/bin/

# Switch to non-root user
USER geode
WORKDIR /home/geode

# Set default log level (can be overridden with -e LOG_LEVEL=debug)
ENV LOG_LEVEL=error

# Expose ports (QUIC-only + metrics)
EXPOSE 7567/udp 9090/tcp

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["geode", "query", "RETURN 1 AS health", "--server", "127.0.0.1:7567"]

# Default entrypoint and command
ENTRYPOINT ["/usr/local/bin/geode", "serve"]
CMD ["--data-dir", "/data", "--listen", "0.0.0.0:7567"]