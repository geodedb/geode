# Production Dockerfile with optimizations and security hardening
FROM debian:bookworm-slim AS builder

# ARG needs to be declared at the beginning of the stage
ARG TARGETARCH

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    xz-utils \
    ca-certificates \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Zig 0.15.1
ARG ZIG_VERSION=0.15.1
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        ARCH="aarch64"; \
    else \
        ARCH="x86_64"; \
    fi && \
    curl -L https://ziglang.org/download/${ZIG_VERSION}/zig-${ARCH}-linux-${ZIG_VERSION}.tar.xz | tar -xJ -C /opt && \
    ln -s /opt/zig-${ARCH}-linux-${ZIG_VERSION}/zig /usr/local/bin/zig && \
    zig version

WORKDIR /build
COPY . .

# Build with maximum optimizations
# Use TARGETARCH to build for the correct architecture
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        export ZIG_TARGET="aarch64-linux-gnu"; \
    else \
        export ZIG_TARGET="x86_64-linux-gnu"; \
    fi && \
    zig build -Doptimize=ReleaseFast -Dtarget=$ZIG_TARGET && \
    zig build tools -Doptimize=ReleaseFast -Dtarget=$ZIG_TARGET && \
    # Only strip if we're building for the native architecture
    if [ "$TARGETARCH" = "amd64" ] || [ "$TARGETARCH" = "" ]; then \
        strip /build/zig-out/bin/geode || true; \
        strip /build/zig-out/bin/geoded || true; \
        strip /build/zig-out/bin/geodec || true; \
    fi

# Distroless runtime for minimal attack surface
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

# Copy binaries
COPY --from=builder --chown=nonroot:nonroot /build/zig-out/bin/geode /usr/local/bin/geode
COPY --from=builder --chown=nonroot:nonroot /build/zig-out/bin/geoded /usr/local/bin/geoded
COPY --from=builder --chown=nonroot:nonroot /build/zig-out/bin/geodec /usr/local/bin/geodec
COPY --from=builder --chown=nonroot:nonroot /build/zig-out/bin/cert_gen /usr/local/bin/cert_gen

# Create data directories
VOLUME ["/data", "/certs"]

# Non-root user by default
USER nonroot
WORKDIR /home/nonroot

# Expose ports (QUIC-only + metrics)
EXPOSE 7567/udp 9090/tcp

# Run geoded
ENTRYPOINT ["/usr/local/bin/geode", "serve"]
CMD ["--data-dir", "/data", "--listen", "0.0.0.0:7567", "--log-level", "info"]