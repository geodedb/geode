# syntax=docker/dockerfile:1.25
# Optimized production Dockerfile with GPU support and BuildKit cache mounts
FROM ubuntu:26.04 AS builder
# Issue #442: Use bash with pipefail to catch errors in piped commands
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Prevent apt from prompting for user input
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies with BuildKit cache mounts to prevent disk space issues
# The cache mount prevents "E: You don't have enough free space in /var/cache/apt/archives/"
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        xz-utils \
        ca-certificates \
        git \
        build-essential \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Zig with cache mount for downloads
ARG ZIG_VERSION=0.15.2
ARG TARGETARCH=amd64
RUN --mount=type=cache,target=/root/.cache \
    if [ "$TARGETARCH" = "arm64" ]; then \
        ARCH="aarch64"; \
    else \
        ARCH="x86_64"; \
    fi && \
    curl -L "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${ARCH}-${ZIG_VERSION}.tar.xz" -o zig.tar.xz && \
    tar -xf zig.tar.xz && \
    mv "zig-linux-${ARCH}-${ZIG_VERSION}" /usr/local/zig && \
    rm zig.tar.xz && \
    ln -s /usr/local/zig/zig /usr/local/bin/zig && \
    zig version

WORKDIR /build

# Copy only necessary files for dependency resolution (better layer caching)
COPY build.zig ./
COPY src/ src/
COPY vendor/ vendor/

# Build with Zig cache mount to speed up compilation
RUN --mount=type=cache,target=/root/.cache/zig \
    if [ "$TARGETARCH" = "arm64" ]; then \
        export ZIG_TARGET="aarch64-linux-gnu"; \
    else \
        export ZIG_TARGET="x86_64-linux-gnu"; \
    fi && \
    zig build -Doptimize=ReleaseFast -Denable-openssl=true

# Runtime stage - NVIDIA CUDA base for GPU support
FROM nvidia/cuda:13.3.0-base-ubuntu24.04 AS runtime

# Install only runtime dependencies (no build tools)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libvulkan1 \
        vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 geode

# Copy binaries from builder
COPY --from=builder --chown=geode:geode /build/zig-out/bin/geode /usr/local/bin/geode

# Copy shared health check script (issue #549: single source of truth)
COPY docker/health-check.sh /usr/local/bin/health-check.sh
RUN chmod +x /usr/local/bin/health-check.sh

# Create data directory
RUN mkdir -p /data && chown geode:geode /data
VOLUME ["/data"]

# Switch to non-root user
USER geode
WORKDIR /data

# Set default log level (can be overridden with -e LOG_LEVEL=debug)
ENV LOG_LEVEL=error

# Enable the out-of-band liveness endpoint the HEALTHCHECK probes:
# GET http://127.0.0.1:$GEODE_METRICS_PORT/health (bound to loopback unless
# GEODE_METRICS_BIND says otherwise). The server only starts that listener when
# GEODE_METRICS_PORT is set, and docker/health-check.sh needs it so the probe
# stays off the authenticated QUIC query path.
ENV GEODE_METRICS_PORT=9090

# Expose QUIC, gRPC and metrics/liveness ports
EXPOSE 3141/udp 50051/tcp 9090/tcp

# Health check using shared script (see docker/health-check.sh)
# SEC-22: --insecure is acceptable (localhost only, see docker/health-check.sh)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD /usr/local/bin/health-check.sh

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/geode"]
CMD ["serve", "--listen", "0.0.0.0:3141", "--enable-auth"]
