# Geode Development Environment
# Complete Docker-based development environment replicating Nix flake setup
# Avoids Nix/Docker compatibility issues while maintaining identical tooling

FROM ubuntu:26.04 AS base
# Issue #442: Use bash with pipefail to catch errors in piped commands
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# Install base system packages
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    git \
    curl \
    wget \
    xz-utils \
    ca-certificates \
    # Development tools
    vim \
    nano \
    tmux \
    htop \
    ripgrep \
    fd-find \
    bat \
    jq \
    yq \
    # Network tools
    tcpdump \
    netcat-openbsd \
    dnsutils \
    iputils-ping \
    traceroute \
    # System libraries
    liblttng-ust-dev \
    libnuma-dev \
    libvulkan-dev \
    vulkan-tools \
    glslang-tools \
    # Vulkan development
    libvulkan1 \
    vulkan-validationlayers \
    spirv-tools \
    # Python development
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    # PDF tools
    pdftk \
    # Node.js and npm (for any JS clients and CLI tools)
    nodejs \
    npm \
    # Rust dependencies
    libclang-dev \
    # GitHub CLI for Copilot CLI extension
    software-properties-common \
    # Utilities
    file \
    sudo \
    locales \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# Install gvm, Go, and Go tools
RUN curl -fsSL https://gitlab.com/devnw/gvm/-/raw/main/install.sh | bash && \
    . "$HOME/.gvm/env" && \
    gvm install latest && \
    gvm tools init
ENV PATH="/root/.gvm/go/bin:/root/.gvm/tools-bin:${PATH}"
ENV GOROOT="/root/.gvm/go"

# Setup locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Stage 2: Development environment
FROM base AS development

# Create developer user
ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=dev

# Create group and user, handling existing UIDs/GIDs
RUN set -ex && \
    # Create group if it doesn't exist
    if ! getent group $USER_GID >/dev/null 2>&1; then \
        groupadd --gid $USER_GID $USERNAME; \
    fi && \
    # Create user if it doesn't exist
    if ! getent passwd $USER_UID >/dev/null 2>&1; then \
        useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME; \
    elif ! id $USERNAME >/dev/null 2>&1; then \
        # User with that UID exists but different name, use different UID
        useradd --gid $USER_GID -m -s /bin/bash $USERNAME; \
    fi && \
    # Setup sudo access
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME

# Install Zig (build.zig.zon minimum_zig_version)
ARG ZIG_VERSION=0.16.0
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then \
        ZIG_ARCH="aarch64"; \
    else \
        ZIG_ARCH="x86_64"; \
    fi && \
    echo "Installing Zig ${ZIG_VERSION} for ${ZIG_ARCH}-linux..." && \
    curl -L https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz -o /tmp/zig.tar.xz && \
    tar -xf /tmp/zig.tar.xz -C /opt && \
    ln -s /opt/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}/zig /usr/local/bin/zig && \
    rm /tmp/zig.tar.xz && \
    zig version && \
    echo "Zig installed successfully!"

# Install Python packages for geodetestlab
RUN pip3 install --no-cache-dir --break-system-packages \
    typer \
    pydantic \
    rich \
    jmespath \
    psutil \
    keyring \
    pyyaml \
    pytest \
    mypy \
    black \
    isort \
    flake8 \
    aioquic \
    cryptography \
    pyopenssl \
    service-identity \
    python-lsp-server \
    setuptools \
    wheel

# Install AI Assistant CLIs (as root for system-wide availability)
# Install GitHub Copilot CLI (standalone npm package)
RUN npm install -g @github/copilot

# Install Claude Code CLI (official Anthropic CLI)
RUN npm install -g @anthropic-ai/claude-code || \
    echo "Claude Code CLI installation skipped, will retry on container start"

# Install Cursor agent CLI
RUN curl https://cursor.com/install -fsSL | bash || \
    echo "Cursor agent CLI installation skipped"

# Install Aider (AI pair programming tool that works with Claude/GPT)
# Use --ignore-installed to avoid conflicts with system-installed packages
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed aider-chat

# Install Rust for client development
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable && \
    . $HOME/.cargo/env && \
    rustup component add clippy rustfmt && \
    cargo install cargo-nextest cargo-audit && \
    # Make Rust accessible to all users
    chmod -R a+rX /root/.cargo /root/.rustup && \
    chmod a+x /root

# Add Rust to PATH for all users
ENV PATH="/root/.cargo/bin:$PATH" \
    RUSTUP_HOME="/root/.rustup" \
    CARGO_HOME="/root/.cargo"

# Install NVIDIA CUDA Toolkit (for GPU acceleration)
# NOTE: CUDA packages not yet available for Ubuntu 24.04
# Uncomment when NVIDIA publishes cuda-toolkit-12-4 for Ubuntu 24.04
# or use: apt-get install -y cuda (installs latest available version)
#
# RUN wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb && \
#     dpkg -i cuda-keyring_1.1-1_all.deb && \
#     apt-get update && \
#     apt-get install -y \
#         cuda-toolkit-12-4 \
#         libnccl2 \
#         libnccl-dev \
#         libcudnn8 \
#         libcudnn8-dev \
#     && rm -rf /var/lib/apt/lists/* cuda-keyring_1.1-1_all.deb

# Setup environment variables
ENV PATH="/root/.cargo/bin:/usr/local/cuda/bin:$PATH" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH" \
    CUDA_HOME=/usr/local/cuda \
    CUDA_PATH=/usr/local/cuda \
    VULKAN_SDK=/usr

# Switch to developer user
USER $USERNAME
WORKDIR /workspace

# Create workspace directories and Zig cache as developer user
RUN mkdir -p /workspace/zig-cache /workspace/.zig-cache $HOME/.cache/zig && \
    chmod 755 $HOME/.cache

# Note: Rust is already installed system-wide (as root) and available via PATH
# No need for per-user installation

# Setup shell environment with dynamic Zig cache path
RUN echo 'export PS1="\[\e[1;32m\]🐳 geode-dev\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] $ "' >> ~/.bashrc && \
    echo 'export ZIG_GLOBAL_CACHE_DIR=$HOME/.cache/zig' >> ~/.bashrc && \
    echo 'alias ll="ls -lah"' >> ~/.bashrc && \
    echo 'alias zb="zig build"' >> ~/.bashrc && \
    echo 'alias zbr="zig build -Doptimize=ReleaseSafe"' >> ~/.bashrc && \
    echo 'alias zbt="zig build test"' >> ~/.bashrc && \
    echo 'alias zbc="zig build check"' >> ~/.bashrc && \
    echo 'export HISTSIZE=10000' >> ~/.bashrc && \
    echo 'export HISTFILESIZE=20000' >> ~/.bashrc

# Display welcome message with proper version detection (#441: use printf, no heredoc)
RUN printf '%s\n' \
    '#!/bin/bash' \
    'echo "=================================================================="' \
    'echo "Geode Development Environment"' \
    'echo "=================================================================="' \
    'echo ""' \
    'echo "Development Tools:"' \
    'echo "  Zig $(zig version 2>/dev/null)"' \
    'echo "  Rust $(rustc --version 2>/dev/null | cut -d" " -f2)"' \
    'echo "  Go $(go version 2>/dev/null | cut -d" " -f3)"' \
    'echo "  Python $(python3 --version 2>&1 | cut -d" " -f2)"' \
    'echo "  Node.js $(node --version 2>/dev/null)"' \
    'echo ""' \
    'echo "Quick Commands: zb (zig build), zbr (release), zbt (test), make test"' \
    'echo "=================================================================="' \
    > ~/.welcome.sh && chmod +x ~/.welcome.sh && \
    echo 'bash ~/.welcome.sh' >> ~/.bashrc

# Default command
CMD ["/bin/bash"]
