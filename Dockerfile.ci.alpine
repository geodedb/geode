# Lightweight Alpine CI Dockerfile - uses pre-built musl binaries from pipeline
# Smaller image size, uses musl-based binaries
FROM alpine:3.19

# Install runtime dependencies only
RUN apk add --no-cache \
    ca-certificates \
    libgcc \
    && adduser -D -u 10000 geode \
    && mkdir -p /data /certs /var/log/geode \
    && chown -R geode:geode /data /certs /var/log/geode

# Copy pre-built musl binaries from build context
# These must be built with -Dtarget=x86_64-linux-musl or aarch64-linux-musl
COPY --chown=geode:geode zig-out/bin/* /usr/local/bin/

# Set execute permissions on binaries
RUN chmod +x /usr/local/bin/*

# Switch to non-root user
USER geode
WORKDIR /home/geode

# Expose ports (QUIC + metrics)
EXPOSE 3141/udp 9090/tcp

# Health check - uses GEODE_USERNAME/GEODE_PASSWORD env vars if auth is enabled
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD /usr/local/bin/geode query "RETURN 1 AS health" --server 127.0.0.1:3141 --insecure \
        ${GEODE_USERNAME:+-U "$GEODE_USERNAME"} ${GEODE_PASSWORD:+-P "$GEODE_PASSWORD"}

# Default entrypoint
# Production default: error-level logging only
# Override with --log-level debug|info|warn for development/troubleshooting
ENTRYPOINT ["/usr/local/bin/geode"]
CMD ["serve", "--data-dir", "/data", "--log-level", "error"]
