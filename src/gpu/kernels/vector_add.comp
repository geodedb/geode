#version 450

// Simple vector addition shader for testing Vulkan compute infrastructure
layout(local_size_x = 256) in;

layout(binding = 0) buffer InputA {
    float data_a[];
};

layout(binding = 1) buffer InputB {
    float data_b[];
};

layout(binding = 2) buffer Output {
    float data_out[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    data_out[idx] = data_a[idx] + data_b[idx];
}
