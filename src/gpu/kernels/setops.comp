#version 450

// Set operations kernel for Vulkan
// Supports UNION, INTERSECT, EXCEPT
// Optimized for large sets (10M+ elements)

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InputA {
    uint set_a[];
};

layout(std430, binding = 1) readonly buffer InputB {
    uint set_b[];
};

layout(std430, binding = 2) writeonly buffer Output {
    uint result[];
};

layout(std430, binding = 3) buffer OutputCount {
    uint count;
};

layout(push_constant) uniform PushConstants {
    uint size_a;
    uint size_b;
    uint operation;  // 0=UNION, 1=INTERSECT, 2=EXCEPT
} pc;

// Simple hash function for element lookup
uint hash(uint value, uint table_size) {
    return (value * 2654435761u) % table_size;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // UNION operation
    if (pc.operation == 0) {
        if (idx < pc.size_a) {
            // Add element from set A
            uint pos = atomicAdd(count, 1);
            result[pos] = set_a[idx];
        } else if (idx < pc.size_a + pc.size_b) {
            // Add element from set B
            uint pos = atomicAdd(count, 1);
            result[pos] = set_b[idx - pc.size_a];
        }
    }

    // INTERSECT operation
    else if (pc.operation == 1) {
        if (idx < pc.size_a) {
            uint elem = set_a[idx];
            // Linear search in set B (TODO: use hash table for large sets)
            for (uint i = 0; i < pc.size_b; i++) {
                if (set_b[i] == elem) {
                    uint pos = atomicAdd(count, 1);
                    result[pos] = elem;
                    break;
                }
            }
        }
    }

    // EXCEPT operation (A - B)
    else if (pc.operation == 2) {
        if (idx < pc.size_a) {
            uint elem = set_a[idx];
            bool found = false;
            // Linear search in set B
            for (uint i = 0; i < pc.size_b; i++) {
                if (set_b[i] == elem) {
                    found = true;
                    break;
                }
            }
            if (!found) {
                uint pos = atomicAdd(count, 1);
                result[pos] = elem;
            }
        }
    }
}
