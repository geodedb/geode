{
  "dashboard": {
    "title": "Geode Database Monitoring",
    "_comment": "Panel exprs updated 2026-04-28 (Task 23) to OTel metric names per otel-updates.md §5. Old→new: geode_queries_total→geode_query_count_total; geode_connections_active→geode_transport_connection_count; geode_memory_used_bytes→process_memory_usage_bytes; geode_transactions_total→geode_transaction_count_total; geode_query_duration_seconds→geode_query_execution_duration_seconds.",
    "panels": [
      {
        "title": "Query Rate",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "type": "graph",
        "targets": [
          {
            "expr": "rate(geode_query_count_total[5m])",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Active Connections",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "type": "graph",
        "targets": [
          {
            "expr": "geode_transport_connection_count",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Memory Usage",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "type": "graph",
        "targets": [
          {
            "expr": "process_memory_usage_bytes",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "WAL Size",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "type": "graph",
        "targets": [
          {
            "expr": "geode_wal_size_bytes",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Transaction Rate",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "type": "graph",
        "targets": [
          {
            "expr": "rate(geode_transaction_count_total[5m])",
            "legendFormat": "{{instance}} - {{status}}"
          }
        ]
      },
      {
        "title": "Query Latency (p95)",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(geode_query_execution_duration_seconds_bucket[5m]))",
            "legendFormat": "{{instance}}"
          }
        ]
      }
    ],
    "version": 2
  }
}
